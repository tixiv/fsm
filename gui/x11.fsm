
import * from "std";

fn take_from (_to: u8[], _from: u8[]&) {
    while (_to.len && _from.len) {
        _to.begin = _from.begin;
        _to++ _from++
    }
}

fn pad_size(size, pad) {
    return bitand(size + pad - 1, bitnot(pad - 1))
}
fn to_hex_digit (n) {
    if (n < 10) return n + '0';
    return n - 10 + 'A';
}

fn hexdump(d: u8[]) {
    for (let i = 0; d.len; { i++ d++ }) {
        if (i % 16 == 0) {
            if (i) putc('\n');
        }
        else {
            putc(' ');
        }
        putc(to_hex_digit(bitand(bitshift(d.begin, 4), 0x0f)));
        putc(to_hex_digit(bitand(d.begin, 0x0f)));
    }
    putc('\n')
}

record SockaddrUnix
{
    sun_family : u16;
    sun_path   : u8[108];
}

fn open_x11_socket() {
    let AF_UNIX = 1;
    let SOCK_STREAM = 1;
    let SOCK_CLOEXEC = 0x80000;
    let fd = socket(AF_UNIX, bitor(SOCK_STREAM, SOCK_CLOEXEC), 0);

    if (fd < 0) {
        $"open_x11_socket() Error creating socket: {strerror(fd)}\n";
        exit(1);
    }

    let addr: SockaddrUnix;
    addr.sun_family = AF_UNIX;

    let path = "/tmp/.X11-unix/X0";

    let sb_addr: StringBuilder;
    sb_init(sb_addr, addr.sun_path);
    sb_puts(sb_addr, $"{path}\0")

    let res = connect(fd, addr);

    if (res < 0) {
        $"open_x11_socket() Error connecting to '{path}': {strerror(res)}\n";
        exit(1);
    }

    return fd;
}

enum X11_EventMask {
    KeyPress             = 0x00000001;
    KeyRelease           = 0x00000002;
    OwnerGrabButton      = 0x00000004;
    ButtonPress          = 0x00000008;
    ButtonRelease        = 0x00000010;
    EnterWindow          = 0x00000020;
    LeaveWindow          = 0x00000040;
    PointerMotion        = 0x00000080;
    PointerMotionHint    = 0x00000100;
    Button1Motion        = 0x00000200;
    Button2Motion        = 0x00000400;
    Button3Motion        = 0x00000800;
    Button4Motion        = 0x00001000;
    Button5Motion        = 0x00002000;
    ButtonMotion         = 0x00004000;
    Exposure             = 0x00008000;
    VisibilityChange     = 0x00010000;
    StructureNotify      = 0x00020000;
    ResizeRedirect       = 0x00040000;
    SubstructureNotify   = 0x00080000;
    SubstructureRedirect = 0x00100000;
    FocusChange          = 0x00200000;
    PropertyChange       = 0x00400000;
    ColormapChange       = 0x00800000;
    KeymapState          = 0x01000000;
} 

record X11_SetupRequest {
    endian         : u8;
    _              : u8;
    version_major  : u16;
    version_minor  : u16;
    proto_len      : u16;
    proto_data_len : u16;
    _              : u16;
}

record X11_SetupReplyHeader_1 {
    status              : u8;
    _                   : u8;
    version_major       : u16;
    version_minor       : u16;
    additional_data_len : u16;
}

record X11_SetupReplyHeader_2 {
    release_number             : u32;
    resource_id_base           : u32;
    resource_id_mask           : u32;
    motion_buffer_size         : u32;
    length_of_vendor           : u16;
    maximum_request_length     : u16;
    number_of_SCREENs_in_roots : u8;
    number_of_pixmap_formats   : u8;
    image_byte_order           : u8; // 0: LSBFirst, 1: MSBFirst
    bitmap_format_bit_order    : u8; // 0: LeastSignificant, 1: MostSignificant
    bitmap_format_scanline_unit: u8;
    bitmap_format_scanline_pad : u8;
    min_keycode                : u8;
    max_keycode                : u8;
    _                          : u32;
    // length_of_vendor STRING8  vendor
    // p unused, p=pad(length_of_vendor)
    // 8n LISTofFORMAT pixmap-formats
    // m  LISTofSCREEN roots (m is always a multiple of 4)
}

record X11_PIXMAP_FORMAT {
    depth          : u8;
    bits_per_pixel : u8;
    scanline_pad   : u8;
    _              : u8[5];
}


record X11_SCREEN {
    root_window              :  u32; // WINDOW
    default_colormap         :  u32; // COLORMAP
    white_pixel              :  u32;
    black_pixel              :  u32;
    current_input_masks      :  u32; // SETofEVENT
    width_in_pixels          :  u16;
    height_in_pixels         :  u16;
    width_in_millimeters     :  u16;
    height_in_millimeters    :  u16;
    min_installed_maps       :  u16;
    max_installed_maps       :  u16;
    root_visual              :  u32; // VISUALID
    backing_stores           :   u8; // 0: Never 1: WhenMapped 2: Always
    save_unders              : bool;
    root_depth               :   u8;
    number_of_depths         :   u8;
    // n LISTofDEPTH allowed_depths (n is always a multiple of 4)
}

record X11_DEPTH {
    depth             : u8;
    _                 : u8;
    number_of_visuals : u16;
    _                 : u32;
    // 24n LISTofVISUALTYPE visuals
}

enum X11_VisualClass {
    StaticGray  = 0,
    GrayScale   = 1,
    StaticColor = 2,
    PseudoColor = 3,
    TrueColor   = 4,
    DirectColor = 5,
}

record X11_VISUAL_TYPE {
    visual_id           : u32;
    class               : u8; // enum X11_VisualClass
    bits_per_rgb_value  : u8;
    colormap_entries    : u16;
    red_mask            : u32;
    green_mask          : u32;
    blue_mask           : u32;
    _                   : u32;
}

struct FSM_X11_context {
    fd;
    root_window: u32;
    default_colormap: u32;
    gc: u32;
    current_id: u32;
}

struct Drawable {
    context:     FSM_X11_context&;
    drawable_id: i64;
}

fn x11_setup(context: FSM_X11_context&) {
    {
        let request: X11_SetupRequest;
        request.endian = 'l';
        request.version_major = 11;

        write(context.fd, request);
    }

    let header: X11_SetupReplyHeader_1;
    read (context.fd, header);

    let additional_len_bytes = header.additional_data_len * 4;
    let len_read = 0;

    let header2: X11_SetupReplyHeader_2;
    len_read = len_read + read(context.fd, header2);

    context.current_id = header2.resource_id_base;

    $"header2: {header2}"

    let vendor_buf: u8[256];
    let vendor: u8[] = vendor_buf;
    vendor.len = pad_size(header2.length_of_vendor, 4);
    len_read = len_read + read(context.fd, vendor);
    vendor.len = header2.length_of_vendor;

    $"vendor : '{vendor}'\n";

    for (let i = 0; i < header2.number_of_pixmap_formats; i++) {
        let format: X11_PIXMAP_FORMAT;
        len_read = len_read + read(context.fd, format);
        $"Format {i}: {format}";
    }

    for (let i = 0; i < header2.number_of_SCREENs_in_roots; i++) {
        let screen: X11_SCREEN;
        len_read = len_read + read(context.fd, screen);
        $"Screen {i}: {screen}";
        
        if (i == 0) {
            context.root_window = screen.root_window;
            context.default_colormap = screen.default_colormap;
        }

        for (let j = 0; j < screen.number_of_depths; j++) {
            let depth: X11_DEPTH;
            len_read = len_read + read(context.fd, depth);
            // $"Depth {j}: {depth}";
            for (let k = 0; k < depth.number_of_visuals; k++) {
                let visual: X11_VISUAL_TYPE;
                len_read = len_read + read(context.fd, visual);
                // $"Visual {k}: {visual}"
            }
        }
    }

    $"{additional_len_bytes}\n{len_read}\n";
}

record X11_QueryExtension {
    opcode         :  u8; // 98
    _              :  u8;
    request_length : u16; // 2+(n+p)/4
    length_of_name : u16; // n
    _              : u16;
    // n STRING8 name
    // unused, p=pad(n)
}

enum X11_ValueMask {
    function               =  0x00000001;
    plane_mask             =  0x00000002;
    foreground             =  0x00000004;
    background             =  0x00000008;
    line_width             =  0x00000010;
    line_style             =  0x00000020;
    cap_style              =  0x00000040;
    join_style             =  0x00000080;
    fill_style             =  0x00000100;
    fill_rule              =  0x00000200;
    tile                   =  0x00000400;
    stipple                =  0x00000800;
    tile_stipple_x_origin  =  0x00001000;
    tile_stipple_y_origin  =  0x00002000;
    font                   =  0x00004000;
    subwindow_mode         =  0x00008000;
    graphics_exposures     =  0x00010000;
    clip_x_origin          =  0x00020000;
    clip_y_origin          =  0x00040000;
    clip_mask              =  0x00080000;
    dash_offset            =  0x00100000;
    dashes                 =  0x00200000;
    arc_mode               =  0x00400000;
}

record X11_CreateGC {
    opcode          : u8; // 55
    _               : u8;
    request_length  : u16; // 4+n
    cid             : u32; // GCONTEXT (user chooses ID?)
    drawable        : u32; // DRAWABLE (root window)
    value_mask      : u32; // Which values we want to append
    // 4n LISTofVALUE value_list
}

record X11_CARD32 {
    value: u32;
}

fn x11_create_gc(context: FSM_X11_context&) {
    let create_gc: X11_CreateGC;
    create_gc.opcode = 55;
    create_gc.request_length = 4 + 2;
    create_gc.cid = context.current_id++;
    create_gc.drawable = context.root_window;
    create_gc.value_mask = X11_ValueMask::background
                         + X11_ValueMask::foreground;

    write(context.fd, create_gc);

    let background_color: X11_CARD32;
    background_color.value = 0xffffff;
    let foreground_color: X11_CARD32;
    foreground_color.value = 0xffffff;

    write(context.fd, background_color);
    write(context.fd, foreground_color);

    return create_gc.cid;
}

record X11_MapRequest {
    opcode          :  u8; // 20
    _               :  u8;
    sequence_number : u16;
    parent          : u32; // WINDOW
    window          : u32; // WINDOW
    _               : u8[20];
}

fn x11_map_request() {
    let map_request: X11_MapRequest;
    map_request.opcode = 20;
    map_request.sequence_number = 1;
}

enum X11_CreateWindow_value_mask {
    background_pixmap     = 0x00000001,
    background_pixel      = 0x00000002,
    border_pixmap         = 0x00000004,
    border_pixel          = 0x00000008,
    bit_gravity           = 0x00000010,
    win_gravity           = 0x00000020,
    backing_store         = 0x00000040,
    backing_planes        = 0x00000080,
    backing_pixel         = 0x00000100,
    override_redirect     = 0x00000200,
    save_under            = 0x00000400,
    event_mask            = 0x00000800,
    do_not_propagate_mask = 0x00001000,
    colormap              = 0x00002000,
    cursor                = 0x00004000,
}

fn x11_connect (context: FSM_X11_context&) {
    context.fd = open_x11_socket();
    x11_setup(context);
    context.gc = x11_create_gc(context);
}

record X11_CreateWindow {
    opcode         : u8; // 1
    depth          : u8;
    request_length : u16; // 8+n
    wid            : u32; // WINDOW
    parent         : u32; // WINDOW
    x              : u16;
    y              : u16;
    width          : u16;
    height         : u16;
    border_width   : u16;
    class          : u16; // 0: CopyFromParent, 1: InputOutput, 2: InputOnly
    visual         : u32; // VISUALID, 0: CopyFromParent
    value_mask     : u32; // (has n bits set to 1)
    //4n LISTofVALUE value_list
}

record X11_MapWindow {
    opcode         : u8; // 8
    _              : u8;
    request_length : u16; // 2
    window         : u32; // WINDOW
}

fn x11_open_window(context: FSM_X11_context&) : Drawable {
    let wid = context.current_id++;

    let create_window: X11_CreateWindow;
    create_window.opcode = 1;
    create_window.depth = 0;
    create_window.request_length = 8 + 3;
    create_window.wid = wid;
    create_window.parent = context.root_window;
    create_window.x = 0;
    create_window.y = 0;
    create_window.width = 800;
    create_window.height = 600;
    create_window.value_mask
            = X11_CreateWindow_value_mask::background_pixel
            + X11_CreateWindow_value_mask::border_pixel
            + X11_CreateWindow_value_mask::event_mask;
    
    write (context.fd, create_window);

    let bg:     X11_CARD32;
    let border: X11_CARD32;
    let events: X11_CARD32;
    bg.value       = 0x80;
    border.value   = 0x404080;
    events.value = X11_EventMask::Exposure
                 + X11_EventMask::KeyPress
                 + X11_EventMask::KeyRelease;
                 
    write (context.fd, bg);
    write (context.fd, border);
    write (context.fd, events);

    let map_window: X11_MapWindow;
    map_window.opcode = 8;
    map_window.request_length = 2;
    map_window.window = wid;

    write (context.fd, map_window);

    let drawable: Drawable;
    drawable.context => context;
    drawable.drawable_id = wid;

    return drawable;
}

record X11_CreatePixmap {
    opcode         : u8;  // 53
    depth          : u8;
    request_length : u16; // 4
    pid            : u32; // PIXMAP
    drawable       : u32;
    width          : u16;
    height         : u16;
}

fn x11_create_pixmap (context: FSM_X11_context&, drawable: u32) {
    let cp: X11_CreatePixmap;
    cp.opcode = 53;
    cp.depth  = 32;
    cp.request_length = 4;
    cp.pid = context.current_id++;
    cp.drawable = drawable;
    cp.width = 800;
    cp.height = 600;

    write (context.fd, cp);

    return cp.pid;
}

record X11_PolyLine {
    opcode          :  u8; // 65
    coordinate_mode :  u8; // 0: Origin 1: Previous
    request_length  : u16; // 3+n
    drawable        : u32;
    gc              : u32;
    // 4n LISTofPOINT points
}

record Point {
    x : u16;
    y : u16;
}


fn x11_poly_line(drawable: Drawable, points: Point[]) {
    let pl: X11_PolyLine;
    pl.opcode = 65;
    pl.coordinate_mode = 0;
    pl.request_length = 3 + points.len;
    pl.drawable = drawable.drawable_id;
    pl.gc = drawable.context.gc;

    write (drawable.context.fd, pl);
    for (; points.len; points++) {
        write (drawable.context.fd, points.begin)
    }
}

fn main () {
    let context: FSM_X11_context;
    x11_connect(context);

    let window = x11_open_window(context);

    let points: Point[3];
    points[0].x = 15;
    points[0].y = 15;
    points[1].x = 400;
    points[1].y = 400;
    points[2].x = 0;
    points[2].y = 400;

    while(1)
    {
        let buf: u8[0x10000];
        let len = read(context.fd, buf);
        if (len == 0) exit(0);
        print(len);
        let s: u8[] = buf;
        s.len = len;
        hexdump(s);
        x11_poly_line(window, points);
    }
}
