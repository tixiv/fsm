
import * from "std";
import * from "math";
import * from "x11";

fn draw_it (window: Drawable&) {
    let points: Point[2000];

    for (let i = 0; i < points.len; i++) {
        let p => points[i];
        p.x = i;
        p.y = <i64> (sin(<f64>(i - 400) / 50.0) * 100.0 + 400.0);
    }

    x11_poly_point(window, points);

    for (let i = 0; i < points.len; i++) {
        let p => points[i];
        p.x = i;
        p.y = <i64> (cos(<f64>(i - 400) / 50.0) * 100.0 + 400.0);
    }

    x11_poly_point(window, points);

    for (let i = 0; i < points.len; i++) {
        let p => points[i];
        p.x = i;
        p.y = <i64> (-sin(<f64>(i - 400) / 50.0) * 100.0 + 400.0);
    }

    x11_poly_point(window, points);

    for (let i = 0; i < points.len; i++) {
        let p => points[i];
        p.x = i;
        p.y = <i64> (-cos(<f64>(i - 400) / 50.0) * 100.0 + 400.0);
    }

    x11_poly_point(window, points);
}

fn main () {
    let context: FSM_X11_context;
    x11_connect(context);

    let window = x11_open_window(context);

    while(1)
    {
        let buf: u8[0x10000];
        let len = read(context.fd, buf);
        if (len == 0) exit(0);
        print(len);
        let s: u8[] = buf;
        s.len = len;
        hexdump(s);
        draw_it(window);
    }
}
