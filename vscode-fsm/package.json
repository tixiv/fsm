{
    "name": "fsm-language",
    "displayName": "FSM Language",
    "description": "Syntax highlighting and language server support for the FSM programming language",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onLanguage:fsm"
    ],
    "contributes": {
        "commands": [
            {
                "command": "fsm.startLanguageServer",
                "title": "FSM: Start Language Server"
            },
            {
                "command": "fsm.stopLanguageServer",
                "title": "FSM: Stop Language Server"
            },
            {
                "command": "fsm.restartLanguageServer",
                "title": "FSM: Restart Language Server"
            }
        ],
        "languages": [
            {
                "id": "fsm",
                "aliases": [
                    "FSM"
                ],
                "extensions": [
                    ".fsm"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "fsm",
                "scopeName": "source.fsm",
                "path": "./syntaxes/fsm.tmLanguage.json"
            }
        ]
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "vscode:prepublish": "npm run compile"
    },
    "dependencies": {
        "vscode-languageclient": "^10.1.0"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@types/vscode": "^1.80.0",
        "typescript": "^5.0.0"
    }
}
