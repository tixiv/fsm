
import * from "std";
import * from "endlos";

fn blurg(allocator: EndlosAllocator&) {
    let my_roll = endlos_begin~u8(allocator);

    for (let i = 0; i < 10; i++) {
        my_roll++ = i + '0';
    }

    return endlos_ripp_off~u8(allocator, my_roll);
}

fn blarg (allocator: EndlosAllocator&, level) : void {

    let my_roll = endlos_begin~u8(allocator);

    let blurg_result: u8[];

    for (let i = 0; i < 26; i++) {
        my_roll++ = i + 'A';

        if (i == 13) {
            blurg_result = blurg(allocator);
            if (level > 1) blarg(allocator, level-1);
        }
    }

    let finalized = endlos_ripp_off~u8(allocator, my_roll);

    $"{finalized}   {blurg_result}\n"
}

fn main () {
    let allocator: EndlosAllocator;
    endlos_root_init(allocator, 256, 4096);

    blarg(allocator, 255);

    blarg(allocator, 255);
}
