
import * from "std";

enum OperatorKind {
    Add,
}

union TreeNode enum kind {
    struct {
        value: i64;
    }

    struct Number {
        num_value: i64;
    }

    struct BinaryOperator {
        left: TreeNode&;
        right: TreeNode&;
    }
}

fn init_number (n: TreeNode&, v) {
    n.kind = TreeNode::Number;
    n.Number.num_value = v;
}

fn init_operator (n: TreeNode&, op: OperatorKind, left: TreeNode&, right: TreeNode&) {
    n.kind = TreeNode::BinaryOperator;
    n.BinaryOperator.left => left;
    n.BinaryOperator.right => right;
}

fn visit_children (n: TreeNode&, visit: fn (TreeNode&, any&) : void, arg: any&) {
    if (n.kind == TreeNode::BinaryOperator) {
        visit(n.BinaryOperator.left, arg)
        visit(n.BinaryOperator.right, arg)
    }
    else if (n.kind == TreeNode::Number)
    {
    }
    else $"Visiting {n.kind.name} is not implemented yet.\n"
}

fn tree_visitor(n: TreeNode&, foo: i64&) : void {
    // $"level: {foo}\n"
    if (n.kind == TreeNode::BinaryOperator) {
        // $"Binary\n"
        let f = foo + 1;
        visit_children(n, tree_visitor, f)
        let a = n.BinaryOperator.left.value
        let b = n.BinaryOperator.right.value
        n.value = a + b
        $"+\n={n.value}\n"
    } else {
        // $"Number\n"
        n.value = n.Number.num_value;
        print (n.value)
    }
}

fn main () {
    let a: TreeNode;
    init_number(&a, 42);    
    let b: TreeNode;
    init_number(&b, 2300);
    let c: TreeNode;
    init_number(&c, 13370000);
    let add_1: TreeNode;
    init_operator(&add_1, OperatorKind::Add, &a, &b);
    let add_2: TreeNode;
    init_operator(&add_2, OperatorKind::Add, &add_1, &c);

    let f = 0;
    tree_visitor(&add_2, f)
}
