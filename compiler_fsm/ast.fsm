
import * from "compiler_fsm/tokenizer";

fn NOT_IMPLEMENTED(s: u8[]) {
    puts(s); exit(1);
}

struct Type {
}

enum SymbolKind {
    SYM_global,
    SYM_local,
    SYM_arg,
    SYM_type,
}

struct Symbol {
    name: u8[];
    kind: SymbolKind;
    type: Type&;

    size; // stack frame size for functions
    offset; // stack offset for args and local vars
}


enum AstKind {
    AST_program,
    AST_function,
    AST_arg_list,
    AST_scope,
    AST_var_decl,
    AST_arg_decl,
    AST_number,
    AST_bool,
    AST_null,
    AST_string,
    AST_char_constant,
    AST_symbol,
    AST_binary,
    AST_variadic_operator,
    AST_unary,
    AST_call,
    AST_return,
    AST_if,
    AST_while,
    AST_for,
    AST_cast,
    AST_array_access,
    AST_array_len,
    AST_dereference,
    AST_reference,
    AST_struct,
    AST_member_def,
    AST_enum,
    AST_enum_member,
    AST_typename,
    AST_type_ref,
    AST_type_array,
    AST_type_slice,
    AST_function_type,
    AST_member_access,
    AST_namespace_access,
    AST_array_to_slice,
    AST_plus_plus,
    AST_minus_minus,
    AST_builder_string,
}

struct VariadicOperatorMember {
    token_kind: TokenKind;
    right: AST_node&;
}

union AST_node enum kind {
    struct {
        next : AST_node&;
        location: Location;
        type: Type&;
        addressable: bool;
        result_used: bool;
    }

    struct AST_binary {
        left: AST_node&;
        right: AST_node&;
        token_kind: TokenKind;
    }

    struct AST_variadic_operator {
        left: AST_node&;
        num_members;
        members: VariadicOperatorMember[];
    }

    struct AST_function {
        args: AST_node&;
        body: AST_node&;
        ret_typedecl: AST_node&;
        symbol: Symbol&;
        name: u8[];
    }

    struct AST_arg_list       { body: AST_node&; }
    struct AST_scope          { body: AST_node&; }
    struct AST_program        { body: AST_node&; }
    struct AST_array_to_slice { body: AST_node&; }
    struct AST_dereference    { body: AST_node&; }
    struct AST_reference      { body: AST_node&; }
    struct AST_type_ref       { body: AST_node&; }

    struct AST_call {
        target: AST_node&;
        args: AST_node&;
    }

    struct AST_return {
        body: AST_node&;
        implicit: bool;
    }

    struct AST_var_decl {
        initializer: AST_node&;
        _typedecl: AST_node&;
        symbol: Symbol&;
        name: u8[];
        initializer_operator: TokenKind;
    }

    struct AST_arg_decl {
        _typedecl: AST_node&;
        symbol: Symbol&;
        name: u8[];
    }

    struct AST_symbol {
        name: u8[];
        symbol: Symbol&;
    }

    struct AST_number {
        value: u8[];
    }

    struct AST_bool {
        value: bool;
    }

    struct AST_string {
        value: u8[];
    }

    struct AST_if {
        condition: AST_node&;
        if_clause: AST_node&;
        else_clause: AST_node&;
    }

    struct AST_while {
        condition: AST_node&;
        body: AST_node&;
    }

    struct AST_for {
        initializer:AST_node&;
        condition: AST_node&;
        post_action: AST_node&;
        body: AST_node&;
        result: AST_node&;
    }

    struct AST_cast {
        body: AST_node&;
        right_type: Type&; // the left type is the type of the AST node
    }

    struct AST_array_access {
        array: AST_node&;
        index: AST_node&;
    }

    struct AST_unary {
        body: AST_node&;
        token_kind: TokenKind;
    }

    struct AST_plus_plus {
        body: AST_node&;
        postfix: bool;
    }

    struct AST_minus_minus {
        body: AST_node&;
        postfix: bool;
    }

    struct AST_struct {
        body: AST_node&;
        name: u8[];
    }

    struct AST_member_def {
        _typedef: AST_node&;
        name: u8[];
    }

    struct AST_member_access {
        body: AST_node&;
        name: u8[];
        offset;                
    }

    struct AST_namespace_access {
        body: AST_node&;
        name: u8[];
        enum_value;
    }

    struct AST_enum {
        body: AST_node&;
        name: u8[];
    }

    struct AST_enum_member {
        name: u8[];
        value;
    }

    struct AST_array_len {
        len;
    }

    struct AST_typename {
        name: u8[];
    }

    struct AST_function_type {
        function_args: AST_node&;
        function_ret: AST_node&;
    }

    struct AST_type_array {
        body: AST_node&;
        n_elements;
    }

    struct AST_type_slice {
        body: AST_node&;
    }

    struct AST_builder_string {
        var_decl_sb: AST_node&;
        var_decl_arr: AST_node&;
        body: AST_node&;
    }
}

struct AST_Node_Allocator {
    buf: AST_node[1000];
    alloc: AST_node[];
}

fn ast_alloc(allocator: AST_Node_Allocator&, kind, location: Location) : AST_node& {
    if (!allocator.alloc.len) {
        $"Error: out of AST nodes.\n"
        exit(1);
    }
    let node => allocator.alloc.begin;
    allocator.alloc++;

    node.kind = kind;
    node.location = location;

    return node;
}

fn get_last_in_chain(n: AST_node&) : AST_node& {
    while (n.next) n => n.next;
    return n;
}

fn ast_count_chain(n: AST_node&) : i64 {
    let num = 0;
    while (n) {
        num++;
        n => n.next;
    }
    return num;
}

