
import * from "std";
import * from "tokenizer";
import * from "type";
import * from "symbol";

struct VariadicOperatorMember {
    token_kind: TokenKind;
    right: AST_node&;
}

union AST_node enum kind {
    struct {
        next : AST_node&;
        location: Location;
        type: Type&;
        addressable: bool;
        result_used: bool;
    }

    struct AST_binary {
        left: AST_node&;
        right: AST_node&;
        token_kind: TokenKind;
    }

    struct AST_variadic_operator {
        left: AST_node&;
        num_members;
        members: VariadicOperatorMember[];
    }

    struct AST_function {
        args: AST_node&;
        body: AST_node&;
        ret_typedecl: AST_node&;
        symbol: Symbol&;
        name: u8[];
    }

    struct AST_arg_list       { body: AST_node&; }
    struct AST_scope          { body: AST_node&; }
    struct AST_program        { body: AST_node&; }
    struct AST_array_to_slice { body: AST_node&; }
    struct AST_dereference    { body: AST_node&; }
    struct AST_reference      { body: AST_node&; }
    struct AST_type_ref       { body: AST_node&; }

    struct AST_call {
        target: AST_node&;
        args: AST_node&;
    }

    struct AST_return {
        body: AST_node&;
        implicit: bool;
    }

    struct AST_var_decl {
        initializer: AST_node&;
        _typedecl: AST_node&;
        symbol: Symbol&;
        name: u8[];
        initializer_operator: TokenKind;
    }

    struct AST_arg_decl {
        _typedecl: AST_node&;
        symbol: Symbol&;
        name: u8[];
    }

    struct AST_symbol {
        name: u8[];
        symbol: Symbol&;
    }

    struct AST_number {
        value: u8[];
    }

    struct AST_bool {
        value: bool;
    }

    struct AST_string {
        value: u8[];
    }

    struct AST_char_constant {
        value: u8[];
    }

    struct AST_if {
        condition: AST_node&;
        if_clause: AST_node&;
        else_clause: AST_node&;
    }

    struct AST_while {
        condition: AST_node&;
        body: AST_node&;
    }

    struct AST_for {
        initializer:AST_node&;
        condition: AST_node&;
        post_action: AST_node&;
        body: AST_node&;
        result: AST_node&;
    }

    struct AST_cast {
        body: AST_node&;
        right_type: Type&; // the left type is the type of the AST node
    }

    struct AST_user_cast {
        body: AST_node&;
        typedecl: AST_node&; // target type decl
    }

    struct AST_array_access {
        array: AST_node&;
        index: AST_node&;
    }

    struct AST_unary {
        body: AST_node&;
        token_kind: TokenKind;
    }

    struct AST_plus_plus {
        body: AST_node&;
        postfix: bool;
    }

    struct AST_minus_minus {
        body: AST_node&;
        postfix: bool;
    }

    struct AST_struct {
        body: AST_node&;
        name: u8[];
    }

    struct AST_member_def {
        _typedef: AST_node&;
        name: u8[];
    }

    struct AST_union {
        body: AST_node&;
        name: u8[];
        enumerator_name: u8[];
    }

    struct AST_union_member_def {
        _typedef: AST_node&;
        name: u8[];
        enum_value;
    }

    struct AST_member_access {
        body: AST_node&;
        name: u8[];
        offset;                
    }

    struct AST_namespace_access {
        body: AST_node&;
        name: u8[];
        enum_value;
    }

    struct AST_enum {
        body: AST_node&;
        name: u8[];
    }

    struct AST_enum_member {
        name: u8[];
        value;
    }

    struct AST_array_len {
        len;
    }

    struct AST_typename {
        name: u8[];
    }

    struct AST_function_type {
        function_args: AST_node&;
        function_ret: AST_node&;
    }

    struct AST_type_array {
        body: AST_node&;
        n_elements;
    }

    struct AST_type_slice {
        body: AST_node&;
    }

    struct AST_builder_string {
        var_decl_sb: AST_node&;
        var_decl_arr: AST_node&;
        body: AST_node&;
    }

    struct AST_null {
    }

    struct AST_generic {
        body: AST_node&;
        parameter_name: u8[];
    }

    struct AST_generic_speciation {
        typedecl: AST_node&;
        body: AST_node&;
    }

    struct AST_type_generic_speciation {
        typedecl: AST_node&;
        body: AST_node&;
    }

    struct AST_generic_implementation {
        body: AST_node&;
    }
}

struct AST_Node_Allocator {
    buf: AST_node[];
    alloc: AST_node[];
}

fn AST_Node_Allocator_init (allocator: AST_Node_Allocator&) {
    let num_nodes = 1024*1024;
    allocator.buf.begin => mmap_anonymous(num_nodes * AST_node.sizeof);
    allocator.buf.len = num_nodes;
    allocator.alloc = allocator.buf;
}

fn ast_alloc(allocator: AST_Node_Allocator&, kind, location: Location) : AST_node& {
    if (!allocator.alloc.len) {
        $"Error: out of AST nodes.\n"
        exit(1);
    }
    let node => allocator.alloc.begin;
    allocator.alloc++;

    node.kind = kind;
    node.location = location;

    return node;
}

fn get_last_in_chain(n: AST_node&) : AST_node& {
    while (n.next) n => n.next;
    return n;
}

fn ast_count_chain(n: AST_node&) : i64 {
    let num = 0;
    while (n) {
        num++;
        n => n.next;
    }
    return num;
}

fn ast_link_to_chain(chain_p: AST_node& &, n: AST_node&) : void {
    if (!*chain_p) {
        *chain_p => n;
    }
    else {
        get_last_in_chain(*chain_p).next => n;
    }
}

fn ast_insert_node(allocator: AST_Node_Allocator&, at: AST_node&, new_node: AST_node&) : void {
    // We overwrite the old node with the new one.
    // make a copy first.
    let at_copy => ast_alloc(allocator, at.kind, at.location);
    objcopy~AST_node(at_copy, at);

    at_copy.next => null; // zero chain pointer in case it was used

    new_node.location = at.location;
    new_node.next => at.next;
    new_node.result_used = at.result_used;

         if (new_node.kind == AST_node::AST_cast) {          new_node.AST_cast.body => at_copy; }
    else if (new_node.kind == AST_node::AST_dereference) {   new_node.AST_dereference.body => at_copy; }
    else if (new_node.kind == AST_node::AST_reference) {     new_node.AST_reference.body => at_copy; }
    else if (new_node.kind == AST_node::AST_array_to_slice) {new_node.AST_array_to_slice.body => at_copy; }
    else if (new_node.kind == AST_node::AST_call) {          new_node.AST_call.args => at_copy; }
    else NOT_IMPLEMENTED(__LOCATION__, $"Inserting AST node of kind {new_node.kind.name}");

    // overwrite the old node with the new one that has the old
    // ones copy linked
    objcopy~AST_node(at, new_node);
}

