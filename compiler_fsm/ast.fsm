fn ast_visit_chain(n: AST_node&, visit: fn(AST_node&, any&):void, arg: any&) {
    while (n) {
        visit(n, arg);
        n => n.next;
    }
}

fn visit_non_null(n: AST_node&, visit: fn(AST_node&, any&):void, arg: any&) {
    if (n) visit(n, arg);
}

fn ast_visit_children(n: AST_node&, visit: fn(AST_node&, any&):void, arg: any&)
{
    if (n.kind == AST_node::AST_program) {
        ast_visit_chain(n.AST_program.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_scope) {
        ast_visit_chain(n.AST_scope.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_arg_list) {
        ast_visit_chain(n.AST_arg_list.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_function) {
        visit_non_null(n.AST_function.args, visit, arg);
        visit_non_null(n.AST_function.ret_typedecl, visit, arg);
        ast_visit_chain(n.AST_function.body, visit, arg);            
    }
    else if (n.kind == AST_node::AST_return) {
        visit_non_null(n.AST_return.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_var_decl) {
        visit_non_null(n.AST_var_decl._typedecl, visit, arg);
        visit_non_null(n.AST_var_decl.initializer, visit, arg);
    }
    else if (n.kind == AST_node::AST_arg_decl) {
        visit_non_null(n.AST_arg_decl._typedecl, visit, arg);
    }
    else if (n.kind == AST_node::AST_if) {
        visit_non_null(n.AST_if.condition, visit, arg);
        visit_non_null(n.AST_if.if_clause, visit, arg);
        visit_non_null(n.AST_if.else_clause, visit, arg);
    }
    else if (n.kind == AST_node::AST_while) {
        visit_non_null(n.AST_while.condition, visit, arg);
        visit_non_null(n.AST_while.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_for) {
        visit_non_null(n.AST_for.initializer, visit, arg);
        visit_non_null(n.AST_for.condition, visit, arg);
        visit_non_null(n.AST_for.post_action, visit, arg);
        visit_non_null(n.AST_for.body, visit, arg);
        visit_non_null(n.AST_for.result, visit, arg);
    }
    else if (n.kind == AST_node::AST_binary) {
        visit_non_null(n.AST_binary.left, visit, arg);
        visit_non_null(n.AST_binary.right, visit, arg);
    }
    else if (n.kind == AST_node::AST_unary) {
        visit_non_null(n.AST_unary.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_call) {
        visit_non_null(n.AST_call.target, visit, arg);
        ast_visit_chain(n.AST_call.args, visit, arg);
    }
    else if (n.kind == AST_node::AST_cast) {
        visit_non_null(n.AST_cast.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_array_access) {
        visit_non_null(n.AST_array_access.array, visit, arg);
        visit_non_null(n.AST_array_access.index, visit, arg);
    }
    else if (n.kind == AST_node::AST_dereference) {
        visit_non_null(n.AST_dereference.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_reference) {
        visit_non_null(n.AST_reference.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_plus_plus) {
        visit_non_null(n.AST_plus_plus.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_minus_minus) {
        visit_non_null(n.AST_minus_minus.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_struct) {
        ast_visit_chain(n.AST_struct.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_enum) {
        ast_visit_chain(n.AST_enum.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_union) {
        ast_visit_chain(n.AST_union.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_member_def) {
        visit_non_null(n.AST_member_def._typedef, visit, arg);
    }
    else if (n.kind == AST_node::AST_union_member_def) {
        visit_non_null(n.AST_union_member_def._typedef, visit, arg);
    }
    else if (n.kind == AST_node::AST_member_access) {
        visit_non_null(n.AST_member_access.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_namespace_access) {
        visit_non_null(n.AST_namespace_access.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_type_ref) {
        visit_non_null(n.AST_type_ref.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_type_array) {
        visit_non_null(n.AST_type_array.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_type_slice) {
        visit_non_null(n.AST_type_slice.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_variadic_operator) {
        visit_non_null(n.AST_variadic_operator.left, visit, arg);
        for (let i = 0; i < n.AST_variadic_operator.num_members; i++) {
            visit_non_null(n.AST_variadic_operator.members[i].right, visit, arg);
        }
    }
    else if (n.kind == AST_node::AST_builder_string) {
        visit_non_null(n.AST_builder_string.var_decl_sb, visit, arg);
        visit_non_null(n.AST_builder_string.var_decl_arr, visit, arg);
        ast_visit_chain(n.AST_builder_string.body, visit, arg);
    }
    else if (n.kind == AST_node::AST_function_type) {
        ast_visit_chain(n.AST_function_type.function_args, visit, arg);
        visit_non_null(n.AST_function_type.function_ret, visit, arg);
    }
    else if (n.kind  == AST_node::AST_enum_member
                    |== AST_node::AST_symbol
                    |== AST_node::AST_number
                    |== AST_node::AST_bool
                    |== AST_node::AST_null
                    |== AST_node::AST_string
                    |== AST_node::AST_char_constant
                    |== AST_node::AST_array_len
                    |== AST_node::AST_typename
    ) {
        // no child nodes to visit
    }
    else {
        NOT_IMPLEMENTED(__LOCATION__, $"Visiting {n.kind.name}");
    }
}

fn print_symbol(s: Symbol&) : void {
    if(!s)
        $"(null symbol)"
    else
        $"({s.kind.name} '{s.name}')"
}

fn ast_dump_visitor (n: AST_node&, spaces: i64&) : void {
    let buf: u8[1024];
     // Yeah, these are my spaces
    let spc = "                                                                                                        ";
    spc.len = spaces;
    let child_spaces = spaces + 4;

    if (n.kind == AST_node::AST_program
              |== AST_node::AST_scope
              |== AST_node::AST_arg_list
              |== AST_node::AST_return
              |== AST_node::AST_while
              |== AST_node::AST_for)
    {
        $"{spc}{n.kind.name} \n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_builder_string
                   |== AST_node::AST_type_ref
                   |== AST_node::AST_type_array
                   |== AST_node::AST_type_slice
                   |== AST_node::AST_dereference
                   |== AST_node::AST_reference
                   |== AST_node::AST_plus_plus
                   |== AST_node::AST_minus_minus
                   |== AST_node::AST_array_access
                   |== AST_node::AST_array_len
                   |== AST_node::AST_array_to_slice
                   |== AST_node::AST_function_type
                   |== AST_node::AST_null)
    {
        $"{spc}{n.kind.name} ({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_struct) {
        $"{spc}{n.kind.name} '{n.AST_struct.name}' ({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_member_def) {
        $"{spc}{n.kind.name} '{n.AST_member_def.name}' ({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_member_access) {
        $"{spc}{n.kind.name} '{n.AST_member_access.name}' ({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_enum) {
        $"{spc}{n.kind.name} '{n.AST_enum.name}' ({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_enum_member) {
        $"{spc}{n.kind.name} '{n.AST_enum_member.name}' {n.AST_enum_member.value} ({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_union) {
        $"{spc}{n.kind.name} '{n.AST_union.name}' ({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_union_member_def) {
        $"{spc}{n.kind.name} '{n.AST_union_member_def.name}' ({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_namespace_access) {
        $"{spc}{n.kind.name} '{n.AST_namespace_access.name}' ({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_typename) {
        $"{spc}{n.kind.name} '{n.AST_typename.name}' ({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_function) {
        $"{spc}{n.kind.name} '{n.AST_function.name}', ({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_var_decl) {
        $"{spc}{n.kind.name} '{n.AST_var_decl.name}' ";
        print_symbol(n.AST_var_decl.symbol);
        $"\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_arg_decl) {
        $"{spc}{n.kind.name} '{n.AST_arg_decl.name}' ";
        print_symbol(n.AST_arg_decl.symbol);
        $"\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_number) {
        $"{spc}{n.kind.name} '{n.AST_number.value}' ({get_type_name_r(buf, n.type)})\n";
    }
    else if (n.kind == AST_node::AST_bool) {
        $"{spc}{n.kind.name} '{n.AST_bool.value}' ({get_type_name_r(buf, n.type)})\n";
    }
    else if (n.kind == AST_node::AST_string) {
        $"{spc}{n.kind.name} \"{n.AST_string.value}\" ({get_type_name_r(buf, n.type)})\n";
    }
    else if (n.kind == AST_node::AST_char_constant) {
        $"{spc}{n.kind.name} \"{n.AST_char_constant.value}\" ({get_type_name_r(buf, n.type)})\n";
    }
    else if (n.kind == AST_node::AST_if) {
        $"{spc}{n.kind.name} ({get_type_name_r(buf, n.type)})\n";
        if (n.AST_if.condition) {
            $"{spc}  Condition:\n";
            ast_dump_visitor(n.AST_if.condition, child_spaces);
        }
        if (n.AST_if.if_clause) {
            $"{spc}  If clause:\n";
            ast_dump_visitor(n.AST_if.if_clause, child_spaces);
        }
        if (n.AST_if.else_clause) {
            $"{spc}  Else clause:\n";
            ast_dump_visitor(n.AST_if.else_clause, child_spaces);
        }
    }
    else if (n.kind == AST_node::AST_binary) {
        $"{spc}{n.kind.name} {n.AST_binary.token_kind.name} ({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_unary) {
        $"{spc}{n.kind.name} {n.AST_unary.token_kind.name} ({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_variadic_operator) {
        $"{spc}{n.kind.name} {n.AST_variadic_operator.members[0].token_kind.name} ({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_symbol) {
        $"{spc}{n.kind.name} '{n.AST_symbol.name}' ";
        print_symbol(n.AST_symbol.symbol);
        $" ({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_call) {
        $"{spc}{n.kind.name} ";
        $"({get_type_name_r(buf, n.type)})\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else if (n.kind == AST_node::AST_cast) {
        $"{spc}{n.kind.name} '{get_type_name_r(buf, n.type)}' <- '{get_type_name_r(buf, n.AST_cast.right_type)}'\n";
        ast_visit_children(n, ast_dump_visitor, child_spaces);
    }
    else {
        NOT_IMPLEMENTED(__LOCATION__, $"Dumping {n.kind.name}");
    }
}

fn ast_dump_tree (root: AST_node&) {
    if (!root) {
        $"ast_dump_tree: 'null' root node\n";
        return;
    }

    let num_spaces = 0;

    ast_dump_visitor(root, num_spaces);
}
