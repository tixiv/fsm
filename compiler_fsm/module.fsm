
import * from "std";
import * from "endlos";
import * from "common";
import * from "type";
import * from "ast";
import * from "tokenizer";
import * from "symbol";

struct Import {
    name: u8[];
    location: Location&;
    module: Module&; // filled in by compile module
}

struct LocationRange {
    start_line: i32;
    end_line: i32;
    start_col:i32;
    end_col:i32;
}

struct Diagnostic {
    message: u8[];
    range: LocationRange;
}

enum ModuleState {
    NotCompiled,
    Compiling,
    CompilationFailed,
    Compiled,
}

struct Module {
    header: ModuleHeader;
    code_buffer: u8[];
    code: u8[];
    symbols: Symbol[];
    global_symbols: Symbol&[];
    ast_root: AST_node&;
    diagnostics: EndlosArr<Diagnostic>;
    imports: Import[];
    state: ModuleState;
}
