
import * from "std";
import * from "common";
import * from "type";
import * from "ast";
import * from "tokenizer";
import * from "symbol";

struct Import {
    name: u8[];
    location: Location&;
    module: Module&; // filled in by compile module
}

struct Module {
    header: ModuleHeader;
    code: u8[];
    tokens: Token[];
    symbols: Symbol[];
    global_symbols: Symbol&[];
    ast_root: AST_node&;
    imports: Import[];
}
