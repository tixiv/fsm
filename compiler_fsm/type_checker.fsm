*/

fn type_check_symbol(n: AST_node&, type_checker: TypeChecker&)
{
    // check for recursive use of the function we are propagating right now
    if (n.symbol.symbol == type_checker.current_function_symbol &&
        !n.symbol.symbol.type.fun.return_type)
    {
        // Maybe we have a return type by now? In the recursive fibonacci
        // test we would for example because it returns something before
        // doing the recursion
        update_current_function_type(type_checker);

        // Still no return type?
        if (!n.symbol.symbol.type.fun.return_type) {
            type_checker_error(n.line_number,
                "The return type for function '%.*s()' can't be determined automatically in recursive use. Please specify it!",
                SV_prnt(n.symbol.name));
        }
    }

    if (type_checker.generic_type) {
        if (n.symbol.symbol.kind == SYM_function) {
            n.symbol.symbol = get_speciated_function_symbol(n, n.symbol.symbol, type_checker);
            n.symbol.name = n.symbol.symbol.name;
        }
        else {
            type_checker_error(n, "Generic speciation not allowed for %s\n", symbol_kind_name(n.symbol.symbol.kind));
        }
    }
    n.type => n.symbol.symbol.type;
    n.addressable = n.symbol.symbol.kind != SYM_type;
}

fn type_propagation_visitor(n: AST_node&, type_checker: TypeChecker&) {
    char buf_1[1024]; char buf_2[1024];

    // actions while traversing the tree down
    switch (n.kind) {
        if (n.kind == AST_node::AST_function) {
            type_checker.current_function_symbol = n.fun.symbol;
            type_checker.current_function_ret_type_decl = nullptr;
            type_checker.current_function_ret_type = nullptr;

            if (n.fun.ret_typedecl) {
                type_checker.current_function_ret_type = n.fun.ret_typedecl.type;
                type_checker.current_function_ret_type_decl = n.fun.ret_typedecl.type;
            }
            
            if (n.fun.body) type_propagation_visitor(n.fun.body, type_checker);

            update_current_function_type(type_checker);

            type_checker.current_function_symbol = nullptr;
            type_checker.current_function_ret_type = nullptr;
            type_checker.current_function_ret_type_decl = nullptr;
        }

        else if (n.kind == AST_node::AST_generic_speciation) {
            type_checker.generic_type = n.generic_speciation.typedecl.type;
            ast_visit_children(n, type_propagation_visitor, type_checker);
            type_checker.generic_type = nullptr;
        }

        else if (n.kind == AST_node::AST_generic) {
            // Not visiting children since there is no sense in type checking the generic without speciation
            n.type => type_checker.type_cache.builtin_void;
        }
        
        else if (n.kind == AST_node::AST_generic_implementation) {
            // implementation has already been type checked
            n.type => type_checker.type_cache.builtin_void;
        }
        
        else if (n.kind == AST_node::AST_program) {
            type_checker.program = n;
            ast_visit_children(n, type_propagation_visitor, type_checker);
        }

        else {
            ast_visit_children(n, type_propagation_visitor, type_checker);
        }
    }

    // actions while traversing the tree up
    if (n.kind == AST_node::AST_number) {
        n.type => type_checker.type_cache.builtin_i64;
        n.addressable = false;
    }
    else if (n.kind == AST_node::AST_bool) {
        n.type => type_checker.type_cache.builtin_bool;
        n.addressable = false;
    }
    else if (n.kind == AST_node::AST_var_decl) {
        Type *t;
        if (n.var_decl._typedecl) {
            t = n.var_decl._typedecl.type;
        }
        else if (n.var_decl.initializer) {
            if (n.var_decl.initializer_operator == TokenKind::TOK_equal_assign) {
                t = n.var_decl.initializer.type;
                if (t == type_checker.type_cache.builtin_void) {
                    type_checker_error(n, "Can't initialize variable with 'void' type.\n");
                }
                int ord = get_ref_order(t);
                if (ord >= 2) {
                    type_checker_error(n, "Can't dereference references of order >1 in value initialization. Have '%'",
                        get_type_name_r(buf_1, t));
                }
                else if (ord) {
                    insert_dereference(n.var_decl.initializer);
                    t => dereferenced_type(t);
                }
            } else if (n.var_decl.initializer_operator == TokenKind::TOK_bind_ref) {
                if (n.var_decl.initializer.type == type_checker.type_cache.builtin_void) {
                    type_checker_error(n, "Can't bind a reference to 'void' type target.\n");
                }
                if (!is_reference_kind(n.var_decl.initializer.type)) {
                    if (!n.var_decl.initializer.addressable) type_checker_error(n, "Can't bind a reference to a non addressable target.\n");
                    t = get_ref_type_for(n.var_decl.initializer.type);
                    insert_take_reference(n.var_decl.initializer);
                }
                else {
                    t = n.var_decl.initializer.type;
                }
            } else {
                NOT_IMPLEMENTED("Initialization with operator %s is not implemented.\n", token_kind_name(n.var_decl.initializer_operator));
            }
        }
        else {
            t = type_checker.type_cache.builtin_i64;
        }
        n.var_decl.symbol.type = t;

        if (n.var_decl.initializer)
            try_convert_to_type_if_necessary(n.var_decl.initializer, t, "Initializer");

        n.type => type_checker.type_cache.builtin_void; // the declaration itself has no value.
    }
    else if (n.kind == AST_node::AST_symbol) {
        type_check_symbol(n, type_checker);
    }

    else if (n.kind == AST_node::AST_binary) {
        type_propagate_binary_operator(n);
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_call) {
        type_check_function_call(n, type_checker);
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_cast) {
        ASSERT(n.type, "Cast without a type. It should have been set at construction.\n");
        n.addressable = n._cast.body.addressable;
    }

    else if (n.kind == AST_node::AST_user_cast) {
        n.type => n.user_cast.typedecl.type;
        n.addressable = n._cast.body.addressable;
    }

    else if (n.kind == AST_node::AST_return) {
        ASSERT(type_checker.current_function_symbol, "Encountered 'return' without active function symbol\n")
        Type *ret_type;
        if (n.ret.body) 
            ret_type = n.ret.body.type
        else
            ret_type = type_checker.type_cache.builtin_void

        if (type_checker.current_function_ret_type == nullptr) {
            type_checker.current_function_ret_type = ret_type;
        } else {
            if (type_checker.current_function_ret_type_decl && type_checker.current_function_ret_type_decl != type_checker.type_cache.builtin_void) {
                if (ret_type == type_checker.type_cache.builtin_void) type_checker_error(n, "'return' without a value in function returning non void.\n");
                try_convert_to_type_if_necessary(n.ret.body, type_checker.current_function_ret_type_decl, "Return argument");
            }
            else if (is_reference_kind(type_checker.current_function_ret_type) && ret_type == type_checker.type_cache.builtin_null) {
            }
            else if (type_checker.current_function_ret_type == type_checker.type_cache.builtin_null && is_reference_kind(ret_type)) {
                type_checker.current_function_ret_type = ret_type;
            }
            else if (!types_are_equivalent(type_checker.current_function_ret_type, ret_type)) {
                type_checker_error(n, "Returning different types from the same function. Have '%s' and '%s'. Please declare a return type!\n",
                    get_type_name_r(buf_1, type_checker.current_function_ret_type), get_type_name_r(buf_2, ret_type));
            }
        }
        n.type => type_checker.type_cache.builtin_void; // The return itself always has 'void' type.
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_function) {
        // function return type is handled in the 'case' for 'AST_return'.
        n.type => n.fun.symbol.type;
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_while) {
        try_convert_to_type_if_necessary(n._while.condition, type_checker.type_cache.builtin_bool, "'while' loop condition");
        n.type => type_checker.type_cache.builtin_void;
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_for) {
        n.type => type_checker.type_cache.builtin_void;
        if (n._for.condition)
            try_convert_to_type_if_necessary(n._for.condition, type_checker.type_cache.builtin_bool, "'for' loop condition");
        if (n._for.result)
            n.type => n._for.result.type;

        n.addressable = false;
    }
    
    else if (n.kind == AST_node::AST_if) {
        try_convert_to_type_if_necessary(n._if.condition, type_checker.type_cache.builtin_bool, "'if' condition");
        let _if_type => n._if.if_clause.type;
        let _else_type => if (n._if.else_clause) n._if.else_clause.type else type_checker.type_cache.builtin_void;
        if (n.result_used && _if_type != _else_type) {
            type_checker_error(n.line_number,
                "When the result of 'if' is used then it has to have an 'else', and both branches must have the same type. Have '%s' and '%s'.\n",
                get_type_name_r(buf_1, _if_type), get_type_name_r(buf_2, _else_type));
        }
        n.type => _if_type;
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_string) {
        n.type => type_checker.type_cache.builtin_u8_slice;
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_char_constant) {
        n.type => type_checker.type_cache.builtin_i32;
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_array_access) {
        if (is_reference_kind(n._array.array.type))
            insert_dereference(n._array.array);

        if (is_array_kind(n._array.array.type)) {
            n.type => get_ref_type_for(n._array.array.type._array.element_type);    
        }
        else if (is_slice_type(n._array.array.type)) {
            n.type => get_ref_type_for(get_slice_element_type(n._array.array.type));
        }
        else {
            type_checker_error(n.line_number,
                "Invalid use of [] operator on something that is not an array or a slice. Have '%s'.\n",
                get_type_name_r(buf_1, n._array.array.type));
        }


        if (!is_integer_kind(n._array.index.type)) {
            type_checker_error(n.line_number,
                "Invalid use of non integer type '%s' as an array index.\n",
                get_type_name_r(buf_1, n._array.index.type));

        }
        
        n.addressable = true;
    }

    else if (n.kind == AST_node::AST_dereference) {
        if (!is_reference_kind(n.deref.body.type)) {
                type_checker_error(n.line_number,
                    "Dereferencing something that is not a reference. Have '%s'.\n",
                    get_type_name_r(buf_1, n.deref.body.type));
        } else {
            n.type => dereferenced_type(n.deref.body.type);
            n.addressable = true;
        }
    }

    else if (n.kind == AST_node::AST_reference) {
        if (!n.reference.body.addressable) type_checker_error(n, "Can't take reference to something that is not addressable.\n",
            get_type_name_r(buf_1, n.reference.body.type));
        
        n.type => get_ref_type_for(n.reference.body.type);
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_unary) {
        if (n.unary.token_kind == TokenKind::TOK_exclam) {
            try_convert_to_type_if_necessary(n.unary.body, type_checker.type_cache.builtin_bool, "Argument of unary '!'");
            n.type => type_checker.type_cache.builtin_bool;
        }
        else if (n.unary.token_kind == TokenKind::TOK_minus) {
            try_convert_to_type_if_necessary(n.unary.body, type_checker.type_cache.builtin_i64, "Argument of unary '-'");
            n.type => type_checker.type_cache.builtin_i64;
        }
        else NOT_IMPLEMENTED("Type checking unary operator %s is not implemented yet.\n", token_kind_printable(n.unary.token_kind));
        n.addressable = false;
    }
    
    else if (n.kind == AST_node::AST_plus_plus) {
        Type * original_type = n.plus_plus.body.type;
        auto_dereference(n.plus_plus.body);
        if (is_slice_type(n.plus_plus.body.type)) {
            n.type => n.plus_plus.body.type._struct.members[0].type;
        }
        else if (is_integer_kind(n.plus_plus.body.type)) {
            n.type => n.plus_plus.body.type;
        }
        else{
            type_checker_error(n, "Operator '++' needs integer or slice type argument. Have '%s'",
                get_type_name_r(buf_1, original_type));
        }
        
    }

    else if (n.kind == AST_node::AST_minus_minus) {
        Type * original_type = n.minus_minus.body.type;
        auto_dereference(n.minus_minus.body);
        if (!is_integer_kind(n.minus_minus.body.type)) {
            type_checker_error(n, "Operator '--' needs integer type argument. Have '%s'",
                get_type_name_r(buf_1, original_type));
        }
        n.type => n.minus_minus.body.type;
    }

    else if (n.kind == AST_node::AST_member_access) {
        ASSERT(n.member_access.body.type, "Unresolved type encountered in member access.\n");
        Type *container = n.member_access.body.type;
        if (sv_compare_cstr(&n.member_access.name, "sizeof")) {
            n.kind = AST_array_len;
            n.array_len.len = container.storage_size;
            n.addressable = false;
            n.type => type_checker.type_cache.builtin_i64;
        }
        else {

            if (is_reference_kind(container)) container => dereferenced_type(container);
            
            if (is_struct_kind(container) || is_record_kind(container) || is_union_kind(container)) {
                let offset;
                Type *t = get_member_type_and_offset_by_name(container, &n.member_access.name, &offset);
                if (!t) type_checker_error(n, "Member '%.*s' not found in '%s'.\n", SV_prnt(n.member_access.name),
                        get_type_name_r(buf_1, container));

                if (!is_reference_kind(n.member_access.body.type))
                    insert_take_reference(n.member_access.body);

                n.type => get_ref_type_for(t);
                n.member_access.offset = offset;
                n.addressable = true;

                // We need to insert a dereference node now at this point in the tree.
                // copy the current node to a new one:
                let ast_member_access => ast_alloc(type_checker.ast_allocator, AST_node::AST_member_access, n.location);
                memcpy(ast_member_access, n, sizeof(AST_node));
                ast_member_access.next = nullptr; // clear next pointer in case it was used

                // Now we overwrite the current node, making it the dereference node with the member acces in it's body
                n.kind = AST_dereference;
                n.deref.body = ast_member_access;
                n.type => dereferenced_type(ast_member_access.type);
            }
            else if (is_array_kind(container)) {
                if(sv_compare_cstr(&n.member_access.name, "len")) {
                    n.kind = AST_array_len;
                    n.array_len.len = container._array.n_elements;
                    n.addressable = false;
                    n.type => type_checker.type_cache.builtin_i64;
                }
                else {
                    type_checker_error(n, "Tried to access non existent member '%.*s' on array type. Arrays only have the member 'len' available.\n",
                            SV_prnt(n.member_access.name));
                }
            }
            else if (is_enum_kind(container) || is_enumerator_kind(container)) {
                if(sv_compare_cstr(&n.member_access.name, "name")) {
                    n.addressable = false;
                    n.type => type_checker.type_cache.builtin_u8_slice;
                }
                else {
                    type_checker_error(n, "Tried to access non existent member '%.*s' on enum type. Enums only have the member 'name' available.\n",
                            SV_prnt(n.member_access.name));
                }
            }
            else {
                type_checker_error(n, "Tried to access a member in something that can't have members. Have '%s'.\n",
                        get_type_name_r(buf_1, container));
            }

        }
    }

    else if (n.kind == AST_node::AST_namespace_access) {
        Type *t = n.namespace_access.body.type;
        if (t.kind == T_enum) {
            if (!get_enum_member_value (t, &n.namespace_access.name, &n.namespace_access.enum_value))
            {
                type_checker_error(n, "Member '%.*s' not found in '%s'.\n", SV_prnt(n.namespace_access.name),
                    get_type_name_r(buf_1, t));
            }
            n.type => t;
            n.addressable = false;
        }
        else if (t.kind == T_union) {
            if (!get_union_member_value (t, &n.namespace_access.name, &n.namespace_access.enum_value))
            {
                type_checker_error(n, "Member '%.*s' not found in '%s'.\n", SV_prnt(n.namespace_access.name),
                    get_type_name_r(buf_1, t));
            }
            n.type => get_enumerator_type_for(t);
            n.addressable = false;
        }
        else NOT_IMPLEMENTED("Namespace access is not implemented yet for typ %s.\n", get_type_name_r(buf_1, t));
    }

    else if (n.kind == AST_node::AST_variadic_operator) {
        type_check_variadic_operator(n);
    }

    else if (n.kind == AST_node::AST_builder_string) {
        type_check_builder_string(n);
        n.type => type_checker.type_cache.builtin_u8_slice;
    }

    else if (n.kind == AST_node::AST_null) {
        n.type => type_checker.type_cache.builtin_null;
    }

    else if (n.kind == AST_node::AST_generic) {
        n.type => type_checker.type_cache.builtin_void;
    }

    else if (n.kind == AST_node::AST_generic_speciation) {
        n.type => n.generic_speciation.body.type;
    }
            
    else if (n.kind == AST_node::AST_generic_implementation) {
        // already handled
    }

    else if (n.kind == AST_node::AST_typename
                    |== AST_node::AST_member_def
                    |== AST_node::AST_union_member_def
                    |== AST_node::AST_struct
                    |== AST_node::AST_union
                    |== AST_node::AST_enum
                    |== AST_node::AST_enum_member
                    |== AST_node::AST_type_ref
                    |== AST_node::AST_type_array
                    |== AST_node::AST_type_slice
                    |== AST_node::AST_function_type
                    |== AST_node::AST_type_generic_speciation)
    {
        // already filled in by type resolver
    }
    else if (n.kind == AST_node::AST_arg_list
                    |== AST_node::AST_program
                    |== AST_node::AST_scope)
    {
        // these have void type
        n.type => type_checker.type_cache.builtin_void;
    }
    else {
        NOT_IMPLEMENTED("Type checking %s is not implemented yet.\n", ast_kind_name(n.kind));
    }

    ASSERT(n.type, "All nodes should have a type after the type checker. Have %s with null type.\n", ast_kind_name(n.kind));
}

fn run_typechecking(root: AST_node&) {
    ast_root = root;

    annotate_used_visitor(root, 0);

    type_resolve_functions_visitor(root, &pvd);
    type_propagation_visitor(root, &pvd);
}
