
import * from "std";
import * from "endlos";
import * from "type";
import * from "ast";


fn type_checker_error(n: AST_node&, s: u8[]) {
    let l = n.location;
    write(2, $"[FSM Type Checker] {l.module.filename}:{l.line} Error: {s}\n");
    exit(1);
}

fn type_checker_warning(n: AST_node&, s: u8[]) {
    let l = n.location;
    write(2, $"[FSM Type Checker] {l.module.filename}:{l.line} Warning: {s}\n");
}

struct TypeChecker {
    type_cache: TypeCache&;
    symbol_cache: SymbolCache&;
    ast_allocator: AST_Node_Allocator&;
    endlos: EndlosAllocator&;
    used: bool;
    current_function_symbol: Symbol&;
    current_function_ret_type_decl: Type&;
    current_function_ret_type: Type&;
    arg_symbols: EndlosArr<Symbol&>;
    generic_type: Type&;
    program: AST_node&;
}

fn annotate_used_visitor(n: AST_node&, type_checker: TypeChecker&) {
    if (!n) return;
    n.result_used = type_checker.used;

    if (n.kind == AST_node::AST_scope) {
        if (type_checker.used) type_checker_error(n, "Using the result of a scope is not implemented yet.\n");
        type_checker.used = false;
        ast_visit_children(n, annotate_used_visitor, type_checker);
    }
    else if (n.kind == AST_node::AST_var_decl
                    |== AST_node::AST_call
    ) {
        ast_visit_children(n, annotate_used_visitor, type_checker);
    }
    else if (n.kind == AST_node::AST_return) {
        if (type_checker.used) type_checker_error(n, "The 'return' statement has no value and therefore can't be used in an expression.\n");
        ast_visit_children(n, annotate_used_visitor, type_checker);
    }
    else if (n.kind == AST_node::AST_if) {
        type_checker.used = true;
        annotate_used_visitor(n.AST_if.condition, type_checker);
        type_checker.used = n.result_used;
        annotate_used_visitor(n.AST_if.if_clause, type_checker);
        annotate_used_visitor(n.AST_if.else_clause, type_checker);
    }
    else if (n.kind == AST_node::AST_while) {
        if (type_checker.used) type_checker_error(n, "The 'while' statement has no value and therefore can't be used in an expression.\n");
        type_checker.used = true;
        annotate_used_visitor(n.AST_while.condition, type_checker);
        type_checker.used = false;
        annotate_used_visitor(n.AST_while.body, type_checker);
    }
    else if (n.kind == AST_node::AST_for) {
        type_checker.used = false;
        annotate_used_visitor(n.AST_for.initializer, type_checker);
        type_checker.used = true;
        annotate_used_visitor(n.AST_for.condition, type_checker);
        type_checker.used = false;
        annotate_used_visitor(n.AST_for.post_action, type_checker);
        annotate_used_visitor(n.AST_for.body, type_checker);
    }
    else if (n.kind == AST_node::AST_binary) {
        if (n.AST_binary.token_kind == TokenKind::TOK_equal_assign) {
            type_checker.used = true;
            ast_visit_children(n, annotate_used_visitor, type_checker);
        }
        else if (n.AST_binary.token_kind == TokenKind::TOK_boolean_and || n.AST_binary.token_kind == TokenKind::TOK_boolean_or) {
            type_checker.used = true;
            annotate_used_visitor(n.AST_binary.left, type_checker);
            type_checker.used = n.result_used;
            annotate_used_visitor(n.AST_binary.right, type_checker);
        }
        else {
            ast_visit_children(n, annotate_used_visitor, type_checker);
        }
    }
    else if (n.kind == AST_node::AST_builder_string) {
        // unused builder string implies handing it to 'puts'
        if (!type_checker.used) {
            let ast_call => ast_alloc(type_checker.ast_allocator, AST_node::AST_call, n.location);
            let ast_symbol => ast_alloc(type_checker.ast_allocator, AST_node::AST_symbol, n.location);
            ast_symbol.AST_symbol.name = "puts";
            ast_symbol.AST_symbol.symbol => get_global_symbol_by_name(type_checker.symbol_cache, "puts");
            ast_call.AST_call.target => ast_symbol;
            ast_insert_node(type_checker.ast_allocator, n, ast_call);
            type_checker.used = true;
            ast_visit_children(n, annotate_used_visitor, type_checker);    
        }
    }
    else {
        ast_visit_children(n, annotate_used_visitor, type_checker);
    }

    type_checker.used = n.result_used;
}


fn insert_dereference(type_checker: TypeChecker&, n: AST_node&) {
    ASSERT (is_reference_kind(n.type), "Trying to insert dereference for something that is not a reference.\n")
    let deref => ast_alloc(type_checker.ast_allocator, AST_node::AST_dereference, n.location);
    deref.type => dereferenced_type(n.type);
    deref.addressable = true;
    ast_insert_node(type_checker.ast_allocator, n, deref);
}

fn auto_dereference(type_checker: TypeChecker&, n: AST_node&) {
    if (!is_reference_kind(n.type)) return;
    insert_dereference(type_checker, n);
}

fn insert_take_reference(type_checker: TypeChecker&, n: AST_node&) {
    let ref => ast_alloc(type_checker.ast_allocator, AST_node::AST_reference, n.location);
    ref.type => get_ref_type_for(type_checker.type_cache, n.type);
    ref.addressable = false;
    ast_insert_node(type_checker.ast_allocator, n, ref);
}

fn check_function_argument_compatible(type_checker: TypeChecker&, arg_1: Type&, arg_2: Type&) : bool {
    return arg_1 <==> arg_2
        || (is_reference_kind(arg_1) && is_reference_kind(arg_2)
             && (dereferenced_type(arg_1) <==> type_checker.type_cache.builtin_any
                  || dereferenced_type(arg_2) <==> type_checker.type_cache.builtin_any) );
}

fn check_function_refs_compatible (type_checker: TypeChecker&, fn_ref_1: Type&, fn_ref_2: Type&) : bool {
    if (is_function_reference(fn_ref_1) && is_function_reference(fn_ref_2)) {
        let fn_1 => dereferenced_type(fn_ref_1);
        let fn_2 => dereferenced_type(fn_ref_2);
        if (fn_1.T_function.argument_types.len == fn_2.T_function.argument_types.len
            && check_function_argument_compatible(type_checker, fn_1.T_function.return_type, fn_2.T_function.return_type))
        {
            for (let i = 0; i < fn_2.T_function.argument_types.len; i++) {
                if (!check_function_argument_compatible(type_checker, fn_1.T_function.argument_types[i], fn_2.T_function.argument_types[i])) {
                    return false;
                }
            }
            return true;
        }
    }
    return false;
}

fn make_cast(type_checker: TypeChecker&, to: Type&, from: Type&) : AST_node& {
    ASSERT(is_castable_to(type_checker.type_cache, to, from), $"{__LOCATION__}: make_cast() should only be called if the cast is possible.\n");
    
    let loc: Location; // 'location' will be filled in when the cast is inserted.
    let n => ast_alloc(type_checker.ast_allocator, AST_node::AST_cast, loc);
    n.type => to;
    n.AST_cast.right_type => from;

    return n;
}

fn try_convert_to_type_if_necessary(type_checker: TypeChecker&, n: AST_node&, target_type: Type&, desc: u8[]) {
    let buf_1: u8[1024]; let buf_2: u8[1024];
    let original_type => n.type;
    $"try_convert_to_type_if_necessary begin {get_type_name_r(buf_1, original_type)} {get_type_name_r(buf_2, target_type)}\n"


    if (target_type <==> original_type) return;

    if (target_type <==> type_checker.type_cache.builtin_bool && is_reference_kind(original_type)) {
        if (dereferenced_type(original_type) <==> type_checker.type_cache.builtin_bool) {
            type_checker_warning(n,
"Using 'bool&' in boolean context will dereference the target and not perform a null reference check.
Suggest to either dereference, when the value is what you want, or to write '... != null' if you wanted,
or to perform a null reference check.");
        }
        else {
            ast_insert_node(type_checker.ast_allocator, n, make_cast(type_checker, type_checker.type_cache.builtin_bool, original_type));
            return;
        }
    }

    if (!is_reference_kind(target_type) && is_reference_kind(original_type)) {
        insert_dereference(type_checker, n);
    }

    if (is_slice_kind(target_type) && is_array_kind(n.type)) {
        if (get_slice_element_type(target_type) <==> n.type.T_array.element_type) {
            let conv => ast_alloc(type_checker.ast_allocator, AST_node::AST_array_to_slice, n.location);
            conv.type => get_slice_type(type_checker.type_cache, n.type.T_array.element_type);
            ast_insert_node(type_checker.ast_allocator, n, conv);
            return;
        }
        else {
            type_checker_error(n, $"Can't convert {desc} of type '{get_type_name_r(buf_1, original_type)}' to '{get_type_name_r(buf_2, target_type)}'.\n");
        }
    }

    if (is_slice_kind(target_type)
      && get_slice_element_type(target_type) <==> type_checker.type_cache.builtin_u8
        && is_record_kind(n.type))
    {
        ast_insert_node(type_checker.ast_allocator, n, make_cast(type_checker, target_type, n.type));
        return;
    }

    if (is_reference_kind(target_type) && original_type <==> type_checker.type_cache.builtin_null) return;

    if (target_type <==> get_ref_type_for(type_checker.type_cache, type_checker.type_cache.builtin_any)) {
        if (!is_reference_kind(original_type)) {
            if (n.addressable == false) type_checker_error(n, $"Can't convert {desc} of type '{get_type_name_r(buf_1, original_type)}' to '{get_type_name_r(buf_2, target_type)}' because it is not addressable.\n");            
            insert_take_reference(type_checker, n);
        }
        return; // any& can accept any reference type.
    }

    if (is_reference_kind(target_type) && !is_reference_kind(original_type)) {
        if (n.addressable == false) type_checker_error(n, $"Can't convert {desc} of type '{ get_type_name_r(buf_1, original_type)}' to '{get_type_name_r(buf_2, target_type)}' because it is not addressable.\n");
        insert_take_reference(type_checker, n);
    }

    if (n.type <==> target_type) return;

    if (is_integer_kind(target_type) && (is_enum_kind(n.type) || is_enumerator_kind(n.type))) return;
    if ((is_enum_kind(target_type) || is_enumerator_kind(target_type)) && is_integer_kind(n.type)) return;


    if (check_function_refs_compatible(type_checker, target_type, n.type))
        return;

    if (is_castable_to(type_checker.type_cache, target_type, n.type)) {
        ast_insert_node(type_checker.ast_allocator, n, make_cast(type_checker, target_type, n.type));
    }
    else {
        type_checker_error(n, $"Can't convert {desc} of type '{get_type_name_r(buf_1, original_type)}' to '{get_type_name_r(buf_2, target_type)}'.\n");
    }
}

fn type_propagate_binary_operator(type_checker: TypeChecker&, n: AST_node&) {
    let buf_1: u8[1024]; let buf_2: u8[1024];
    let tk = n.AST_binary.token_kind;


    if (tk == TokenKind::TOK_bind_ref) {
        if (!is_reference_kind(n.AST_binary.left.type)) {
            type_checker_error(n, $"Operator {token_kind_printable(tk)} requires a reference type on the left side. Have '{get_type_name_r(buf_1, n.AST_binary.left.type)}' and '{get_type_name_r(buf_2, n.AST_binary.right.type)}'.\n");
        }

        if (n.AST_binary.right.type <==> type_checker.type_cache.builtin_null) {
        }
        else
        {
            if (!is_reference_kind(n.AST_binary.right.type)) {
                if (!n.AST_binary.right.addressable) type_checker_error(n,
                    $"Operator {token_kind_printable(tk)} requires either another reference or something addressable on the right side. Have '{get_type_name_r(buf_1, n.AST_binary.left.type)}' and '{get_type_name_r(buf_2, n.AST_binary.right.type)}'.\n");
                insert_take_reference(type_checker, n.AST_binary.right);
            }

            let any_ref => get_ref_type_for(type_checker.type_cache, type_checker.type_cache.builtin_any);

            if (n.AST_binary.left.type <!=> n.AST_binary.right.type && n.AST_binary.left.type <!=> any_ref && n.AST_binary.right.type <!=> any_ref) {
                type_checker_error(n, $"Operator {token_kind_printable(tk)} requires the type on the right side to be referenceable by the left type. Have '{get_type_name_r(buf_1, n.AST_binary.left.type)}' and '{get_type_name_r(buf_2, n.AST_binary.right.type)}'.\n");
            }
        }
        
        n.type => n.AST_binary.right.type;
    }
    else {
        let sb_left  = $"left argument of binary operator {token_kind_printable(tk)}";
        let sb_right = $"right argument of binary operator {token_kind_printable(tk)}";

        if (tk == TokenKind::TOK_plus
              |== TokenKind::TOK_minus
              |== TokenKind::TOK_asterisk
              |== TokenKind::TOK_slash
              |== TokenKind::TOK_percent
              |== TokenKind::TOK_up_arrow)
        {
            try_convert_to_type_if_necessary(type_checker, n.AST_binary.left, type_checker.type_cache.builtin_i64, sb_left);
            try_convert_to_type_if_necessary(type_checker, n.AST_binary.right, type_checker.type_cache.builtin_i64, sb_right);

            n.type => type_checker.type_cache.builtin_i64;
        }

        else if (tk == TokenKind::TOK_greater
                   |== TokenKind::TOK_lower
                   |== TokenKind::TOK_greater_equal
                   |== TokenKind::TOK_lower_equal)
        {
            try_convert_to_type_if_necessary(type_checker, n.AST_binary.left, type_checker.type_cache.builtin_i64, sb_left);
            try_convert_to_type_if_necessary(type_checker, n.AST_binary.right, type_checker.type_cache.builtin_i64, sb_right);

            n.type => type_checker.type_cache.builtin_bool;
        }
        
        else if (tk == TokenKind::TOK_boolean_and
                   |== TokenKind::TOK_boolean_or) {
            try_convert_to_type_if_necessary(type_checker, n.AST_binary.left, type_checker.type_cache.builtin_bool, sb_left);
            try_convert_to_type_if_necessary(type_checker, n.AST_binary.right, type_checker.type_cache.builtin_bool, sb_right);
            n.type => type_checker.type_cache.builtin_bool;            
        }
        
        else if (tk == TokenKind::TOK_equal
                   |== TokenKind::TOK_unequal) {
            auto_dereference(type_checker, n.AST_binary.left);
            auto_dereference(type_checker, n.AST_binary.right);
            let okay = n.AST_binary.left.type <==>n.AST_binary.right.type || (is_integer_kind(n.AST_binary.left.type) && is_integer_kind(n.AST_binary.right.type));
            if (!okay) {
                type_checker_error(n,
                    $"Operator {token_kind_printable(tk)} can't accept arguments with different types. Have '{get_type_name_r(buf_1, n.AST_binary.left.type)}' and '{get_type_name_r(buf_2, n.AST_binary.right.type)}'.\n");
            }
            n.type => type_checker.type_cache.builtin_bool;
        }

        else if (tk == TokenKind::TOK_equal_assign) {
            auto_dereference(type_checker, n.AST_binary.left);
            auto_dereference(type_checker, n.AST_binary.right);
            try_convert_to_type_if_necessary(type_checker, n.AST_binary.right, n.AST_binary.left.type, "Argument of operator '='");
            n.type => n.AST_binary.right.type;
        }

        else {
            NOT_IMPLEMENTED(__LOCATION__, $"Type checking binary operator {token_kind_printable(n.AST_binary.token_kind)}\n");
        }
    }
}

fn type_check_variadic_operator (type_checker: TypeChecker&, n: AST_node&){
    let tk = n.AST_variadic_operator.members[0].token_kind;

    if (tk == TokenKind::TOK_greater
            |== TokenKind::TOK_lower
            |== TokenKind::TOK_greater_equal
            |== TokenKind::TOK_lower_equal)
    {
        for (let i = 0; i < n.AST_variadic_operator.members.len; i++) {
            try_convert_to_type_if_necessary(type_checker, n.AST_variadic_operator.left, type_checker.type_cache.builtin_i64, "Argument of variadic operator");
            try_convert_to_type_if_necessary(type_checker, n.AST_variadic_operator.members[i].right, type_checker.type_cache.builtin_i64, "Argument of variadic operator");                
        }
        n.type => type_checker.type_cache.builtin_bool;
        n.addressable = false;
    }
    
    else if (tk == TokenKind::TOK_equal
                |== TokenKind::TOK_unequal)
    {
        auto_dereference(type_checker, n.AST_variadic_operator.left);
        
        let left_type => n.AST_variadic_operator.left.type;
        let all_same_type = true;
        let all_integer = is_integer_kind(left_type);

        for (let i = 0; i < n.AST_variadic_operator.members.len; i++) {
            auto_dereference(type_checker, n.AST_variadic_operator.members[i].right);
            if (left_type <!=> n.AST_variadic_operator.members[i].right.type) all_same_type = false;
            if (!is_integer_kind(n.AST_variadic_operator.members[i].right.type)) all_integer = false;
        }

        if (!all_same_type && !all_integer) {
            type_checker_error(n, $"Chained operator {token_kind_printable(n.AST_variadic_operator.members[0].token_kind)} can't accept arguments with different types.");
        }
        n.type => type_checker.type_cache.builtin_bool;
        n.addressable = false;
    }
    else {
        NOT_IMPLEMENTED(__LOCATION__, $"Type checking variadic operator {token_kind_printable(n.AST_variadic_operator.members[0].token_kind)}")
    }
}

fn type_check_builder_string(type_checker: TypeChecker&, b_str: AST_node&) {
    for (let n => b_str.AST_builder_string.body; n; n => n.next) {
        auto_dereference(type_checker, n);
        if (is_integer_kind(n.type)
            || n.type <==> get_slice_type(type_checker.type_cache, type_checker.type_cache.builtin_u8)
            || is_record_kind(n.type)
            || is_struct_kind(n.type))
        {
        }
        else {
            try_convert_to_type_if_necessary(type_checker, n, type_checker.type_cache.builtin_i64, "Argument of builder string");
        }
    }
}

fn type_check_function_call(type_checker: TypeChecker&, n_call: AST_node&) {
    let buf: u8[1024];
    let fn_type => n_call.AST_call.target.type;
    if (is_reference_kind(fn_type)) fn_type => dereferenced_type(fn_type);

    if (!is_function_kind(fn_type)) type_checker_error(n_call,
            $"Trying to call something that is not a function. have '{get_type_name_r(buf, n_call.AST_call.target.type)}'");
    
    let num_args_expected = fn_type.T_function.argument_types.len;
    let num_args = ast_count_chain(n_call.AST_call.args);
    if (num_args < num_args_expected) type_checker_error(n_call,
            $"Not enough arguments to function call. Expected {num_args_expected}, got {num_args}.\n");

    if (num_args > num_args_expected) type_checker_error(n_call,
            $"Too many arguments to function call. Expected {num_args_expected}, got {num_args}.\n");

    let arg => n_call.AST_call.args;
    for (let i = 0; i < num_args; i++) {
        let expected_type => fn_type.T_function.argument_types[i];
        try_convert_to_type_if_necessary(type_checker, arg, expected_type, "Function argument");
        arg => arg.next;
    }
    
    n_call.type => fn_type.T_function.return_type;
    if (!n_call.type) type_checker_error(n_call,
        "Trying to call function that doesn't have a resolved return type yet. Please define the function's return type when it's definition follows the call.\n");
}

fn update_current_function_type(type_checker: TypeChecker&) {
    // Check ret type changed during function type propagating
    if (type_checker.current_function_symbol.type &&
        type_checker.current_function_symbol.type.T_function.return_type <!=> type_checker.current_function_ret_type)
    {
        // yes: update function symbol with proper type
        type_checker.current_function_symbol.type =>
            get_function_type(type_checker.type_cache, type_checker.current_function_ret_type,
                type_checker.current_function_symbol.type.T_function.argument_types);
    }
}

fn type_resolve_functions_visitor(n: AST_node&, type_checker: TypeChecker&) : void {
    if (n.kind == AST_node::AST_function) {
        type_checker.current_function_symbol => n.AST_function.symbol;
        type_checker.current_function_ret_type_decl => null;
        type_checker.current_function_ret_type => null;

        if (n.AST_function.ret_typedecl) {
            type_resolve_functions_visitor(n.AST_function.ret_typedecl, type_checker);
            type_checker.current_function_ret_type => n.AST_function.ret_typedecl.type;
            type_checker.current_function_ret_type_decl => n.AST_function.ret_typedecl.type;
        }
        
        if (n.AST_function.args) type_resolve_functions_visitor(n.AST_function.args, type_checker);

        type_checker.current_function_symbol => null;
        type_checker.current_function_ret_type => null;
        type_checker.current_function_ret_type_decl => null;
    }
    else if (n.kind == AST_node::AST_arg_list) {
        let s_fun => type_checker.current_function_symbol;
        ASSERT(s_fun, "Encountered arglist without active function symbol.\n");
        
        EndlosArr_begin~Symbol&(type_checker.arg_symbols, type_checker.endlos);

        // visiting the children of the arg list will fill up 'arg_symbols'
        ast_visit_children(n, type_resolve_functions_visitor, type_checker);


        let arg_types = endlos_begin~Type&(type_checker.endlos);

        for (let i = 0; i < type_checker.arg_symbols.arr.len; i++) {
            *arg_types++ => type_checker.arg_symbols.arr[i].type;
        }

        arg_types = endlos_ripp_off~Type&(type_checker.endlos, arg_types);

        type_checker.current_function_symbol.type =>
            get_function_type(type_checker.type_cache, type_checker.current_function_ret_type, arg_types);
        
        $"Get_function_type {type_checker.arg_symbols.arr.len} {arg_types.len} \n"

    }
    else if (n.kind == AST_node::AST_arg_decl) {
        let t => if (n.AST_arg_decl._typedecl)
            n.AST_arg_decl._typedecl.type
        else
            &type_checker.type_cache.builtin_i64

        n.AST_arg_decl.symbol.type => t;
        EndlosArr_push_ref~Symbol&(type_checker.arg_symbols, n.AST_arg_decl.symbol);
        n.type => type_checker.type_cache.builtin_void; // the declaration itself has no value.
    }
    else {
        ast_visit_children(n, type_resolve_functions_visitor, type_checker);
    }
}


fn get_speciated_function_symbol(n: AST_node&, g: Symbol&, type_checker: TypeChecker&) : Symbol& {
    NOT_IMPLEMENTED(__LOCATION__, "get_speciated_function_symbol");
    /*
    if (!g.source) {
        type_checker_error(n, "Cannot speciate non generic function '%.*s'.\n", SV_prnt(g.name));
    }
    ASSERT(g.source.kind == AST_generic, "Speciate called on wrong kind of node.\n");
    ASSERT(g.source.AST_generic.body.kind == AST_function, "Speciate called on wrong kind of node.\n");

    SV encoded_name = encode_function_name(g.source.AST_generic.body.fun.name, type_checker.generic_type);

    let  existing = get_symbol_by_name(&global_symbols, &encoded_name);

    if (existing) return existing;
    
    let ast_generic = ast_copy_tree(g.source);
    let ast_fn = ast_generic.AST_generic.body;

    ast_fn.AST_function.name = encoded_name;

    type_resolver_speciate_generic(ast_generic, type_checker.generic_type);
    let s = resolver_speciate_generic(ast_generic, type_checker.generic_type);

    let prop_child: TypeChecker;
    prop_child.
    prop_child.program = type_checker.program;
    prop_child.current_function_symbol = s;
    dyn_array_init(&prop_child.arg_symbols, sizeof(Symbol*), 8);
    type_resolve_functions_visitor(ast_generic.AST_generic.body, &prop_child);
    type_propagation_visitor(ast_generic.AST_generic.body, &prop_child);


    let ast_implementation => ast_alloc(type_checker.ast_allocator, AST_node::AST_generic_implementation, ast_generic.line_number);
    ast_implementation.generic_implementation.body = ast_generic.AST_generic.body;

    ast_link_to_chain(&type_checker.program.program.body, ast_implementation);
    return s;
    */
    return null;
}

fn type_check_symbol(n: AST_node&, type_checker: TypeChecker&)
{
    // check for recursive use of the function we are propagating right now
    if (n.AST_symbol.symbol <==> type_checker.current_function_symbol &&
        !n.AST_symbol.symbol.type.T_function.return_type)
    {
        // Maybe we have a return type by now? In the recursive fibonacci
        // test we would for example because it returns something before
        // doing the recursion
        update_current_function_type(type_checker);

        // Still no return type?
        if (!n.AST_symbol.symbol.type.T_function.return_type) {
            type_checker_error(n,
                $"The return type for function '{n.AST_symbol.name}()' can't be determined automatically in recursive use. Please specify it!");
        }
    }

    if (type_checker.generic_type) {
        if (n.AST_symbol.symbol.kind == SymbolKind::SYM_function) {
            n.AST_symbol.symbol => get_speciated_function_symbol(n, n.AST_symbol.symbol, type_checker);
            n.AST_symbol.name = n.AST_symbol.symbol.name;
        }
        else {
            type_checker_error(n, $"Generic speciation not allowed for {n.AST_symbol.symbol.kind.name}\n");
        }
    }
    n.type => n.AST_symbol.symbol.type;
    n.addressable = n.AST_symbol.symbol.kind != SymbolKind::SYM_type;
}

fn type_propagation_visitor(n: AST_node&, type_checker: TypeChecker&) : void {
    let buf_1: u8[1024]; let buf_2: u8[1024];

    $"Type propagation visitor {n.kind.name}\n"
    // actions while traversing the tree down
    if (n.kind == AST_node::AST_function) {
        type_checker.current_function_symbol => n.AST_function.symbol;
        type_checker.current_function_ret_type_decl => null;
        type_checker.current_function_ret_type => null;

        if (n.AST_function.ret_typedecl) {
            type_checker.current_function_ret_type => n.AST_function.ret_typedecl.type;
            type_checker.current_function_ret_type_decl => n.AST_function.ret_typedecl.type;
        }
        
        if (n.AST_function.body) type_propagation_visitor(n.AST_function.body, type_checker);

        update_current_function_type(type_checker);

        type_checker.current_function_symbol => null;
        type_checker.current_function_ret_type => null;
        type_checker.current_function_ret_type_decl => null;
    }
    else if (n.kind == AST_node::AST_generic_speciation) {
        type_checker.generic_type => n.AST_generic_speciation.typedecl.type;
        ast_visit_children(n, type_propagation_visitor, type_checker);
        type_checker.generic_type => null;
    }
    else if (n.kind == AST_node::AST_generic) {
        // Not visiting children since there is no sense in type checking the generic without speciation
        n.type => type_checker.type_cache.builtin_void;
    }
    else if (n.kind == AST_node::AST_generic_implementation) {
        // implementation has already been type checked
        n.type => type_checker.type_cache.builtin_void;
    }
    else if (n.kind == AST_node::AST_program) {
        type_checker.program => n;
        ast_visit_children(n, type_propagation_visitor, type_checker);
    }

    else {
        ast_visit_children(n, type_propagation_visitor, type_checker);
    }

    // actions while traversing the tree up
    if (n.kind == AST_node::AST_number) {
        n.type => type_checker.type_cache.builtin_i64;
        n.addressable = false;
    }
    else if (n.kind == AST_node::AST_bool) {
        n.type => type_checker.type_cache.builtin_bool;
        n.addressable = false;
    }
    else if (n.kind == AST_node::AST_var_decl) {
        let t: Type&;
        if (n.AST_var_decl._typedecl) {
            t => n.AST_var_decl._typedecl.type;
        }
        else if (n.AST_var_decl.initializer) {
            if (n.AST_var_decl.initializer_operator == TokenKind::TOK_equal_assign) {
                t => n.AST_var_decl.initializer.type;
                if (is_void_kind(t)) {
                    type_checker_error(n, "Can't initialize variable with 'void' type.\n");
                }
                let ord = get_ref_order(t);
                if (ord >= 2) {
                    type_checker_error(n, $"Can't dereference references of order >1 in value initialization. Have '{get_type_name_r(buf_1, t)}'");
                }
                else if (ord) {
                    insert_dereference(type_checker, n.AST_var_decl.initializer);
                    t => dereferenced_type(t);
                }
            } else if (n.AST_var_decl.initializer_operator == TokenKind::TOK_bind_ref) {
                if (n.AST_var_decl.initializer.type <==> type_checker.type_cache.builtin_void) {
                    type_checker_error(n, "Can't bind a reference to 'void' type target.\n");
                }
                if (!is_reference_kind(n.AST_var_decl.initializer.type)) {
                    if (!n.AST_var_decl.initializer.addressable) type_checker_error(n, "Can't bind a reference to a non addressable target.\n");
                    t => get_ref_type_for(type_checker.type_cache, n.AST_var_decl.initializer.type);
                    insert_take_reference(type_checker, n.AST_var_decl.initializer);
                }
                else {
                    t => n.AST_var_decl.initializer.type;
                }
            } else {
                NOT_IMPLEMENTED(__LOCATION__, $"Initialization with operator {n.AST_var_decl.initializer_operator.name}");
            }
        }
        else {
            t => type_checker.type_cache.builtin_i64;
        }
        n.AST_var_decl.symbol.type => t;

        if (n.AST_var_decl.initializer)
            try_convert_to_type_if_necessary(type_checker, n.AST_var_decl.initializer, t, "Initializer");

        n.type => type_checker.type_cache.builtin_void; // the declaration itself has no value.
    }
    else if (n.kind == AST_node::AST_symbol) {
        type_check_symbol(n, type_checker);
    }

    else if (n.kind == AST_node::AST_binary) {
        type_propagate_binary_operator(type_checker, n);
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_call) {
        type_check_function_call(type_checker, n);
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_cast) {
        ASSERT(n.type, "Cast without a type. It should have been set at construction.\n");
        n.addressable = n.AST_cast.body.addressable;
    }

    else if (n.kind == AST_node::AST_user_cast) {
        n.type => n.AST_user_cast.typedecl.type;
        n.addressable = n.AST_user_cast.body.addressable;
    }

    else if (n.kind == AST_node::AST_return) {
        ASSERT(type_checker.current_function_symbol, "Encountered 'return' without active function symbol\n")
        let ret_type: Type&;
        if (n.AST_return.body) 
            ret_type => n.AST_return.body.type
        else
            ret_type => type_checker.type_cache.builtin_void

        if (!type_checker.current_function_ret_type) {
            type_checker.current_function_ret_type => ret_type;
        } else {
            if (type_checker.current_function_ret_type_decl && !(type_checker.current_function_ret_type_decl <==> type_checker.type_cache.builtin_void)) {
                if (ret_type <==> type_checker.type_cache.builtin_void) type_checker_error(n, "'return' without a value in function returning non void.\n");
                try_convert_to_type_if_necessary(type_checker, n.AST_return.body, type_checker.current_function_ret_type_decl, "Return argument");
            }
            else if (is_reference_kind(type_checker.current_function_ret_type) && ret_type <==> type_checker.type_cache.builtin_null) {
            }
            else if (type_checker.current_function_ret_type <==> type_checker.type_cache.builtin_null && is_reference_kind(ret_type)) {
                type_checker.current_function_ret_type => ret_type;
            }
            else if (!types_are_equivalent(type_checker.current_function_ret_type, ret_type)) {
                type_checker_error(n, $"Returning different types from the same function. Have '{get_type_name_r(buf_1, type_checker.current_function_ret_type)}' and '{get_type_name_r(buf_2, ret_type)}'. Please declare a return type!\n");
            }
        }
        n.type => type_checker.type_cache.builtin_void; // The return itself always has 'void' type.
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_function) {
        // function return type is handled in the 'case' for 'AST_return'.
        n.type => n.AST_function.symbol.type;
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_while) {
        try_convert_to_type_if_necessary(type_checker, n.AST_while.condition, type_checker.type_cache.builtin_bool, "'while' loop condition");
        n.type => type_checker.type_cache.builtin_void;
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_for) {
        n.type => type_checker.type_cache.builtin_void;
        if (n.AST_for.condition)
            try_convert_to_type_if_necessary(type_checker, n.AST_for.condition, type_checker.type_cache.builtin_bool, "'for' loop condition");
        if (n.AST_for.result)
            n.type => n.AST_for.result.type;

        n.addressable = false;
    }
    
    else if (n.kind == AST_node::AST_if) {
        try_convert_to_type_if_necessary(type_checker, n.AST_if.condition, type_checker.type_cache.builtin_bool, "'if' condition");
        let _if_type => n.AST_if.if_clause.type;
        let _else_type => if (n.AST_if.else_clause) n.AST_if.else_clause.type else &type_checker.type_cache.builtin_void;
        if (n.result_used && _if_type <!=> _else_type) {
            type_checker_error(n,
                $"When the result of 'if' is used then it has to have an 'else', and both branches must have the same type. Have '{get_type_name_r(buf_1, _if_type)}' and '{get_type_name_r(buf_2, _else_type)}'.\n");
        }
        n.type => _if_type;
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_string) {
        n.type => get_slice_type(type_checker.type_cache, type_checker.type_cache.builtin_u8);
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_char_constant) {
        n.type => type_checker.type_cache.builtin_i32;
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_array_access) {
        if (is_reference_kind(n.AST_array_access.array.type))
            insert_dereference(type_checker, n.AST_array_access.array);

        if (is_array_kind(n.AST_array_access.array.type)) {
            n.type => get_ref_type_for(type_checker.type_cache, n.AST_array_access.array.type.T_array.element_type);    
        }
        else if (is_slice_kind(n.AST_array_access.array.type)) {
            n.type => get_ref_type_for(type_checker.type_cache, get_slice_element_type(n.AST_array_access.array.type));
        }
        else {
            type_checker_error(n,
                $"Invalid use of [] operator on something that is not an array or a slice. Have '{get_type_name_r(buf_1, n.AST_array_access.array.type)}'.\n");
        }


        if (!is_integer_kind(n.AST_array_access.index.type)) {
            type_checker_error(n,
                $"Invalid use of non integer type '{get_type_name_r(buf_1, n.AST_array_access.index.type)}' as an array index.\n");
        }
        
        n.addressable = true;
    }

    else if (n.kind == AST_node::AST_dereference) {
        if (!is_reference_kind(n.AST_dereference.body.type)) {
                type_checker_error(n,
                    $"Dereferencing something that is not a reference. Have '{get_type_name_r(buf_1, n.AST_dereference.body.type)}'.\n");
        } else {
            n.type => dereferenced_type(n.AST_dereference.body.type);
            n.addressable = true;
        }
    }

    else if (n.kind == AST_node::AST_reference) {
        if (!n.AST_reference.body.addressable) type_checker_error(n, "Can't take reference to something that is not addressable.\n");
        n.type => get_ref_type_for(type_checker.type_cache, n.AST_reference.body.type);
        n.addressable = false;
    }

    else if (n.kind == AST_node::AST_unary) {
        if (n.AST_unary.token_kind == TokenKind::TOK_exclam) {
            try_convert_to_type_if_necessary(type_checker, n.AST_unary.body, type_checker.type_cache.builtin_bool, "Argument of unary '!'");
            n.type => type_checker.type_cache.builtin_bool;
        }
        else if (n.AST_unary.token_kind == TokenKind::TOK_minus) {
            try_convert_to_type_if_necessary(type_checker, n.AST_unary.body, type_checker.type_cache.builtin_i64, "Argument of unary '-'");
            n.type => type_checker.type_cache.builtin_i64;
        }
        else NOT_IMPLEMENTED(__LOCATION__, $"Type checking unary operator {token_kind_printable(n.AST_unary.token_kind)}");
        n.addressable = false;
    }
    
    else if (n.kind == AST_node::AST_plus_plus) {
        let  original_type => n.AST_plus_plus.body.type;
        auto_dereference(type_checker, n.AST_plus_plus.body);
        if (is_slice_kind(n.AST_plus_plus.body.type)) {
            n.type => n.AST_plus_plus.body.type.T_struct.members[0].type;
        }
        else if (is_integer_kind(n.AST_plus_plus.body.type)) {
            n.type => n.AST_plus_plus.body.type;
        }
        else{
            type_checker_error(n, $"Operator '++' needs integer or slice type argument. Have '{get_type_name_r(buf_1, original_type)}'");
        }
        
    }

    else if (n.kind == AST_node::AST_minus_minus) {
        let  original_type => n.AST_minus_minus.body.type;
        auto_dereference(type_checker, n.AST_minus_minus.body);
        if (!is_integer_kind(n.AST_minus_minus.body.type)) {
            type_checker_error(n, $"Operator '--' needs integer type argument. Have '{get_type_name_r(buf_1, original_type)}'");
        }
        n.type => n.AST_minus_minus.body.type;
    }

    else if (n.kind == AST_node::AST_member_access) {
        ASSERT(n.AST_member_access.body.type, "Unresolved type encountered in member access.\n");
        let container => n.AST_member_access.body.type;
        if (sv_equal(n.AST_member_access.name, "sizeof")) {
            n.kind = AST_node::AST_array_len;
            n.AST_array_len.len = container.storage_size;
            n.addressable = false;
            n.type => type_checker.type_cache.builtin_i64;
        }
        else {

            if (is_reference_kind(container)) container => dereferenced_type(container);
            
            if (is_structlike_kind(container) || is_union_kind(container)) {
                let offset;
                let t => get_member_type_and_offset_by_name(type_checker.type_cache, container, &n.AST_member_access.name, &offset);
                if (!t) type_checker_error(n, $"Member '{n.AST_member_access.name}' not found in '{get_type_name_r(buf_1, container)}'.\n");

                if (!is_reference_kind(n.AST_member_access.body.type))
                    insert_take_reference(type_checker, n.AST_member_access.body);

                n.type => get_ref_type_for(type_checker.type_cache, t);
                n.AST_member_access.offset = offset;
                n.addressable = true;

                // We need to insert a dereference node now at this point in the tree.
                // copy the current node to a new one:
                let ast_member_access => ast_alloc(type_checker.ast_allocator, AST_node::AST_member_access, n.location);
                objcopy~AST_node(ast_member_access, n);
                ast_member_access.next => null; // clear next pointer in case it was used

                // Now we overwrite the current node, making it the dereference node with the member acces in it's body
                n.kind = AST_node::AST_dereference;
                n.AST_dereference.body => ast_member_access;
                n.type => dereferenced_type(ast_member_access.type);
            }
            else if (is_array_kind(container)) {
                if(sv_equal(n.AST_member_access.name, "len")) {
                    n.kind = AST_node::AST_array_len;
                    n.AST_array_len.len = container.T_array.n_elements;
                    n.addressable = false;
                    n.type => type_checker.type_cache.builtin_i64;
                }
                else {
                    type_checker_error(n, $"Tried to access non existent member '{n.AST_member_access.name}' on array type. Arrays only have the member 'len' available.\n");
                }
            }
            else if (is_enum_kind(container) || is_enumerator_kind(container)) {
                if(sv_equal(n.AST_member_access.name, "name")) {
                    n.addressable = false;
                    n.type => get_slice_type (type_checker.type_cache, type_checker.type_cache.builtin_u8);
                }
                else {
                    type_checker_error(n, $"Tried to access non existent member '{n.AST_member_access.name}' on enum type. Enums only have the member 'name' available.\n");
                }
            }
            else {
                type_checker_error(n, $"Tried to access a member in something that can't have members. Have '{get_type_name_r(buf_1, container)}'.\n");
            }

        }
    }

    else if (n.kind == AST_node::AST_namespace_access) {
        let t => n.AST_namespace_access.body.type;
        if (t.kind == Type::T_enum) {
            if (!get_enum_member_value (t, n.AST_namespace_access.name, &n.AST_namespace_access.enum_value))
            {
                type_checker_error(n, $"Member '{n.AST_namespace_access.name}' not found in '{get_type_name_r(buf_1, t)}'.\n");
            }
            n.type => t;
            n.addressable = false;
        }
        else if (t.kind == Type::T_union) {
            if (!get_union_member_value (t, &n.AST_namespace_access.name, &n.AST_namespace_access.enum_value))
            {
                type_checker_error(n, $"Member '{n.AST_namespace_access.name}' not found in '{get_type_name_r(buf_1, t)}'.\n");
            }
            n.type => get_enumerator_type_for(type_checker.type_cache, t);
            n.addressable = false;
        }
        else NOT_IMPLEMENTED(__LOCATION__, $"Namespace access is for typ {get_type_name_r(buf_1, t)}.\n");
    }

    else if (n.kind == AST_node::AST_variadic_operator) {
        type_check_variadic_operator(type_checker, n);
    }

    else if (n.kind == AST_node::AST_builder_string) {
        type_check_builder_string(type_checker, n);
        n.type => get_slice_type(type_checker.type_cache, type_checker.type_cache.builtin_u8);
    }

    else if (n.kind == AST_node::AST_null) {
        n.type => type_checker.type_cache.builtin_null;
    }

    else if (n.kind == AST_node::AST_generic) {
        n.type => type_checker.type_cache.builtin_void;
    }

    else if (n.kind == AST_node::AST_generic_speciation) {
        n.type => n.AST_generic_speciation.body.type;
    }
            
    else if (n.kind == AST_node::AST_generic_implementation) {
        // already handled
    }

    else if (n.kind == AST_node::AST_typename
                    |== AST_node::AST_member_def
                    |== AST_node::AST_union_member_def
                    |== AST_node::AST_struct
                    |== AST_node::AST_union
                    |== AST_node::AST_enum
                    |== AST_node::AST_enum_member
                    |== AST_node::AST_type_ref
                    |== AST_node::AST_type_array
                    |== AST_node::AST_type_slice
                    |== AST_node::AST_function_type
                    |== AST_node::AST_type_generic_speciation)
    {
        // already filled in by type resolver
    }
    else if (n.kind == AST_node::AST_arg_list
                    |== AST_node::AST_program
                    |== AST_node::AST_scope)
    {
        // these have void type
        n.type => type_checker.type_cache.builtin_void;
    }
    else {
        NOT_IMPLEMENTED(__LOCATION__, "Type checking {n.kind}");
    }

    ASSERT(n.type, $"All nodes should have a type after the type checker. Have {n.kind.name} with null type.\n");
}

fn type_checker_run(type_checker: TypeChecker&, root: AST_node&) {
    annotate_used_visitor(root, type_checker);
    type_resolve_functions_visitor(root, type_checker);

    ast_dump_tree(root);

    type_propagation_visitor(root, type_checker);
}

fn type_checker_init(type_checker: TypeChecker&, symbol_cache: SymbolCache&, ast_allocator: AST_Node_Allocator&, endlos: EndlosAllocator&) {
    type_checker.type_cache => symbol_cache.type_cache;
    type_checker.symbol_cache => symbol_cache;
    type_checker.ast_allocator => ast_allocator;
    type_checker.endlos => endlos;
}
