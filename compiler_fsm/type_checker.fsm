
import * from "std";
import * from "endlos";
import * from "type";
import * from "ast";


fn type_checker_error(n: AST_node&, s: u8[]) {
    write(2, $"[FSM Type Checker] {n.location} Error: {s}\n");
    exit(1);
}

fn type_checker_warning(n: AST_node&, s: u8[]) {
    write(2, $"[FSM Type Checker] {n.location} Warning: {s}\n");
}

struct TypeChecker {
    type_cache: TypeCache&;
    ast_allocator: AST_Node_Allocator&;
    endlos: EndlosAllocator&;
    used: bool;
    current_function_symbol: Symbol&;
    current_function_ret_type_decl: Type&;
    current_function_ret_type: Type&;
    arg_symbols: EndlosArr<Symbol&>;
    generic_type: Type&;
    program: AST_node&;
}

fn annotate_used_visitor(n: AST_node&, type_checker: TypeChecker&) {
    if (!n) return;
    n.result_used = type_checker.used;

    if (n.kind == AST_node::AST_scope) {
        if (type_checker.used) type_checker_error(n, "Using the result of a scope is not implemented yet.\n");
        type_checker.used = false;
        ast_visit_children(n, annotate_used_visitor, type_checker);
    }
    else if (n.kind == AST_node::AST_var_decl
                    |== AST_node::AST_call
    ) {
        ast_visit_children(n, annotate_used_visitor, type_checker);
    }
    else if (n.kind == AST_node::AST_return) {
        if (type_checker.used) type_checker_error(n, "The 'return' statement has no value and therefore can't be used in an expression.\n");
        ast_visit_children(n, annotate_used_visitor, type_checker);
    }
    else if (n.kind == AST_node::AST_if) {
        type_checker.used = true;
        annotate_used_visitor(n._if.condition, type_checker);
        type_checker.used = n.result_used;
        annotate_used_visitor(n._if.if_clause, type_checker);
        annotate_used_visitor(n._if.else_clause, type_checker);
    }
    else if (n.kind == AST_node::AST_while) {
        if (type_checker.used) type_checker_error(n, "The 'while' statement has no value and therefore can't be used in an expression.\n");
        type_checker.used = true;
        annotate_used_visitor(n._while.condition, type_checker);
        type_checker.used = false;
        annotate_used_visitor(n._while.body, type_checker);
    }
    else if (n.kind == AST_node::AST_for) {
        type_checker.used = false;
        annotate_used_visitor(n._for.initializer, type_checker);
        type_checker.used = true;
        annotate_used_visitor(n._for.condition, type_checker);
        type_checker.used = false;
        annotate_used_visitor(n._for.post_action, type_checker);
        annotate_used_visitor(n._for.body, type_checker);
    }
    else if (n.kind == AST_node::AST_binary) {
        if (n.binary.token_kind == TokenKind::TOK_equal_assign) {
            type_checker.used = true;
            ast_visit_children(n, annotate_used_visitor, type_checker);
        }
        else if (n.binary.token_kind == TokenKind::TOK_boolean_and || n.binary.token_kind == TokenKind::TOK_boolean_or) {
            type_checker.used = true;
            annotate_used_visitor(n.binary.left, type_checker);
            type_checker.used = n.result_used;
            annotate_used_visitor(n.binary.right, type_checker);
        }
        else {
            ast_visit_children(n, annotate_used_visitor, type_checker);
        }
    }
    else if (n.kind == AST_node::AST_builder_string) {
        // unused builder string implies handing it to 'puts'
        if (!type_checker.used) {
            let ast_call => ast_alloc(type_checker.ast_allocator, AST_node::AST_call, n.location);
            let ast_symbol => ast_alloc(type_checker.ast_allocator, AST_node::AST_symbol, n.location);
            ast_symbol.symbol.name = "puts";
            ast_symbol.symbol.symbol = get_symbol_by_name(type_checker.type_cache.builtin_functions, "puts");
            ast_call.call.target = ast_symbol;
            ast_insert_node(n, ast_call);
            type_checker.used = true;
            ast_visit_children(n, annotate_used_visitor, type_checker);    
        }
    }
    else {
        ast_visit_children(n, annotate_used_visitor, type_checker);
    }

    type_checker.used = n.result_used;
}


fn insert_dereference(type_checker: TypeChecker&, n: AST_node&) {
    ASSERT (is_reference_kind(n.type), "Trying to insert dereference for something that is not a reference.\n")
    let deref => ast_alloc(type_checker.ast_allocator, AST_node::AST_dereference, n.location);
    deref.type => dereferenced_type(n.type);
    deref.addressable = true;
    ast_insert_node(n, deref);
}

fn auto_dereference(type_checker: TypeChecker&, n: AST_node&) {
    if (!is_reference_kind(n.type)) return;
    insert_dereference(n);
}

fn insert_take_reference(type_checker: TypeChecker&, n: AST_node&) {
    NOT_IMPLEMENTED(__LOCATION__, "insert_take_reference");
    /*
    let ref => ast_alloc(type_checker.ast_allocator, AST_node::AST_reference, n.location);
    ref.type = get_ref_type_for(n.type);
    ref.addressable = false;
    ast_insert_node(n, ref);
    */
}

fn check_function_argument_compatible(type_checker: TypeChecker&, arg_1: Type&, arg_2: Type&) : bool {
    return arg_1 == arg_2
        || (is_reference_kind(arg_1) && is_reference_kind(arg_2)
             && (dereferenced_type(arg_1) == type_checker.type_cache.builtin_any
                  || dereferenced_type(arg_2) == type_checker.type_cache.builtin_any) );
}

fn check_function_refs_compatible (type_checker: TypeChecker&, fn_ref_1: Type&, fn_ref_2: Type&) : bool {
    if (is_function_reference(fn_ref_1) && is_function_reference(fn_ref_2)) {
        let fn_1 => dereferenced_type(fn_ref_1);
        let fn_2 => dereferenced_type(fn_ref_2);
        if (fn_1.fun.num_arguments == fn_2.fun.num_arguments
            && check_function_argument_compatible(fn_1.fun.return_type, fn_2.fun.return_type))
        {
            for (let i = 0; i < fn_2.fun.num_arguments; i++) {
                if (!check_function_argument_compatible(fn_1.fun.argument_types[i], fn_2.fun.argument_types[i])) {
                    return false;
                }
            }
            return true;
        }
    }
    return false;
}

fn make_cast(to: Type&, from: Type&, allocator: AST_Node_Allocator&) : AST_node& {
    ASSERT(is_castable_to(to, from), "make_cast() should only be called if the cast is possible.\n");
    
    let loc: Location; // 'location' will be filled in when the cast is inserted.
    let n => ast_alloc(allocator, AST_node::AST_cast, loc);
    n.type = to;
    n.AST_cast.right_type = from;

    return n;
}

fn try_convert_to_type_if_necessary(type_checker: TypeChecker&, n: AST_node&, target_type: Type&, desc: u8[]) {

    let original_type => n.type;

    if (target_type == original_type) return;

    if (target_type == type_checker.type_cache.builtin_bool && is_reference_kind(original_type)) {
        if (dereferenced_type(original_type) == type_checker.type_cache.builtin_bool) {
            type_checker_warning(n.line_number,
                "Using 'bool&' in boolean context will dereference the target and not perform a null reference check. "
                "Suggest to either dereference, when the value is what you want, or to write '... != null' if you wanted "
                "to perform a null reference check.");
        }
        else {
            ast_insert_node(n, make_cast(type_checker.type_cache.builtin_bool, original_type));
            return;
        }
    }

    if (!is_reference_kind(target_type) && is_reference_kind(original_type)) {
        insert_dereference(n);
    }
    
    if (is_slice_type(target_type) && is_array_kind(n.type)) {
        if (get_slice_element_type(target_type) == n.type._array.element_type) {
            let conv => ast_alloc(type_checker.ast_allocator, AST_node::AST_array_to_slice, n.location);
            conv.type = get_sclice_type(n.type._array.element_type);
            ast_insert_node(n, conv);
            return;
        }
        else {
            type_checker_error(n, $"Can't convert {desc} of type '%s' to '%s'.\n");
                // get_type_name_r(buf_1, original_type), get_type_name_r(buf_2, target_type));
        }
    }

    if ((target_type == type_checker.type_cache.builtin_u8_slice) && (
            (is_struct_kind(n.type) && !is_slice_type(n.type))
            || is_record_kind(n.type)
            || is_union_kind(n.type)))
    {
        ast_insert_node(n, make_cast(target_type, n.type));
        return;
    }

    if (is_reference_kind(target_type) && original_type == type_checker.type_cache.builtin_null) return;

    if (target_type == get_ref_type_for(type_checker.type_cache.builtin_any)) {
        if (!is_reference_kind(original_type)) {
            if (n.addressable == false) type_checker_error(n, $"Can't convert {desc} of type '%s' to '%s' because it is not addressable.\n");
                    // desc, get_type_name_r(buf_1, original_type), get_type_name_r(buf_2, target_type));
            
            insert_take_reference(n);
        }
        return; // any& can accept any reference type.
    }

    if (is_reference_kind(target_type) && !is_reference_kind(original_type)) {
        if (n.addressable == false) type_checker_error(n, $"Can't convert {desc} of type '%s' to '%s' because it is not addressable.\n");
               // desc, get_type_name_r(buf_1, original_type), get_type_name_r(buf_2, target_type));
        insert_take_reference(n);
    }

    if (n.type == target_type) return;

    if (is_integer_kind(target_type) && (is_enum_kind(n.type) || is_enumerator_kind(n.type))) return;
    if ((is_enum_kind(target_type) || is_enumerator_kind(target_type)) && is_integer_kind(n.type)) return;


    if (are_compatible_function_refs(target_type, n.type))
        return;


    let warning: u8[];
    if (is_castable_to(target_type, n.type, &warning)) {
        ast_insert_node(n, make_cast(target_type, n.type));
        if (warning.len) type_checker_warning(n.line_number, warning);
    }
    else {
        type_checker_error(n, $"Can't convert {desc} of type '%s' to '%s'.\n",
            desc, get_type_name_r(buf_1, original_type), get_type_name_r(buf_2, target_type));
    }
}

fn type_propagate_binary_operator(type_checker: TypeChecker&, n: AST_node&) {
    char buf_1[1024];
    char buf_2[1024];
    TokenKind tk = n.binary.token_kind;

    if (tk == TokenKind::TOK_bind_ref) {
        if (!is_reference_kind(n.binary.left.type)) {
            type_checker_error(n, "Operator %s requires a reference type on the left side. Have '%s' and '%s'.\n",
                token_kind_printable(tk), get_type_name_r(buf_1, n.binary.left.type), get_type_name_r(buf_2, n.binary.right.type));
        }

        if (n.binary.right.type == type_checker.type_cache.builtin_null) {
        }
        else
        {
            if (!is_reference_kind(n.binary.right.type)) {
                if (!n.binary.right.addressable) type_checker_error(n, "Operator %s requires either another reference or something addressable on the right side. Have '%s' and '%s'.\n",
                    token_kind_printable(tk), get_type_name_r(buf_1, n.binary.left.type), get_type_name_r(buf_2, n.binary.right.type));
                insert_take_reference(n.binary.right);
            }

            Type *any_ref = get_ref_type_for(type_checker.type_cache.builtin_any);

            if (n.binary.left.type != n.binary.right.type && n.binary.left.type != any_ref && n.binary.right.type != any_ref) {
                type_checker_error(n, "Operator %s requires the type on the right side to be referenceable by the left type. Have '%s' and '%s'.\n",
                    token_kind_printable(tk), get_type_name_r(buf_1, n.binary.left.type), get_type_name_r(buf_2, n.binary.right.type));
            }
        }
        
        n.type => n.binary.right.type;
    }
    else {
        SB sb_left; sb_init (&sb_left, buf_1, 1024);
        SB sb_right; sb_init (&sb_right, buf_2, 1024);

        sb_printf(&sb_left, "left argument of binary operator %s", token_kind_printable(tk));
        sb_printf(&sb_right, "right argument of binary operator %s", token_kind_printable(tk));

        if (tk == TokenKind::TOK_plus
                    |== TokenKind::TOK_minus
                    |== TokenKind::TOK_asterisk
                    |== TokenKind::TOK_slash
                    |== TokenKind::TOK_percent
                    |== TokenKind::TOK_up_arrow)
        {
            try_convert_to_type_if_necessary(n.binary.left, type_checker.type_cache.builtin_i64, sb_left.buffer);
            try_convert_to_type_if_necessary(n.binary.right, type_checker.type_cache.builtin_i64, sb_right.buffer);

            n.type => type_checker.type_cache.builtin_i64;
        }

        else if (tk == TokenKind::TOK_greater
                   |== TokenKind::TOK_lower
                   |== TokenKind::TOK_greater_equal
                   |== TokenKind::TOK_lower_equal)
        {
            try_convert_to_type_if_necessary(n.binary.left, type_checker.type_cache.builtin_i64, sb_left.buffer);
            try_convert_to_type_if_necessary(n.binary.right, type_checker.type_cache.builtin_i64, sb_right.buffer);

            n.type => type_checker.type_cache.builtin_bool;
        }
        
        else if (tk == TokenKind::TOK_boolean_and
                   |== TokenKind::TOK_boolean_or) {
            try_convert_to_type_if_necessary(n.binary.left, type_checker.type_cache.builtin_bool, sb_left.buffer);
            try_convert_to_type_if_necessary(n.binary.right, type_checker.type_cache.builtin_bool, sb_right.buffer);
            n.type => type_checker.type_cache.builtin_bool;            
        }
        
        else if (tk == TokenKind::TOK_equal
                   |== TokenKind::TOK_unequal) {
            auto_dereference(n.binary.left);
            auto_dereference(n.binary.right);
            let okay = n.binary.left.type == n.binary.right.type || (is_integer_kind(n.binary.left.type) && is_integer_kind(n.binary.right.type));
            if (!okay) {
                type_checker_error(n, "Operator %s can't accept arguments with different types. Have '%s' and '%s'.\n",
                    token_kind_printable(tk), get_type_name_r(buf_1, n.binary.left.type), get_type_name_r(buf_2, n.binary.right.type));
            }
            n.type => type_checker.type_cache.builtin_bool;
        }

        else if (tk == TokenKind::TOK_equal_assign) {
            auto_dereference(n.binary.left);
            auto_dereference(n.binary.right);
            try_convert_to_type_if_necessary(n.binary.right, n.binary.left.type, "Argument of operator '='");
            n.type => n.binary.right.type;
        }

        else {
            NOT_IMPLEMENTED("Type checking binary operator of kind %s is not implemented yet.\n", token_kind_name(n.binary.token_kind));
        }
    }
}

fn type_check_variadic_operator (type_checker: TypeChecker&, n: AST_node&){
    switch (n.variadic_operator.members[0].token_kind) {
        if (tk == TokenKind::TOK_greater
              |== TokenKind::TOK_lower
              |== TokenKind::TOK_greater_equal
              |== TokenKind::TOK_lower_equal)
        {
            for (let i = 0; i < n.variadic_operator.num_members; i++) {
                try_convert_to_type_if_necessary(n.variadic_operator.left, type_checker.type_cache.builtin_i64, "Argument of variadic operator");
                try_convert_to_type_if_necessary(n.variadic_operator.members[i].right, type_checker.type_cache.builtin_i64, "Argument of variadic operator");                
            }
            n.type => type_checker.type_cache.builtin_bool;
            n.addressable = false;
        }
        
        else if (tk == TokenKind::TOK_equal
                   |== TokenKind::TOK_unequal)
        {
            auto_dereference(n.variadic_operator.left);
            
            Type *left_type = n.variadic_operator.left.type;
            bool all_same_type = true;
            bool all_integer = is_integer_kind(left_type);

            for (let i = 0; i < n.variadic_operator.num_members; i++) {
                auto_dereference(n.variadic_operator.members[i].right);
                if (left_type != n.variadic_operator.members[i].right.type) all_same_type = false;
                if (!is_integer_kind(n.variadic_operator.members[i].right.type)) all_integer = false;
            }

            if (!all_same_type && !all_integer) {
                type_checker_error(n, "Chained operator %s can't accept arguments with different types.",
                    token_kind_printable(n.variadic_operator.members[0].token_kind));
            }
            n.type => type_checker.type_cache.builtin_bool;
            n.addressable = false;
        }
        else { NOT_IMPLEMENTED("Type checking variadic operator %s is not implemented yet.",
            token_kind_printable(n.variadic_operator.members[0].token_kind))
        }
    }
}

fn type_check_builder_string(b_str: AST_node&) {
    for (let n => b_str.builder_string.body; n; n = n.next) {
        auto_dereference(n);
        if (is_integer_kind(n.type)
            || n.type == type_checker.type_cache.builtin_u8_slice
            || is_record_kind(n.type)
            || is_struct_kind(n.type))
        {
        }
        else {
            try_convert_to_type_if_necessary(n, type_checker.type_cache.builtin_i64, "Argument of builder string");
        }
    }
}

fn type_check_function_call(type_checker: TypeChecker&, n: AST_node&_call, type_checker: TypeChecker&) {
    char buf[1024];
    Type *fn_type = n_call.call.target.type;
    if (is_reference_kind(fn_type)) fn_type => dereferenced_type(fn_type);

    if (!is_function_kind(fn_type)) type_checker_error(n_call.line_number,
            "Trying to call something that is not a function. have '%s'", get_type_name_r(buf, n_call.call.target.type));

    let num_args_expected = fn_type.fun.num_arguments;
    let num_args = ast_count_chain(n_call.call.args);

    if (num_args < num_args_expected) type_checker_error(n_call.line_number,
            "Not enough arguments to function call. Expected %d, got %d.\n", num_args_expected, num_args);
    
    if (num_args > num_args_expected) type_checker_error(n_call.line_number,
            "Too many arguments to function call. Expected %d, got %d.\n", num_args_expected, num_args);

    let arg = n_call.call.args;
    for (let i = 0; i < num_args; i++) {
        Type *expected_type = fn_type.fun.argument_types[i];

        try_convert_to_type_if_necessary(arg, expected_type, "Function argument");
        arg = arg.next;
    }
    
    n_call.type = fn_type.fun.return_type;
    if (!n_call.type) type_checker_error(n_call.line_number,
        "Trying to call function that doesn't have a resolved return type yet. "
        "Please define the function's return type when it's definition follows the call.\n");
}

fn update_current_function_type(type_checker: TypeChecker&) {
    // Check ret type changed during function type propagating
    if (type_checker.current_function_symbol.type &&
        type_checker.current_function_symbol.type.fun.return_type != type_checker.current_function_ret_type)
    {
        // yes: update function symbol with proper type
        type_checker.current_function_symbol.type =
            get_function_type(type_checker.current_function_ret_type,
                type_checker.current_function_symbol.type.fun.argument_types,
                type_checker.current_function_symbol.type.fun.num_arguments);
    }
}

fn type_resolve_functions_visitor(type_checker: TypeChecker&, n: AST_node&, type_checker: TypeChecker&) {
    if (n.kind == AST_node::AST_function) {
        type_checker.current_function_symbol = n.fun.symbol;
        type_checker.current_function_ret_type_decl = nullptr;
        type_checker.current_function_ret_type = nullptr;

        if (n.fun.ret_typedecl) {
            type_resolve_functions_visitor(n.fun.ret_typedecl, type_checker);
            type_checker.current_function_ret_type = n.fun.ret_typedecl.type;
            type_checker.current_function_ret_type_decl = n.fun.ret_typedecl.type;
        }
        
        if (n.fun.args) type_resolve_functions_visitor(n.fun.args, type_checker);

        type_checker.current_function_symbol = nullptr;
        type_checker.current_function_ret_type = nullptr;
        type_checker.current_function_ret_type_decl = nullptr;
    }
    else if (n.kind == AST_node::AST_arg_list) {
        let s_fun = type_checker.current_function_symbol;
        ASSERT(s_fun, "Encountered arglist without active function symbol.\n");
        EndlosArr_begin~Symbol&(type_checker.arg_symbols, type_checker.endlos);

        // visiting the children of the arg list will fill up 'arg_symbols'
        ast_visit_children(n, type_resolve_functions_visitor, type_checker);


        let arg_types = endlos_begin~Type&(type_checker.endlos);

        for (let i = 0; i < type_checker.arg_symbols.arr.len; i++) {
            arg_types++ => get_symbol(&type_checker.arg_symbols, i).type;
        }

        arg_types = endlos_ripp_off~Type&(type_checker.endlos, arg_types);

        type_checker.current_function_symbol.type =
            get_function_type(type_checker.current_function_ret_type, arg_types);
    }
    else if (n.kind == AST_node::AST_arg_decl) {
        let t = if (n.arg_decl._typedecl)
            n.arg_decl._typedecl.type
        else
            type_checker.type_cache.builtin_i64

        n.arg_decl.symbol.type = t;
        dyn_array_push_p(&type_checker.arg_symbols, n.arg_decl.symbol);
        n.type => type_checker.type_cache.builtin_void; // the declaration itself has no value.
    }
    else {
        ast_visit_children(n, type_resolve_functions_visitor, type_checker);
    }
}

