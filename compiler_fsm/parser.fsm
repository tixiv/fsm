
import * from "std";
import * from "endlos";
import * from "tokenizer";
import * from "common";
import * from "compiler_fsm/ast";

struct Parser {
    tokens: Token[];
    CT: Token&;
    allocator: AST_Node_Allocator&;
    endlos: EndlosAllocator&;
    error_handler: ErrorHandler<Location&>&;
}

fn parser_error(parser: Parser&, message: u8[]) {
    let eh =>  parser.error_handler;
    eh.handler("[FSM Parser]", parser.CT.location, message, eh.arg)
}

fn make_location_string(parser: Parser&) : u8[] {
    let l = parser.CT.location;
    let sb: StringBuilder;
    sb_init(sb, endlos_begin~u8(parser.endlos));
    sb_puts(sb, $"{l.module.filename}:{l.line}")
    return endlos_ripp_off~u8(parser.endlos, sb.buffer);
}

fn MOVE_NEXT(parser: Parser&) {
    if (parser.tokens.len > 1) {
        parser.CT => ++parser.tokens;
    }
}

fn expect_token(parser: Parser&, tok: TokenKind) {
    if (parser.CT.kind != tok) {
        parser_error(parser, $"Expected {tok.name} but got {parser.CT.kind.name}");
    }
}

fn take_expected(parser: Parser&, tok: TokenKind) {
    expect_token(parser, tok);
    MOVE_NEXT(parser);
}

fn link_arr(parent: AST_node&, child: AST_node&) {
    
         if (parent.kind == AST_node::AST_type_array) parent.AST_type_array.body => child
    else if (parent.kind == AST_node::AST_type_slice) parent.AST_type_slice.body => child
    else NOT_IMPLEMENTED(__LOCATION__, $"Linking to {parent.kind.name}");
}

fn parse_typedecl_postifx(parser: Parser&, inner: AST_node&) : AST_node& {
    if (parser.CT.kind == TokenKind::TOK_ampersand) {
        let ast_ref => ast_alloc(parser.allocator, AST_node::AST_type_ref, parser.CT.location);
        MOVE_NEXT(parser);
        ast_ref.AST_type_ref.body => inner;
        return parse_typedecl_postifx(parser, ast_ref);
    } else if (parser.CT.kind == TokenKind::TOK_lbracket) {
        
        let first: AST_node& => null;
        let latest: AST_node& => null;

        while (parser.CT.kind == TokenKind::TOK_lbracket) {
            let location => parser.CT.location;
            MOVE_NEXT(parser);
            if (parser.CT.kind == TokenKind::TOK_number) {
                let ast_array => ast_alloc(parser.allocator, AST_node::AST_type_array, location);
                ast_array.AST_type_array.n_elements = parse_integer(parser.CT.value);
                MOVE_NEXT(parser);
                take_expected(parser, TokenKind::TOK_rbracket);

                if (!first) {
                    first => ast_array;
                }
                if (latest) {
                    link_arr(latest, ast_array);
                }
                latest => ast_array;
            }
            else if (parser.CT.kind == TokenKind::TOK_rbracket) {
                let ast_slice => ast_alloc(parser.allocator, AST_node::AST_type_slice, location);
                take_expected(parser, TokenKind::TOK_rbracket);

                if (!first) {
                    first => ast_slice;
                }
                if (latest) {
                    link_arr(latest, ast_slice);
                }
                latest => ast_slice;
            }
            else {
                parser_error(parser, "Expected array size or ']'.\n");
            }
        }
        
        link_arr(latest, inner);
        return parse_typedecl_postifx(parser, first);
    }
    return inner;
}

fn parse_typedecl(parser: Parser&) : AST_node& {
    if (parser.CT.kind == TokenKind::TOK_keyword_fn) {
        let ast_fn_type => ast_alloc(parser.allocator, AST_node::AST_function_type, parser.CT.location);
        MOVE_NEXT(parser);

        take_expected(parser, TokenKind::TOK_lparen);

        while (parser.CT.kind != TokenKind::TOK_rparen) {
            let arg => parse_typedecl(parser);
            if (!arg) parser_error(parser, $"Expected function argument type or ')' but have {parser.CT.kind.name}");

            ast_link_to_chain(&ast_fn_type.AST_function_type.function_args, arg);
            if (parser.CT.kind == TokenKind::TOK_komma){
                MOVE_NEXT(parser);
            }
            else if (parser.CT.kind == TokenKind::TOK_rparen){
            }
            else {
                parser_error(parser, $"Expected ',' or ')' but have {parser.CT.kind.name}");
            }
        }
        MOVE_NEXT(parser);

        take_expected(parser, TokenKind::TOK_colon);

        ast_fn_type.AST_function_type.function_ret => parse_typedecl(parser);
        return ast_fn_type;
    }
    else if (parser.CT.kind == TokenKind::TOK_identifier) {
        let ast_typename => ast_alloc(parser.allocator, AST_node::AST_typename, parser.CT.location);
        ast_typename.AST_typename.name = parser.CT.value;
        MOVE_NEXT(parser);
        if (parser.CT.kind == TokenKind::TOK_lower) {
            let ast_speciation => ast_alloc(parser.allocator, AST_node::AST_type_generic_speciation, parser.CT.location);
            MOVE_NEXT(parser);
            ast_speciation.AST_type_generic_speciation.body => ast_typename;
            ast_speciation.AST_type_generic_speciation.typedecl => parse_typedecl(parser);
            take_expected(parser, TokenKind::TOK_greater);
            return parse_typedecl_postifx(parser, ast_speciation);
        }
        else {
            return parse_typedecl_postifx(parser, ast_typename);
        }
    }
    
    return null;
}

fn try_parse_typedecl(parser: Parser&) : AST_node& {
    if(parser.CT.kind == TokenKind::TOK_colon) {
        MOVE_NEXT(parser);
        let n => parse_typedecl(parser);
        if (!n)
            parser_error(parser, $"Expected typename but have {parser.CT.kind.name}");
        return n;
    }
    return null;
}

fn parse_if(parser: Parser&) :AST_node& {
    let n => ast_alloc(parser.allocator, AST_node::AST_if, parser.CT.location);
    MOVE_NEXT(parser);

    if (parser.CT.kind != TokenKind::TOK_lparen) {
        parser_error(parser, $"Expected '(' but got {parser.CT.kind.name}");
    }
    MOVE_NEXT(parser);

    n.AST_if.condition => parse_expression(parser);

    if (parser.CT.kind != TokenKind::TOK_rparen) {
        parser_error(parser, $"Expected ')' but got {parser.CT.kind.name}");
    }
    MOVE_NEXT(parser);

    n.AST_if.if_clause => parse_statement(parser);

    if (parser.CT.kind == TokenKind::TOK_keyword_else) {
        MOVE_NEXT(parser);

        n.AST_if.else_clause => parse_statement(parser);
    }

    return n;
}

fn parse_while(parser: Parser&) :AST_node& {
    let n => ast_alloc(parser.allocator, AST_node::AST_while, parser.CT.location);
    MOVE_NEXT(parser);

    if (parser.CT.kind != TokenKind::TOK_lparen) {
        parser_error(parser, $"Expected '(' but got {parser.CT.kind.name}");
    }
    MOVE_NEXT(parser);

    n.AST_while.condition => parse_expression(parser);

    if (parser.CT.kind != TokenKind::TOK_rparen) {
        parser_error(parser, $"Expected ')' but got {parser.CT.kind.name}");
    }
    MOVE_NEXT(parser);

    n.AST_while.body => parse_statement(parser);

    return n;
}

fn parse_for(parser: Parser&) :AST_node& {
    let n => ast_alloc(parser.allocator, AST_node::AST_for, parser.CT.location);
    MOVE_NEXT(parser);

    take_expected(parser, TokenKind::TOK_lparen);
    if (parser.CT.kind != TokenKind::TOK_semicolon) n.AST_for.initializer => parse_statement(parser);
    take_expected(parser, TokenKind::TOK_semicolon);
    if (parser.CT.kind != TokenKind::TOK_semicolon) n.AST_for.condition => parse_expression(parser);
    take_expected(parser, TokenKind::TOK_semicolon);
    if (parser.CT.kind != TokenKind::TOK_rparen) n.AST_for.post_action => parse_statement(parser);
    if (parser.CT.kind == TokenKind::TOK_semicolon) {
        MOVE_NEXT(parser);
        n.AST_for.result => parse_expression(parser);
    }
    take_expected(parser, TokenKind::TOK_rparen);
    n.AST_for.body => parse_statement(parser);

    return n;
}

fn parse_builder_string(parser: Parser&) : AST_node& {
    let builder => ast_alloc(parser.allocator, AST_node::AST_builder_string, parser.CT.location);

    builder.AST_builder_string.var_decl_sb => ast_alloc(parser.allocator, AST_node::AST_var_decl, parser.CT.location);
    builder.AST_builder_string.var_decl_sb.AST_var_decl._typedecl => ast_alloc(parser.allocator, AST_node::AST_typename, parser.CT.location);
    builder.AST_builder_string.var_decl_sb.AST_var_decl._typedecl.AST_typename.name = "StringBuilder";

    builder.AST_builder_string.var_decl_arr => ast_alloc(parser.allocator, AST_node::AST_var_decl, parser.CT.location);
    builder.AST_builder_string.var_decl_arr.AST_var_decl._typedecl => ast_alloc(parser.allocator, AST_node::AST_type_array, parser.CT.location);
    builder.AST_builder_string.var_decl_arr.AST_var_decl._typedecl.AST_type_array.n_elements = 1024;
    builder.AST_builder_string.var_decl_arr.AST_var_decl._typedecl.AST_type_array.body => ast_alloc(parser.allocator, AST_node::AST_typename, parser.CT.location);
    builder.AST_builder_string.var_decl_arr.AST_var_decl._typedecl.AST_type_array.body.AST_typename.name = "u8";

    MOVE_NEXT(parser);

    while (parser.CT.kind != TokenKind::TOK_builder_string_end) {
        if (parser.CT.kind == TokenKind::TOK_string) {
            let ast_str => ast_alloc(parser.allocator, AST_node::AST_string, parser.CT.location);
            ast_str.AST_string.value = parser.CT.value;
            ast_link_to_chain(&builder.AST_builder_string.body, ast_str);
            MOVE_NEXT(parser);
        } else {
            ast_link_to_chain(&builder.AST_builder_string.body, parse_expression(parser));
        }
    }
    MOVE_NEXT(parser);
    return builder;
}

fn parse_call_arguments(parser: Parser&) : AST_node& {
    MOVE_NEXT(parser);

    let first: AST_node& => null;
    let last: AST_node& => null;

    while (parser.CT.kind != TokenKind::TOK_rparen) {
        first => parse_expression(parser);
        last => first;

        while (parser.CT.kind == TokenKind::TOK_komma) {
            MOVE_NEXT(parser);
            let n=> parse_expression(parser); 
            last.next => n;
            last => n;
        }
    }
    MOVE_NEXT(parser);

    return first;
}

fn parse_postfix_operators(parser: Parser&, n: AST_node&) : AST_node& {
    if (parser.CT.kind == TokenKind::TOK_plus_plus) {
        let plus_plus => ast_alloc(parser.allocator, AST_node::AST_plus_plus, parser.CT.location);
        plus_plus.AST_plus_plus.body => n;
        plus_plus.AST_plus_plus.postfix = true;
        MOVE_NEXT(parser);
        return plus_plus;
    }
    else if (parser.CT.kind == TokenKind::TOK_minus_minus) {
        let minus_minus => ast_alloc(parser.allocator, AST_node::AST_minus_minus, parser.CT.location);
        minus_minus.AST_minus_minus.body => n;
        minus_minus.AST_minus_minus.postfix = true;
        MOVE_NEXT(parser);
        return minus_minus;
    }
    return n;
}

fn parse_primary(parser: Parser&) : AST_node&
{
    let n: AST_node& => null;

    if (parser.CT.kind == TokenKind::TOK_number) {
        n => ast_alloc(parser.allocator, AST_node::AST_number, parser.CT.location);
        n.AST_number.value = parser.CT.value;
        MOVE_NEXT(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_true) {
        n => ast_alloc(parser.allocator, AST_node::AST_bool, parser.CT.location);
        n.AST_bool.value = true;
        MOVE_NEXT(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_false) {
        n => ast_alloc(parser.allocator, AST_node::AST_bool, parser.CT.location);
        n.AST_bool.value = false;
        MOVE_NEXT(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_null) {
        n => ast_alloc(parser.allocator, AST_node::AST_null, parser.CT.location);
        MOVE_NEXT(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_string) {
        n => ast_alloc(parser.allocator, AST_node::AST_string, parser.CT.location);
        n.AST_string.value = parser.CT.value;
        MOVE_NEXT(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_magic_location) {
        n => ast_alloc(parser.allocator, AST_node::AST_string, parser.CT.location);
        n.AST_string.value = make_location_string(parser);
        MOVE_NEXT(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_char_constant) {
        n => ast_alloc(parser.allocator, AST_node::AST_char_constant, parser.CT.location);
        n.AST_char_constant.value = parser.CT.value;
        MOVE_NEXT(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_builder_string_begin) {
        n => parse_builder_string(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_ampersand) {
        n => ast_alloc(parser.allocator, AST_node::AST_reference, parser.CT.location);
        MOVE_NEXT(parser);
        n.AST_reference.body => parse_primary(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_asterisk) {
        n => ast_alloc(parser.allocator, AST_node::AST_dereference, parser.CT.location);
        MOVE_NEXT(parser);
        n.AST_dereference.body => parse_primary(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_exclam || parser.CT.kind == TokenKind::TOK_minus) {
        n => ast_alloc(parser.allocator, AST_node::AST_unary, parser.CT.location);
        n.AST_unary.token_kind = parser.CT.kind;
        MOVE_NEXT(parser);
        n.AST_unary.body => parse_primary(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_plus_plus) {
        n => ast_alloc(parser.allocator, AST_node::AST_plus_plus, parser.CT.location);
        MOVE_NEXT(parser);
        n.AST_plus_plus.body => parse_primary(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_minus_minus) {
        n => ast_alloc(parser.allocator, AST_node::AST_minus_minus, parser.CT.location);
        MOVE_NEXT(parser);
        n.AST_minus_minus.body => parse_primary(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_lower) {
        n => ast_alloc(parser.allocator, AST_node::AST_user_cast, parser.CT.location);
        MOVE_NEXT(parser);
        n.AST_user_cast.typedecl => parse_typedecl(parser);
        take_expected(parser, TokenKind::TOK_greater);
        n.AST_user_cast.body => parse_primary(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_identifier) {
        n => ast_alloc(parser.allocator, AST_node::AST_symbol, parser.CT.location);
        n.AST_symbol.name = parser.CT.value;
        MOVE_NEXT(parser);

        while (parser.CT.kind == TokenKind::TOK_lparen |== TokenKind::TOK_lbracket
                             |== TokenKind::TOK_dot    |== TokenKind::TOK_colon_colon |== TokenKind::TOK_tilde)
        {
            if (parser.CT.kind == TokenKind::TOK_lparen) {
                let ast_call => ast_alloc(parser.allocator, AST_node::AST_call, parser.CT.location);
                ast_call.AST_call.target => n;
                ast_call.AST_call.args => parse_call_arguments(parser);
                n => ast_call;
            }
            else if (parser.CT.kind == TokenKind::TOK_lbracket) {
                let ast_arr => ast_alloc(parser.allocator, AST_node::AST_array_access, parser.CT.location);
                MOVE_NEXT(parser);
                ast_arr.AST_array_access.array => n;
                ast_arr.AST_array_access.index => parse_expression(parser);

                let ast_deref => ast_alloc(parser.allocator, AST_node::AST_dereference, parser.CT.location);
                ast_deref.AST_dereference.body => ast_arr;
                
                n => ast_deref;
                take_expected(parser, TokenKind::TOK_rbracket);
            } 
            if (parser.CT.kind == TokenKind::TOK_dot) {
                let ast_member_access => ast_alloc(parser.allocator, AST_node::AST_member_access, parser.CT.location);
                MOVE_NEXT(parser);
                expect_token(parser, TokenKind::TOK_identifier);
                ast_member_access.AST_member_access.body => n;
                ast_member_access.AST_member_access.name = parser.CT.value;
                n => ast_member_access;
                MOVE_NEXT(parser);
            }
            if (parser.CT.kind == TokenKind::TOK_colon_colon) {
                let ast_namespace_access => ast_alloc(parser.allocator, AST_node::AST_namespace_access, parser.CT.location);
                MOVE_NEXT(parser);
                expect_token(parser, TokenKind::TOK_identifier);
                ast_namespace_access.AST_namespace_access.body => n;
                ast_namespace_access.AST_namespace_access.name = parser.CT.value;
                MOVE_NEXT(parser);
                n => ast_namespace_access;
            }
            if (parser.CT.kind == TokenKind::TOK_tilde) {
                let ast_generic_speciation => ast_alloc(parser.allocator, AST_node::AST_generic_speciation, parser.CT.location);
                MOVE_NEXT(parser);
                ast_generic_speciation.AST_generic_speciation.typedecl => parse_typedecl(parser);
                ast_generic_speciation.AST_generic_speciation.body => n;
                n => ast_generic_speciation;
            }
        }
    }
    else if (parser.CT.kind == TokenKind::TOK_lparen) {
        MOVE_NEXT(parser);
        n => parse_expression(parser);

        if (parser.CT.kind != TokenKind::TOK_rparen)
        {
            parser_error(parser, $"Expected ')' but got {parser.CT.kind.name}");
        }
        MOVE_NEXT(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_if) {
        n => parse_if(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_while) {
        n => parse_while(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_for) {
        n => parse_for(parser);
    }
    else {
        parser_error(parser, $"Expected expression but got {parser.CT.kind.name}");
        return ast_alloc(parser.allocator, AST_node::AST_null, parser.CT.location);
    }

    n => parse_postfix_operators(parser, n);
    return n;
}

fn is_in_prio(op: TokenKind, prio) : bool {
    return if (prio == 0) op == TokenKind::TOK_equal_assign |== TokenKind::TOK_bind_ref
      else if (prio == 1) op == TokenKind::TOK_boolean_or
      else if (prio == 2) op == TokenKind::TOK_boolean_and
      else if (prio == 3) op == TokenKind::TOK_greater |== TokenKind::TOK_lower |== TokenKind::TOK_greater_equal |== TokenKind::TOK_lower_equal
      else if (prio == 4) op == TokenKind::TOK_equal |== TokenKind::TOK_unequal |== TokenKind::TOK_or_equal_to |== TokenKind::TOK_and_not_equal_to
                            |== TokenKind::TOK_reference_target_equal |== TokenKind::TOK_reference_target_unequal
      else if (prio == 5) op == TokenKind::TOK_plus |== TokenKind::TOK_minus
      else if (prio == 6) op == TokenKind::TOK_asterisk |== TokenKind::TOK_slash |== TokenKind::TOK_percent
      else if (prio == 7) op == TokenKind::TOK_up_arrow
      else false
}

fn is_comparison_operator(op: TokenKind) : bool {
    return op == TokenKind::TOK_greater || op == TokenKind::TOK_lower || op == TokenKind::TOK_greater_equal || op == TokenKind::TOK_lower_equal
}

fn is_chainable(left: TokenKind, right: TokenKind) : bool {
    return (is_comparison_operator(left) && is_comparison_operator(right))
    || ((left == TokenKind::TOK_equal |== TokenKind::TOK_or_equal_to) && right == TokenKind::TOK_or_equal_to)
    || ((left == TokenKind::TOK_unequal |== TokenKind::TOK_and_not_equal_to) && right == TokenKind::TOK_and_not_equal_to);
}

fn parse_binary_operators(parser: Parser&, prio) : AST_node& {
    if (prio == 8) return parse_primary(parser);
    
    let left => parse_binary_operators(parser, prio + 1);

    let last: AST_node& => null;
    while (is_in_prio(parser.CT.kind, prio)) {
        if (!last) {
            if (parser.CT.kind == TokenKind::TOK_or_equal_to) parser_error(parser, "Operator '|==' requires initial '=='.");
            if (parser.CT.kind == TokenKind::TOK_and_not_equal_to) parser_error(parser, "Operator '&!=' requires initial '!='.");
        }

        if (last && is_chainable(last.AST_binary.token_kind, parser.CT.kind)) {
            let members = endlos_begin~VariadicOperatorMember(parser.endlos);

            let member => members++;
            member.token_kind = last.AST_binary.token_kind;
            member.right => last.AST_binary.right;
            last.kind = AST_node::AST_variadic_operator;
            
            while (is_chainable(member.token_kind, parser.CT.kind)) {
                member => members++;
                member.token_kind = parser.CT.kind;
                MOVE_NEXT(parser);
                member.right => parse_binary_operators(parser, prio + 1);
            }

            last.AST_variadic_operator.members = endlos_ripp_off~VariadicOperatorMember(parser.endlos, members);
            left => last;
            last => null;
        }
        else
        {
            let n => ast_alloc(parser.allocator, AST_node::AST_binary, parser.CT.location);
            n.AST_binary.left => left;
            n.AST_binary.token_kind = parser.CT.kind;
            MOVE_NEXT(parser);
            n.AST_binary.right => parse_binary_operators(parser, prio + 1);

            left => n;
            last => n;
        }
    }

    return left;
}

fn parse_operators(parser: Parser&) : AST_node& {
    return parse_binary_operators(parser, 0);
}

fn parse_expression(parser: Parser&) : AST_node& {
    return parse_operators(parser);
}

fn parse_statement(parser: Parser&) : AST_node&
{
    let n: AST_node& => null;

    if (parser.CT.kind == TokenKind::TOK_keyword_return) {
        n => ast_alloc(parser.allocator, AST_node::AST_return, parser.CT.location);
        MOVE_NEXT(parser);

        if (parser.CT.kind != TokenKind::TOK_semicolon)
        {
            n.AST_return.body => parse_expression(parser);
        }
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_let) {
        n => ast_alloc(parser.allocator, AST_node::AST_var_decl, parser.CT.location);
        MOVE_NEXT(parser);
        
        if (parser.CT.kind != TokenKind::TOK_identifier) {
            parser_error(parser, $"Expected identifier, but got {parser.CT.kind.name}");
        }
        n.AST_var_decl.name = parser.CT.value;
        MOVE_NEXT(parser);

        n.AST_var_decl._typedecl => try_parse_typedecl(parser);

        if (parser.CT.kind == TokenKind::TOK_equal_assign || parser.CT.kind == TokenKind::TOK_bind_ref) {
            n.AST_var_decl.initializer_operator = parser.CT.kind;
            MOVE_NEXT(parser);
            n.AST_var_decl.initializer => parse_expression(parser);
        }
        else if (parser.CT.kind == TokenKind::TOK_semicolon) {
            // just declaring the variable without assigning it
        } else {
            parser_error(parser, $"Expected '=' or ';', but got {parser.CT.kind.name}");
        }
    }
    else if (parser.CT.kind == TokenKind::TOK_lbrace) {
        n => parse_scope_body(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_semicolon) {
        n => null;
    }
    else {
        n => parse_expression(parser);
    }

    return n;
}

fn parse_scope_body(parser: Parser&) : AST_node& {
    let ast_scope => ast_alloc(parser.allocator, AST_node::AST_scope, parser.CT.location);

    take_expected(parser, TokenKind::TOK_lbrace);

    while(parser.CT.kind != TokenKind::TOK_rbrace) {
        if (parser.CT.kind == TokenKind::TOK_eof) {
            parser_error(parser, "encountered EOF while parsing block");
            return ast_scope;
        }
        else if (parser.CT.kind == TokenKind::TOK_semicolon) {
            MOVE_NEXT(parser);
        }
        else {
            let n => parse_statement(parser);
            if (!n) {
                parser_error(parser, "Couldn't parse statement")
            }

            ast_link_to_chain(&ast_scope.AST_scope.body, n);

            if (parser.CT.kind != TokenKind::TOK_semicolon) {
                if (false) parser_error(parser, "missing ';'");
            }
        }
    }

    MOVE_NEXT(parser);

    return ast_scope;
}

fn insert_implicit_return(parser: Parser&, scope: AST_node&) {
    ASSERT(scope.kind == AST_node::AST_scope, "Tried to insert return in something that is not a scope\n");
    if (!scope.AST_scope.body) { // empty function
        let ast_return => ast_alloc(parser.allocator, AST_node::AST_return, scope.location);
        ast_return.AST_return.implicit = true;
        scope.AST_scope.body => ast_return;
    }
    else {
        let last => get_last_in_chain(scope.AST_scope.body);
        if (last.kind != AST_node::AST_return) {
            let ast_return => ast_alloc(parser.allocator, AST_node::AST_return, last.location);
            ast_return.AST_return.implicit = true;
            last.next => ast_return;
        }
    }
}

fn parse_function(parser: Parser&) : AST_node& {
    expect_token(parser, TokenKind::TOK_keyword_fn);
    let ast_fn => ast_alloc(parser.allocator, AST_node::AST_function, parser.CT.location);
    MOVE_NEXT(parser);

    expect_token(parser, TokenKind::TOK_identifier);
    ast_fn.AST_function.name = parser.CT.value;
    MOVE_NEXT(parser);

    take_expected(parser, TokenKind::TOK_lparen);

    // Function arguments
    {
        let ast_arglist => ast_alloc(parser.allocator, AST_node::AST_arg_list, parser.CT.location);
        ast_fn.AST_function.args => ast_arglist;

        let latest_arg: AST_node& => null;

        while (parser.CT.kind == TokenKind::TOK_identifier) {
            let ast_arg => ast_alloc(parser.allocator, AST_node::AST_arg_decl, parser.CT.location);
            ast_arg.AST_arg_decl.name = parser.CT.value;
            MOVE_NEXT(parser);

            ast_arg.AST_arg_decl._typedecl => try_parse_typedecl(parser);
            
            if (latest_arg) {
                latest_arg.next => ast_arg;
            } else {
                ast_arglist.AST_arg_list.body => ast_arg;
            }
            latest_arg => ast_arg;

            if(parser.CT.kind == TokenKind::TOK_komma) {
                MOVE_NEXT(parser);
            }
            else if (parser.CT.kind == TokenKind::TOK_rparen) {
            }
            else {
                parser_error(parser, $"Expected ')' or ',' but got {parser.CT.kind.name}")
            }
        }
        if (parser.CT.kind != TokenKind::TOK_rparen) {
            parser_error(parser, $"Expected ')' or function argument but got {parser.CT.kind.name}")
        }
    }

    MOVE_NEXT(parser);

    ast_fn.AST_function.ret_typedecl => try_parse_typedecl(parser);

    expect_token(parser, TokenKind::TOK_lbrace);
    ast_fn.AST_function.body => parse_scope_body(parser);

    insert_implicit_return(parser, ast_fn.AST_function.body);

    return ast_fn;
}

fn parse_struct_body(parser: Parser&, ast_struct: AST_node&) : void {
    take_expected(parser, TokenKind::TOK_lbrace);

    // Members
    {
        let latest: AST_node& => null;

        while (parser.CT.kind == TokenKind::TOK_identifier) {
            let member => ast_alloc(parser.allocator, AST_node::AST_member_def, parser.CT.location);
            member.AST_member_def.name = parser.CT.value;
            MOVE_NEXT(parser);
            member.AST_member_def._typedef => try_parse_typedecl(parser);

            if (latest) {
                latest.next => member;
            } else {
                ast_struct.AST_struct.body => member;
            }
            latest => member;

            take_expected(parser, TokenKind::TOK_semicolon);            
        }

        if(parser.CT.kind != TokenKind::TOK_rbrace) {
            parser_error(parser, $"Expected '}' or struct member definition but got {parser.CT.kind.name}");
        }

        MOVE_NEXT(parser);
    }
}

fn parse_struct(parser: Parser&) : AST_node& {
    let ast_struct => ast_alloc(parser.allocator, AST_node::AST_struct, parser.CT.location);

    if (parser.CT.kind == TokenKind::TOK_keyword_struct) {
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_record) {
        ast_struct.AST_struct.is_record = true;
    }
    else ASSERT(false, $"{__LOCATION__} Need to have struct or record here.\n");

    MOVE_NEXT(parser);

    expect_token(parser, TokenKind::TOK_identifier);
    ast_struct.AST_struct.name = parser.CT.value;
    MOVE_NEXT(parser);

    parse_struct_body(parser, ast_struct);

    return ast_struct;
}

fn parse_union(parser: Parser&) : AST_node& {
    expect_token(parser, TokenKind::TOK_keyword_union);
    let ast_union => ast_alloc(parser.allocator, AST_node::AST_union, parser.CT.location);
    MOVE_NEXT(parser);

    expect_token(parser, TokenKind::TOK_identifier);
    ast_union.AST_union.name = parser.CT.value;
    MOVE_NEXT(parser);

    if (parser.CT.kind == TokenKind::TOK_keyword_enum) {
        MOVE_NEXT(parser);
    
        expect_token(parser, TokenKind::TOK_identifier);
        ast_union.AST_union.enumerator_name = parser.CT.value;
        MOVE_NEXT(parser);
    }

    take_expected(parser, TokenKind::TOK_lbrace);

    // Members
    {
        let latest: AST_node& => null;
        let latest_value = 0;

        while (parser.CT.kind == TokenKind::TOK_keyword_struct) {
            let member => ast_alloc(parser.allocator, AST_node::AST_union_member_def, parser.CT.location);
            MOVE_NEXT(parser);

            if (parser.CT.kind == TokenKind::TOK_identifier) {
                member.AST_union_member_def.name = parser.CT.value;
                MOVE_NEXT(parser);
                if (parser.CT.kind == TokenKind::TOK_equal_assign) {
                    MOVE_NEXT(parser);
                    let neg = parser.CT.kind == TokenKind::TOK_minus;
                    if (neg) MOVE_NEXT(parser);
                    expect_token(parser, TokenKind::TOK_number);
                    latest_value = parse_integer(parser.CT.value);
                    if (neg) latest_value = -latest_value;
                    MOVE_NEXT(parser);
                }
                member.AST_union_member_def.enum_value = latest_value++;

                let ast_struct => ast_alloc(parser.allocator, AST_node::AST_struct, parser.CT.location);
                ast_struct.AST_struct.name = member.AST_union_member_def.name;
                parse_struct_body(parser, ast_struct);
                
                member.AST_union_member_def._typedef => ast_struct;

                if (latest) {
                    latest.next => member;
                } else {
                    ast_union.AST_union.body => member;
                }
                latest => member;

                if (parser.CT.kind == TokenKind::TOK_semicolon || parser.CT.kind == TokenKind::TOK_komma) {
                    MOVE_NEXT(parser);
                }
            }
            else if (parser.CT.kind == TokenKind::TOK_lbrace) {
                let ast_struct => ast_alloc(parser.allocator, AST_node::AST_struct, parser.CT.location);
                parse_struct_body(parser, ast_struct);
                
                member.AST_union_member_def._typedef => ast_struct;

                if (latest) {
                    latest.next => member;
                } else {
                    ast_union.AST_union.body => member;
                }
                latest => member;

                if (parser.CT.kind == TokenKind::TOK_semicolon || parser.CT.kind == TokenKind::TOK_komma) {
                    MOVE_NEXT(parser);
                }
            }
            else {
                parser_error(parser, $"Expected '\{' or struct name but got {parser.CT.kind.name}");
            }
        }

        if (parser.CT.kind != TokenKind::TOK_rbrace) {
            parser_error(parser, $"Expected '}' or union member definition but got {parser.CT.kind.name}");
        }
    }

    MOVE_NEXT(parser);

    return ast_union;
}

fn parse_enum(parser: Parser&) : AST_node& {
    expect_token(parser, TokenKind::TOK_keyword_enum);
    let ast_enum => ast_alloc(parser.allocator, AST_node::AST_enum, parser.CT.location);
    MOVE_NEXT(parser);

    expect_token(parser, TokenKind::TOK_identifier);
    ast_enum.AST_enum.name = parser.CT.value;
    MOVE_NEXT(parser);

    take_expected(parser, TokenKind::TOK_lbrace);

    // Members
    {
        let latest :AST_node& => null;
        let latest_value = 0;

        while (parser.CT.kind == TokenKind::TOK_identifier) {
            let member => ast_alloc(parser.allocator, AST_node::AST_enum_member, parser.CT.location);
            member.AST_enum_member.name = parser.CT.value;
            MOVE_NEXT(parser);
            if (parser.CT.kind == TokenKind::TOK_equal_assign) {
                MOVE_NEXT(parser);
                let neg = parser.CT.kind == TokenKind::TOK_minus;
                if (neg) MOVE_NEXT(parser);
                expect_token(parser, TokenKind::TOK_number);
                latest_value = parse_integer(parser.CT.value);
                if (neg) latest_value = -latest_value;
                MOVE_NEXT(parser);
            }
            member.AST_enum_member.value = latest_value++;

            if (latest) {
                latest.next => member;
            } else {
                ast_enum.AST_enum.body => member;
            }
            latest => member;

            if (parser.CT.kind == TokenKind::TOK_semicolon || parser.CT.kind == TokenKind::TOK_komma) {
                MOVE_NEXT(parser);
            }
            else {
                parser_error(parser, $"Expected ';' or ',' or '}' but got {parser.CT.kind.name}.");
            }
        }

        if (parser.CT.kind != TokenKind::TOK_rbrace) {
            parser_error(parser, $"Expected '}' or enum member definition but got {parser.CT.kind.name}");
        }

        MOVE_NEXT(parser);
    }
    
    return ast_enum;
}

fn parse_generic(parser: Parser&) : AST_node& {
    expect_token(parser, TokenKind::TOK_keyword_generic);
    let ast_generic => ast_alloc(parser.allocator, AST_node::AST_generic, parser.CT.location);
    MOVE_NEXT(parser);

    expect_token(parser, TokenKind::TOK_identifier);
    ast_generic.AST_generic.parameter_name = parser.CT.value;
    MOVE_NEXT(parser);

    if (parser.CT.kind == TokenKind::TOK_keyword_fn) {
        ast_generic.AST_generic.body => parse_function(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_struct |== TokenKind::TOK_keyword_record) {
        ast_generic.AST_generic.body => parse_struct(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_union) {
        ast_generic.AST_generic.body => parse_union(parser);
    }
    else parser_error(parser, "Generic definition expects either 'fn', 'struct', 'record' or 'union'.");

    return ast_generic;
}

fn parse_program(tokens: Token[], allocator: AST_Node_Allocator&, endlos: EndlosAllocator&, error_handler: ErrorHandler<Location&>& ) : AST_node& {
    let parser: Parser;
    parser.tokens = tokens;
    parser.CT => tokens.begin;
    parser.allocator => allocator;
    parser.endlos => endlos;
    parser.error_handler => error_handler;

    let root => ast_alloc(parser.allocator, AST_node::AST_program, parser.CT.location);

    while (parser.CT.kind != TokenKind::TOK_eof) {
        if (parser.CT.kind == TokenKind::TOK_keyword_import) {
            MOVE_NEXT(parser);
            take_expected(parser, TokenKind::TOK_asterisk);
            take_expected(parser, TokenKind::TOK_identifier); // from
            expect_token(parser, TokenKind::TOK_string);

            let ast_import => ast_alloc(parser.allocator, AST_node::AST_import, parser.CT.location);
            ast_import.AST_import.name = parser.CT.value;
            ast_link_to_chain(&root.AST_program.body, ast_import);

            MOVE_NEXT(parser);
            take_expected(parser, TokenKind::TOK_semicolon);
        }
        else if (parser.CT.kind == TokenKind::TOK_keyword_fn) {
            ast_link_to_chain(&root.AST_program.body, parse_function(parser));
        }
        else if (parser.CT.kind == TokenKind::TOK_keyword_struct || parser.CT.kind == TokenKind::TOK_keyword_record) {
            ast_link_to_chain(&root.AST_program.body, parse_struct(parser));
        }
        else if (parser.CT.kind == TokenKind::TOK_keyword_union) {
            ast_link_to_chain(&root.AST_program.body, parse_union(parser));
        }
        else if (parser.CT.kind == TokenKind::TOK_keyword_enum) {
            ast_link_to_chain(&root.AST_program.body, parse_enum(parser));
        }
        else if (parser.CT.kind == TokenKind::TOK_keyword_generic) {
            ast_link_to_chain(&root.AST_program.body, parse_generic(parser));
        }
        else {
            parser_error(parser, $"Expected top level definition or EOF but got {parser.CT.kind.name}");
            MOVE_NEXT(parser);
        }
    }
    return root;
}
