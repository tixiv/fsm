fn parse_typedecl(parser: Parser&) : AST_node& {
    if (parser.CT.kind == TokenKind::TOK_keyword_fn) {
        let ast_fn_type => ast_alloc(parser.allocator, AST_node::AST_function_type, parser.CT.location);
        MOVE_NEXT(parser);

        take_expected(parser, TokenKind::TOK_lparen);

        while (parser.CT.kind != TokenKind::TOK_rparen) {
            let arg => parse_typedecl(parser);
            if (!arg) parser_error(parser, $"Expected function argument type or ')' but have {parser.CT.kind.name}");

            ast_link_to_chain(&ast_fn_type.AST_function_type.function_args, arg);
            if (parser.CT.kind == TokenKind::TOK_komma){
                MOVE_NEXT(parser);
            }
            else {
                parser_error(parser, $"Expected ',' or ')' but have {parser.CT.kind.name}");
            }
        }
        MOVE_NEXT(parser);

        take_expected(parser, TokenKind::TOK_colon);

        ast_fn_type.AST_function_type.function_ret => parse_typedecl(parser);
        return ast_fn_type;
    }
    else if (parser.CT.kind == TokenKind::TOK_identifier) {
        let ast_type => ast_alloc(parser.allocator, AST_node::AST_typename, parser.CT.location);
        ast_type.AST_typename.name = parser.CT.value;
        MOVE_NEXT(parser);
        return parse_typedecl_postifx(ast_type);
    }
    
    return null;
}

fn try_parse_typedecl(parser: Parser&) : AST_node& {
    if(parser.CT.kind == TokenKind::TOK_colon) {
        MOVE_NEXT(parser);
        let n => parse_typedecl(parser);
        if (!n)
            parser_error(parser, $"Expected typename but have {parser.CT.kind.name}");
        return n;
    }
    return null;
}

fn parse_if(parser: Parser&) :AST_node& {
    let n => ast_alloc(parser.allocator, AST_node::AST_if, parser.CT.location);
    MOVE_NEXT(parser);

    if (parser.CT.kind != TokenKind::TOK_lparen) {
        parser_error(parser, $"Expected '(' but got {parser.CT.kind.name}");
    }
    MOVE_NEXT(parser);

    n.AST_if.condition => parse_expression(parser);

    if (parser.CT.kind != TokenKind::TOK_rparen) {
        parser_error(parser, $"Expected ')' but got {parser.CT.kind.name}");
    }
    MOVE_NEXT(parser);

    n.AST_if.if_clause => parse_statement(parser);

    if (parser.CT.kind == TokenKind::TOK_keyword_else) {
        MOVE_NEXT(parser);

        n.AST_if.else_clause => parse_statement(parser);
    }

    return n;
}

fn parse_while(parser: Parser&) :AST_node& {
    let n => ast_alloc(parser.allocator, AST_node::AST_while, parser.CT.location);
    MOVE_NEXT(parser);

    if (parser.CT.kind != TokenKind::TOK_lparen) {
        parser_error(parser, $"Expected '(' but got {parser.CT.kind.name}");
    }
    MOVE_NEXT(parser);

    n.AST_while.condition => parse_expression(parser);

    if (parser.CT.kind != TokenKind::TOK_rparen) {
        parser_error(parser, $"Expected ')' but got {parser.CT.kind.name}");
    }
    MOVE_NEXT(parser);

    n.AST_while.body => parse_statement(parser);

    return n;
}

fn parse_for(parser: Parser&) :AST_node& {
    let n => ast_alloc(parser.allocator, AST_node::AST_for, parser.CT.location);
    MOVE_NEXT(parser);

    take_expected(parser, TokenKind::TOK_lparen);
    if (parser.CT.kind != TokenKind::TOK_semicolon) n.AST_for.initializer => parse_statement(parser);
    take_expected(parser, TokenKind::TOK_semicolon);
    if (parser.CT.kind != TokenKind::TOK_semicolon) n.AST_for.condition => parse_expression(parser);
    take_expected(parser, TokenKind::TOK_semicolon);
    if (parser.CT.kind != TokenKind::TOK_rparen) n.AST_for.post_action => parse_statement(parser);
    if (parser.CT.kind == TokenKind::TOK_semicolon) {
        MOVE_NEXT(parser);
        n.AST_for.result => parse_expression(parser);
    }
    take_expected(parser, TokenKind::TOK_rparen);
    n.AST_for.body => parse_statement(parser);

    return n;
}

