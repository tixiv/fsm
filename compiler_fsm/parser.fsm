fn parse_program(tokens: Token[], allocator: AST_Node_Allocator&) : AST_node& {
    let parser: Parser;
    parser.tokens = tokens;
    parser.CT => tokens.begin;
    parser.allocator => allocator;

    let root => ast_alloc(parser.allocator, AST_node::AST_program, parser.CT.location);
    let last: AST_node& => null;


    while (parser.CT.kind != TokenKind::TOK_eof) {
        /* if (parser.CT.kind == TokenKind::TOK_keyword_import) {
            MOVE_NEXT(parser);
            take_expected(parser, TokenKind::TOK_asterisk);
            take_expected(parser, TokenKind::TOK_identifier); // from
            expect_token(parser, TokenKind::TOK_string);
            if (!resolve_import(parser.CT.value)) parser_error(parser, "Couldn't resolve import '%.*s'.\n", SV_prnt(parser.CT.value));
            MOVE_NEXT(parser);
            take_expected(parser, TokenKind::TOK_semicolon);
        }
        else */ if (parser.CT.kind == TokenKind::TOK_keyword_fn) {
            let fun => parse_function(parser);
            if (last) 
                last.next => fun
            else
                root.AST_program.body => fun
            last => fun;
        }
        /* else if (parser.CT.kind == TokenKind::TOK_keyword_struct || parser.CT.kind == TokenKind::TOK_keyword_record) {
            let n => parse_struct();
            if (last) 
                last.next => n
            else
                root.AST_program.body => n
            last => n;
        }
        else if (parser.CT.kind == TokenKind::TOK_keyword_union) {
            let n => parse_union();
            if (last) 
                last.next => n
            else
                root.AST_program.body => n
            last => n;
        }
        else if (parser.CT.kind == TokenKind::TOK_keyword_enum) {
            let n => parse_enum();
            if (last) 
                last.next => n
            else
                root.AST_program.body => n
            last => n;
        }
        */
        else if (parser.CT.kind == TokenKind::TOK_eof) {
        } else {
            parser_error(parser, $"Expected top level definition or EOF but got {parser.CT.kind.name}");
        }
    }
    return root;
}
