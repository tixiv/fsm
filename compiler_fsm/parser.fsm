fn parse_call_arguments(parser: Parser&) : AST_node& {
    MOVE_NEXT(parser);

    let first: AST_node& => null;
    let last: AST_node& => null;

    while (parser.CT.kind != TokenKind::TOK_rparen) {
        first => parse_expression(parser);
        last => first;

        while (parser.CT.kind == TokenKind::TOK_komma) {
            MOVE_NEXT(parser);
            let n=> parse_expression(parser); 
            last.next => n;
            last => n;
        }
    }
    MOVE_NEXT(parser);

    return first;
}

