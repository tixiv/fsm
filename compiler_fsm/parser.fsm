fn parse_primary(parser: Parser&) : AST_node&
{
    let n: AST_node& => null;

    if (parser.CT.kind == TokenKind::TOK_number) {
        n => ast_alloc(parser.allocator, AST_node::AST_number, parser.CT.location);
        n.AST_number.value = parser.CT.value;
        MOVE_NEXT(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_true) {
        n => ast_alloc(parser.allocator, AST_node::AST_bool, parser.CT.location);
        n.AST_bool.value = true;
        MOVE_NEXT(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_false) {
        n => ast_alloc(parser.allocator, AST_node::AST_bool, parser.CT.location);
        n.AST_bool.value = false;
        MOVE_NEXT(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_null) {
        n => ast_alloc(parser.allocator, AST_node::AST_null, parser.CT.location);
        MOVE_NEXT(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_string) {
        n => ast_alloc(parser.allocator, AST_node::AST_string, parser.CT.location);
        n.AST_string.value = parser.CT.value;
        MOVE_NEXT(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_char_constant) {
        n => ast_alloc(parser.allocator, AST_node::AST_char_constant, parser.CT.location);
        n.AST_char_constant.value = parser.CT.value;
        MOVE_NEXT(parser);
    }
    /*
    else if (parser.CT.kind == TokenKind::TOK_builder_string_begin) {
        n => parse_builder_string();
    }
    */
    else if (parser.CT.kind == TokenKind::TOK_ampersand) {
        n => ast_alloc(parser.allocator, AST_node::AST_reference, parser.CT.location);
        MOVE_NEXT(parser);
        n.AST_reference.body => parse_primary(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_exclam || parser.CT.kind == TokenKind::TOK_minus) {
        n => ast_alloc(parser.allocator, AST_node::AST_unary, parser.CT.location);
        n.AST_unary.token_kind = parser.CT.kind;
        MOVE_NEXT(parser);
        n.AST_unary.body => parse_primary(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_plus_plus) {
        n => ast_alloc(parser.allocator, AST_node::AST_plus_plus, parser.CT.location);
        MOVE_NEXT(parser);
        n.AST_plus_plus.body => parse_primary(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_minus_minus) {
        n => ast_alloc(parser.allocator, AST_node::AST_minus_minus, parser.CT.location);
        MOVE_NEXT(parser);
        n.AST_minus_minus.body => parse_primary(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_identifier) {
        n => ast_alloc(parser.allocator, AST_node::AST_symbol, parser.CT.location);
        n.AST_symbol.name = parser.CT.value;
        MOVE_NEXT(parser);

        while (parser.CT.kind == TokenKind::TOK_lparen |== TokenKind::TOK_lbracket
                             |== TokenKind::TOK_dot    |== TokenKind::TOK_colon_colon)
        {
            if (parser.CT.kind == TokenKind::TOK_lparen) {
                let ast_call => ast_alloc(parser.allocator, AST_node::AST_call, parser.CT.location);
                ast_call.AST_call.target => n;
                ast_call.AST_call.args => parse_call_arguments(parser);
                n => ast_call;
            }
            else if (parser.CT.kind == TokenKind::TOK_lbracket) {
                let ast_arr => ast_alloc(parser.allocator, AST_node::AST_array_access, parser.CT.location);
                MOVE_NEXT(parser);
                ast_arr.AST_array_access.array => n;
                ast_arr.AST_array_access.index => parse_expression(parser);

                let ast_deref => ast_alloc(parser.allocator, AST_node::AST_dereference, parser.CT.location);
                ast_deref.AST_dereference.body => ast_arr;
                
                n => ast_deref;
                take_expected(parser, TokenKind::TOK_rbracket);
            } 
            if (parser.CT.kind == TokenKind::TOK_dot) {
                let ast_member_access => ast_alloc(parser.allocator, AST_node::AST_member_access, parser.CT.location);
                MOVE_NEXT(parser);
                expect_token(parser, TokenKind::TOK_identifier);
                ast_member_access.AST_member_access.body => n;
                ast_member_access.AST_member_access.name = parser.CT.value;
                n => ast_member_access;
                MOVE_NEXT(parser);
            }
            if (parser.CT.kind == TokenKind::TOK_colon_colon) {
                let ast_namespace_access => ast_alloc(parser.allocator, AST_node::AST_namespace_access, parser.CT.location);
                MOVE_NEXT(parser);
                expect_token(parser, TokenKind::TOK_identifier);
                ast_namespace_access.AST_namespace_access.body => n;
                ast_namespace_access.AST_namespace_access.name = parser.CT.value;
                MOVE_NEXT(parser);
                n => ast_namespace_access;
            }
        }
    }
    else if (parser.CT.kind == TokenKind::TOK_lparen) {
        MOVE_NEXT(parser);
        n => parse_expression(parser);

        if (parser.CT.kind != TokenKind::TOK_rparen)
        {
            parser_error(parser, $"Expected ')' but got {parser.CT.kind.name}");
        }
        MOVE_NEXT(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_if) {
        n => parse_if(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_while) {
        n => parse_while(parser);
    }
    else if (parser.CT.kind == TokenKind::TOK_keyword_for) {
        n => parse_for(parser);
    }
    else {
        parser_error(parser, $"Expected expression but got {parser.CT.kind.name}");
    }

    // n => parse_postfix_operators(n);
    return n;
}

