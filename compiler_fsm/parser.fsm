            MOVE_NEXT(parser);
            n.binary.right = parse_binary_operators(prio + 1);

            left => n;
            last => n;
        }
    }

    return left;
}

fn parse_operators(parser: Parser&) : AST_node& {
    return parse_binary_operators(0);
}

