                    parse_struct_body(ast_struct);
                    
                    member.union_member_def._typedef => ast_struct;

                    if (latest) {
                        latest.next = member;
                    } else {
                        ast_union._union.body => member;
                    }
                    latest = member;

                    if (parser.CT.kind == TokenKind::TOK_semicolon || parser.CT.kind == TokenKind::TOK_komma) {
                        MOVE_NEXT(parser);
                    }
                }
                else if (parser.CT.kind == TokenKind::TOK_lbrace) {
                    let ast_struct => ast_alloc(parser.allocator, AST_node::AST_struct, parser.CT.location);
                    parse_struct_body(ast_struct);
                    
                    member.union_member_def._typedef => ast_struct;

                    if (latest) {
                        latest.next = member;
                    } else {
                        ast_union._union.body => member;
                    }
                    latest = member;

                    if (parser.CT.kind == TokenKind::TOK_semicolon || parser.CT.kind == TokenKind::TOK_komma) {
                        MOVE_NEXT(parser);
                    }
                }
                else NOT_IMPLEMENTED("not implemented yet.\n");
            }
            else {
                parser_error(parser, "Expected '}' or union member definition but got {parser.CT.kind.name}",
                    token_kind_name(parser.CT.kind));
            }
        }
    }

    debug_log_parser("Leaving %s\n", __func__);
    return ast_union;
}


