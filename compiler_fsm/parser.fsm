fn bool is_in_prio(int op, int prio) {
    for (int i = 0; i < NUM_MAX_OPERATORS_IN_PRIO; i++) {
        if (operator_table[prio][i] == op) return true;
    }
    return false;
}

bool is_comparison_operator(int op) {
    return op == TokenKind::TOK_greater || op == TokenKind::TOK_lower || op == TokenKind::TOK_greater_equal || op == TokenKind::TOK_lower_equal;
}

fn bool is_chainable(int left, int right) {
    return (is_comparison_operator(left) && is_comparison_operator(right))
    || ((left == TokenKind::TOK_equal || left == TokenKind::TOK_or_equal_to) && right == TokenKind::TOK_or_equal_to)
    || ((left == TokenKind::TOK_unequal || left == TokenKind::TOK_and_not_equal_to) && right == TokenKind::TOK_and_not_equal_to);
}

fn AST_node& parse_binary_operators(int prio) {
    if (prio == NUM_PRIOS) return parse_primary(parser);
    
    let left = parse_binary_operators(prio + 1);

