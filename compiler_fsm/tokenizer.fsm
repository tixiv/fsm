
import * from "std";
import * from "common";

enum TokenKind {
    TOK_null,
    TOK_keyword_fn,
    TOK_keyword_let,
    TOK_keyword_return,
    TOK_keyword_if,
    TOK_keyword_else,
    TOK_keyword_while,
    TOK_keyword_for,
    TOK_keyword_struct,
    TOK_keyword_record,
    TOK_keyword_enum,
    TOK_keyword_union,
    TOK_keyword_generic,
    TOK_keyword_import,
    TOK_keyword_true,
    TOK_keyword_false,
    TOK_keyword_null,
    TOK_keyword_fsm_debug,
    TOK_keyword_attribute,
    TOK_magic_location,
    TOK_lparen,
    TOK_rparen,
    TOK_lbrace,
    TOK_rbrace,
    TOK_lbracket,
    TOK_rbracket,
    TOK_plus,
    TOK_minus,
    TOK_plus_plus,
    TOK_minus_minus,
    TOK_asterisk,
    TOK_slash,
    TOK_up_arrow,
    TOK_percent,
    TOK_equal_assign,
    TOK_bind_ref,
    TOK_equal,
    TOK_unequal,
    TOK_reference_target_equal,
    TOK_reference_target_unequal,
    TOK_or_equal_to,
    TOK_and_not_equal_to,
    TOK_greater,
    TOK_lower,
    TOK_greater_equal,
    TOK_lower_equal,
    TOK_boolean_and,
    TOK_boolean_or,
    TOK_komma,
    TOK_colon,
    TOK_semicolon,
    TOK_dot,
    TOK_colon_colon,
    TOK_ampersand,
    TOK_exclam,
    TOK_tilde,
    TOK_identifier,
    TOK_string,
    TOK_number,
    TOK_char_constant,
    TOK_eof,
    TOK_builder_string_begin,
    TOK_builder_string_end,
}

fn token_kind_printable(kind: TokenKind) : u8[] {
    if (kind == TokenKind::TOK_null) return("(null token)");
    if (kind == TokenKind::TOK_keyword_fn) return("'fn'");
    if (kind == TokenKind::TOK_keyword_let) return("'let'");
    if (kind == TokenKind::TOK_keyword_return) return("'return'");
    if (kind == TokenKind::TOK_keyword_if) return("'if'");
    if (kind == TokenKind::TOK_keyword_else) return("'else'");
    if (kind == TokenKind::TOK_keyword_while) return("'while'");
    if (kind == TokenKind::TOK_keyword_for) return("'for'");
    if (kind == TokenKind::TOK_keyword_struct) return("'struct'");
    if (kind == TokenKind::TOK_keyword_record) return("'record'");
    if (kind == TokenKind::TOK_keyword_enum) return("'enum'");
    if (kind == TokenKind::TOK_keyword_union) return("'union'");
    if (kind == TokenKind::TOK_keyword_generic) return("'generic'");
    if (kind == TokenKind::TOK_keyword_import) return("'import'");
    if (kind == TokenKind::TOK_keyword_true) return("'true'");
    if (kind == TokenKind::TOK_keyword_false) return("'false'");
    if (kind == TokenKind::TOK_keyword_null) return("'null'");
    if (kind == TokenKind::TOK_keyword_fsm_debug) return("'fsm_debug'");
    if (kind == TokenKind::TOK_keyword_attribute) return("'__attribute'");
    if (kind == TokenKind::TOK_magic_location) return("'__LOCATION__'");
    if (kind == TokenKind::TOK_lparen) return("'('");
    if (kind == TokenKind::TOK_rparen) return("')'");
    if (kind == TokenKind::TOK_lbrace) return("'{'");
    if (kind == TokenKind::TOK_rbrace) return("'}'");
    if (kind == TokenKind::TOK_lbracket) return("'['");
    if (kind == TokenKind::TOK_rbracket) return("']'");
    if (kind == TokenKind::TOK_plus) return("'+'");
    if (kind == TokenKind::TOK_minus) return("'-'");
    if (kind == TokenKind::TOK_plus_plus) return("'++'");
    if (kind == TokenKind::TOK_minus_minus) return("'--'");
    if (kind == TokenKind::TOK_asterisk) return("'*'");
    if (kind == TokenKind::TOK_slash) return("'/'");
    if (kind == TokenKind::TOK_percent) return("'%'");
    if (kind == TokenKind::TOK_up_arrow) return("'^'");
    if (kind == TokenKind::TOK_equal_assign) return("'='");
    if (kind == TokenKind::TOK_bind_ref) return("'=>'");
    if (kind == TokenKind::TOK_equal) return("'=='");
    if (kind == TokenKind::TOK_unequal) return("'!='");
    if (kind == TokenKind::TOK_or_equal_to) return("'|=='");
    if (kind == TokenKind::TOK_and_not_equal_to) return("'&!='");
    if (kind == TokenKind::TOK_reference_target_equal) return "<==>";
    if (kind == TokenKind::TOK_reference_target_unequal) return "<!=>";
    if (kind == TokenKind::TOK_greater) return("'>'");
    if (kind == TokenKind::TOK_lower) return("'<'");
    if (kind == TokenKind::TOK_greater_equal) return("'>='");
    if (kind == TokenKind::TOK_lower_equal) return("'<='");
    if (kind == TokenKind::TOK_boolean_and) return("'&&'");
    if (kind == TokenKind::TOK_boolean_or) return("'||'");
    if (kind == TokenKind::TOK_komma) return("','");
    if (kind == TokenKind::TOK_colon) return("':'");
    if (kind == TokenKind::TOK_semicolon) return("';'");
    if (kind == TokenKind::TOK_dot) return("'.'");
    if (kind == TokenKind::TOK_colon_colon) return "'::'";
    if (kind == TokenKind::TOK_ampersand) return("'&'");
    if (kind == TokenKind::TOK_exclam) return("'!'");
    if (kind == TokenKind::TOK_tilde) return("'~'");
    if (kind == TokenKind::TOK_identifier) return("identifier");
    if (kind == TokenKind::TOK_string) return("string constant");
    if (kind == TokenKind::TOK_number) return("number");
    if (kind == TokenKind::TOK_char_constant) return ("char constant");
    if (kind == TokenKind::TOK_eof) return("EOF");
    if (kind == TokenKind::TOK_builder_string_begin) return "'$\"'";
    if (kind == TokenKind::TOK_builder_string_end)  return "'\"'";

    return kind.name;
}

struct Token {
    kind: TokenKind;
    value: u8[];
    location: Location;
}

struct Tokenizer {
    code: u8[];
    tokens: Token[];
    location: Location;
    inside_builder_string: bool;
    error_handler: ErrorHandler<Location&>&;
}

fn is_allowed_at_start_of_identifier(c: i32) { return is_alpha(c) || c == '_' }
fn is_allowed_in_identifier(c: i32) { return is_alpha(c) || is_numeric(c) || c == '_' }

fn tokenizer_error(tokenizer: Tokenizer&, message: u8[]) {
    let eh =>  tokenizer.error_handler;
    eh.handler("[FSM Tokenizer]", tokenizer.location, message, Severity::Error, eh.arg);
}

fn tokenizer_pop(tokenizer: Tokenizer&) : void {
    let c = tokenizer.code++
    if (c == '\n') {
        tokenizer.location.line++
        tokenizer.location.col = 1
    }
    else {
        tokenizer.location.col++
    }
}

fn tokenizer_pop_n(tokenizer: Tokenizer&, n) : u8[] {
    let res = tokenizer.code;
    res.len = n;
    while (n--) tokenizer_pop(tokenizer)
    return res;
}

fn read_word(tokenizer: Tokenizer&) {
    let code => tokenizer.code;
    let word = code;
    word.len = 0;

    while(code.len && is_allowed_in_identifier(code.begin) ) {
        tokenizer_pop(tokenizer)
        word.len++
    }
    return word;
}

fn read_number(tokenizer: Tokenizer&) {
    let num: u8[];
    num.begin => tokenizer.code.begin;
    num.len = 0;
    let hex = false;

    if (sv_starts_with(tokenizer.code, "0x")) {
        tokenizer_pop_n(tokenizer, 2)
        num.len = 2
        hex = true
    }
    while(tokenizer.code.len && if (hex) is_hex_digit(tokenizer.code.begin) else is_numeric(tokenizer.code.begin)) {
        tokenizer_pop(tokenizer)
        num.len++;
    }
    return num;
}

fn push_token (tokenizer: Tokenizer&, kind: TokenKind, value: u8[]) {
    let token => tokenizer.tokens++
    token.kind = kind;
    token.location = tokenizer.location;
    token.value = value;
}

fn push_token_fixed (tokenizer: Tokenizer&, kind: TokenKind, len) {
    let token => tokenizer.tokens++
    token.kind = kind;
    token.location = tokenizer.location;
    token.value.begin => tokenizer.code[-len];
    token.value.len = len;
}

fn handle_word(tokenizer: Tokenizer&) {
    let word = read_word(tokenizer);
    if (sv_equal(word, "fn")) {
        push_token(tokenizer, TokenKind::TOK_keyword_fn, word);
    }
    else if (sv_equal(word, "let")) {
        push_token(tokenizer, TokenKind::TOK_keyword_let, word);
    }
    else if (sv_equal(word, "return")) {
        push_token(tokenizer, TokenKind::TOK_keyword_return, word);
    }
    else if (sv_equal(word, "if")) {
        push_token(tokenizer, TokenKind::TOK_keyword_if, word);
    }
    else if (sv_equal(word, "else")) {
        push_token(tokenizer, TokenKind::TOK_keyword_else, word);
    }
    else if (sv_equal(word, "for")) {
        push_token(tokenizer, TokenKind::TOK_keyword_for, word);
    }
    else if (sv_equal(word, "null")) {
        push_token(tokenizer, TokenKind::TOK_keyword_null, word);
    }
    else if (sv_equal(word, "true")) {
        push_token(tokenizer, TokenKind::TOK_keyword_true, word);
    }
    else if (sv_equal(word, "false")) {
        push_token(tokenizer, TokenKind::TOK_keyword_false, word);
    }
    else if (sv_equal(word, "while")) {
        push_token(tokenizer, TokenKind::TOK_keyword_while, word);
    }
    else if (sv_equal(word, "struct")) {
        push_token(tokenizer, TokenKind::TOK_keyword_struct, word);
    }
    else if (sv_equal(word, "record")) {
        push_token(tokenizer, TokenKind::TOK_keyword_record, word);
    }
    else if (sv_equal(word, "enum")) {
        push_token(tokenizer, TokenKind::TOK_keyword_enum, word);
    }
    else if (sv_equal(word, "union")) {
        push_token(tokenizer, TokenKind::TOK_keyword_union, word);
    }
    else if (sv_equal(word, "generic")) {
        push_token(tokenizer, TokenKind::TOK_keyword_generic, word);
    }
    else if (sv_equal(word, "import")) {
        push_token(tokenizer, TokenKind::TOK_keyword_import, word);
    }
    else if (sv_equal(word, "fsm_debug")) {
        push_token(tokenizer, TokenKind::TOK_keyword_fsm_debug, word);
    }
    else if (sv_equal(word, "__attribute")) {
        push_token(tokenizer, TokenKind::TOK_keyword_attribute, word);
    }
    else if (sv_equal(word, "__LOCATION__")) {
        push_token(tokenizer, TokenKind::TOK_magic_location, word);
    }
    else {
        push_token(tokenizer, TokenKind::TOK_identifier, word);
    }
}

fn read_string(tokenizer: Tokenizer&) {
    tokenizer_pop(tokenizer); // initial '"'
    let code => tokenizer.code;
    let str = code;
    str.len = 0;

    while(code.len && '"' != code.begin) {
        if (sv_starts_with(code, "\\")) {
            str.len = str.len + 2; tokenizer_pop_n(tokenizer, 2)
        }
        else {
            tokenizer_pop(tokenizer);
            str.len++;
        }
    }
    if (code.len) {
        tokenizer_pop(tokenizer); // closing '"'
    } else {
        tokenizer_error(tokenizer, "Unmatched '\"'.");
        // exit(EXIT_FAILURE);
    }
    return str;
}

fn read_char_constant(tokenizer: Tokenizer&) {
    tokenizer_pop(tokenizer); // initial '
    let str = tokenizer.code;
    str.len = 0;
    while(tokenizer.code.len) {
        if (sv_starts_with(tokenizer.code, "\\")) {
            tokenizer_pop(tokenizer);
            str.len++;
        }
        else if ('\'' == tokenizer.code.begin) {
            tokenizer_pop(tokenizer);
            return str;
        }
        tokenizer_pop(tokenizer);
        str.len++;
    }
    if (tokenizer.code.len) {
        tokenizer_pop(tokenizer); // closing '''
    } else {
        tokenizer_error(tokenizer, "Unmatched '\''.");
        //exit(EXIT_FAILURE);
    }
    return str;
}

fn read_builder_string(tokenizer: Tokenizer&) {
    {
        let bs_begin = tokenizer_pop_n(tokenizer, 2) // skip $"
        push_token(tokenizer, TokenKind::TOK_builder_string_begin, bs_begin);
    }

    let code => tokenizer.code;
    let str = code;
    str.len = 0;
    while(code.len && '"' != code.begin) {
        if (sv_starts_with(code, "\\\"")
           || sv_starts_with(code, "\\{")
           || sv_starts_with(code, "\\}"))
        {
            str.len++; str.len++; tokenizer_pop_n(tokenizer, 2);
        }
        else {
            let c = code.begin;
            tokenizer_pop(tokenizer);

            if (c == '{') {
                push_token(tokenizer, TokenKind::TOK_string, str);
                tokenizer.inside_builder_string = true;
                tokenize_fsm(tokenizer);
                tokenizer.inside_builder_string = false;
                str = code;
                str.len = 0;
            }
            else
            {
                str.len++;
            }
        }
    }

    if (str.len) push_token(tokenizer, TokenKind::TOK_string, &str);

    if (code.len) {
        tokenizer_pop(tokenizer); // closing '"'
    } else {
        tokenizer_error(tokenizer,  "Unmatched '\"'.");
    }

    push_token(tokenizer, TokenKind::TOK_builder_string_end, "\"");
}

fn tokenize_fsm (tokenizer: Tokenizer&) : void {
    let code => tokenizer.code;

    while (code.len) {
        let c = code.begin;

        if (c == ' ' |== '\n' |== '\t' |== '\r') {
            tokenizer_pop(tokenizer);
        }
        else if (is_allowed_at_start_of_identifier(c)) {
            handle_word(tokenizer); 
        }
        else if (is_numeric(c)) {
            let num = read_number(tokenizer);
            push_token(tokenizer, TokenKind::TOK_number, &num);
        }
        else if ('.' == c) {
            push_token(tokenizer, TokenKind::TOK_dot, tokenizer_pop_n(tokenizer, 1));
        }
        else if (c == '=') {
            if (sv_starts_with(code, "=>")) {
                push_token(tokenizer, TokenKind::TOK_bind_ref, tokenizer_pop_n(tokenizer, 2));
            }
            else if (sv_starts_with(code, "==")) {
                push_token(tokenizer, TokenKind::TOK_equal, tokenizer_pop_n(tokenizer, 2));
            }
            else {
                push_token(tokenizer, TokenKind::TOK_equal_assign, tokenizer_pop_n(tokenizer, 1));
            }
        }
        else if (';' == c) {
            push_token(tokenizer, TokenKind::TOK_semicolon, tokenizer_pop_n(tokenizer, 1));
        }
        else if ('[' == c) {
            push_token(tokenizer, TokenKind::TOK_lbracket, tokenizer_pop_n(tokenizer, 1));
        }
        else if (']' == c) {
            push_token(tokenizer, TokenKind::TOK_rbracket, tokenizer_pop_n(tokenizer, 1));
        }
        else if ('(' == c) {
            push_token(tokenizer, TokenKind::TOK_lparen, tokenizer_pop_n(tokenizer, 1));
        }
        else if (')' == c) {
            push_token(tokenizer, TokenKind::TOK_rparen, tokenizer_pop_n(tokenizer, 1));
        }
        else if ('{' == c) {
            push_token(tokenizer, TokenKind::TOK_lbrace, tokenizer_pop_n(tokenizer, 1));
        }
        else if ('}' == c) {
            tokenizer_pop_n(tokenizer, 1)
            if (tokenizer.inside_builder_string) {
                return;
            }
            push_token(tokenizer, TokenKind::TOK_rbrace, "}");
        }
        else if (':' == c) {
            if (sv_starts_with(code, "::")) {       
                push_token(tokenizer, TokenKind::TOK_colon_colon, tokenizer_pop_n(tokenizer, 2));
            }
            else {
                push_token(tokenizer, TokenKind::TOK_colon, tokenizer_pop_n(tokenizer, 1));
            }
        }
        else if (c == '&') {
            if (sv_starts_with(code, "&!=")) {
                push_token(tokenizer, TokenKind::TOK_and_not_equal_to, tokenizer_pop_n(tokenizer, 3));
            }
            else if (sv_starts_with(code, "&&")) {
                push_token(tokenizer, TokenKind::TOK_boolean_and, tokenizer_pop_n(tokenizer, 2));
            }
            else {
                push_token(tokenizer, TokenKind::TOK_ampersand, tokenizer_pop_n(tokenizer, 1));
            }
        }
        else if (',' == c) {
            push_token(tokenizer, TokenKind::TOK_komma, tokenizer_pop_n(tokenizer, 1));
        }
        else if (c == '!') {
            if (sv_starts_with(code, "!=")) {
                push_token(tokenizer, TokenKind::TOK_unequal, tokenizer_pop_n(tokenizer, 2));
            }
            else {
                push_token(tokenizer, TokenKind::TOK_exclam, tokenizer_pop_n(tokenizer, 1));
            }
        }
        else if (c == '|') {
            if (sv_starts_with(code, "|==")) {
                push_token(tokenizer, TokenKind::TOK_or_equal_to, tokenizer_pop_n(tokenizer, 3));
            }
            else if (sv_starts_with(code, "||")) {
                push_token(tokenizer, TokenKind::TOK_boolean_or, tokenizer_pop_n(tokenizer, 2));
            }
        }
        else if (sv_starts_with(code, "++")) {
            push_token(tokenizer, TokenKind::TOK_plus_plus, tokenizer_pop_n(tokenizer, 2));
        }
        else if (sv_starts_with(code, "--")) {
            push_token(tokenizer, TokenKind::TOK_minus_minus, tokenizer_pop_n(tokenizer, 2));
        }
        else if (sv_starts_with(code, "//")) {
            while(code.len && code.begin != '\n')
                tokenizer_pop(tokenizer)
        }
        else if (sv_starts_with(code, "/*")) {
            while(code.len && !sv_starts_with(code, "*/")) {
                tokenizer_pop(tokenizer)
            }
            tokenizer_pop_n(tokenizer, 2)
        }
        else if (sv_starts_with(code, "*/")) {
            tokenizer_pop_n(tokenizer, 2)
            tokenizer_error(tokenizer, "Encountered '*/' outside of comment.");
        }
        else if ('+' == c) {
            push_token(tokenizer, TokenKind::TOK_plus, tokenizer_pop_n(tokenizer, 1));
        }
        else if ('-' == c) {
            push_token(tokenizer, TokenKind::TOK_minus, tokenizer_pop_n(tokenizer, 1));
        }
        else if ('*' == c) {
            push_token(tokenizer, TokenKind::TOK_asterisk, tokenizer_pop_n(tokenizer, 1));
        }
        else if ('^' == c) {
            push_token(tokenizer, TokenKind::TOK_up_arrow, tokenizer_pop_n(tokenizer, 1));
        }
        else if ('~' == c) {
            push_token(tokenizer, TokenKind::TOK_tilde, tokenizer_pop_n(tokenizer, 1));
        }
        else if ('/' == c) {
            push_token(tokenizer, TokenKind::TOK_slash, tokenizer_pop_n(tokenizer, 1));
        }
        else if ('%' == c) {
            push_token(tokenizer, TokenKind::TOK_percent, tokenizer_pop_n(tokenizer, 1));
        }
        else if (sv_starts_with(code, "<==>")) {
            push_token(tokenizer, TokenKind::TOK_reference_target_equal, tokenizer_pop_n(tokenizer, 4));
        }
        else if (sv_starts_with(code, "<!=>")) {
            push_token(tokenizer, TokenKind::TOK_reference_target_unequal, tokenizer_pop_n(tokenizer, 4));
        }
        else if (sv_starts_with(code, ">=")) {
            push_token(tokenizer, TokenKind::TOK_greater_equal, tokenizer_pop_n(tokenizer, 2));
        }
        else if (sv_starts_with(code, "<=")) {
            push_token(tokenizer, TokenKind::TOK_lower_equal, tokenizer_pop_n(tokenizer, 2));
        }
        else if (c == '>') {
            push_token(tokenizer, TokenKind::TOK_greater, tokenizer_pop_n(tokenizer, 1));
        }
        else if (c == '<') {
            push_token(tokenizer, TokenKind::TOK_lower, tokenizer_pop_n(tokenizer, 1));
        }
        else if (sv_starts_with(code, "$\"")) {
            read_builder_string(tokenizer);
        }
        else if ('"' == c) {
            let str = read_string(tokenizer);
            push_token(tokenizer, TokenKind::TOK_string, &str);
        }
        else if ('\'' == c) {
            let str = read_char_constant(tokenizer);
            push_token(tokenizer, TokenKind::TOK_char_constant, &str);
        }
        else {
            let a = code;
            a.len = 1;
            tokenizer_error(tokenizer,  $"Encountered unhandled character {c} = '{a}'.");
            tokenizer_pop(tokenizer);
        }
    }
    push_token(tokenizer, TokenKind::TOK_eof, "");
}

fn dump_tokens(tokens: Token[]) {
    for (let i = 0; i < tokens.len; i++) {
        let t => tokens[i];
        if (t.value.len) {
            $"[{t.location.line}: {t.kind.name}, \"{t.value}\"]\n";
        } else {
            $"[{t.location.line}: {t.kind.name}]\n";
        }
    }
}
