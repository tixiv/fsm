    declare_builtin_fn(res, "bitshift", tc.builtin_u64, 2, (Type*[]){get_ref_type_for(tc.builtin_any), tc.builtin_i64});
    declare_builtin_fn(res, "bitand", tc.builtin_u64, 2, (Type*[]){tc.builtin_u64, tc.builtin_u64});
    declare_builtin_fn(res, "bitor", tc.builtin_u64, 2, (Type*[]){tc.builtin_u64, tc.builtin_u64});
    declare_builtin_fn(res, "bitxor", tc.builtin_u64, 2, (Type*[]){tc.builtin_u64, tc.builtin_u64});
    declare_builtin_fn(res, "bitnot", tc.builtin_u64, 1, (Type*[]){tc.builtin_u64});
*/
}


fn resolver_lookup_symbol(res: Resolver&, name: u8[], n: AST_node&, do_undefined_error: bool) : Symbol& {
    // locals
    let s => get_symbol_by_name(res.local_symbols, name);
    if (s) return s;

    // globals
    s => get_symbol_by_name(res.global_symbols, name);
    if (s) return s;

    if(do_undefined_error)
        resolver_error(n, $"Undefined symbol {name}");
    
    return null;
}

fn resolver_enter_function(res: Resolver&, s_fun: Symbol&) {
    res.current_function => s_fun;
    SymbolRefArr_reset(res.local_symbols, 0);
    res.locals_stack_pointer = 0;
}

fn resolver_leave_function(res: Resolver&) {
    ASSERT(res.current_function, "Resolver leave function called without active function\n");
    res.current_function => null;
}

fn resolver_enter_scope(res: Resolver&, n: AST_node&) {
    if (res.locals_stack_pointer >= 99) resolver_error(n, "Scope stack overflow. More than 100 levels nested. What are you doing?.\n");
    res.locals_stack[res.locals_stack_pointer++] = res.local_symbols.arr.len;
}

fn resolver_leave_scope(res: Resolver&) {
    ASSERT(res.locals_stack_pointer >= 1, "Resolver locals stack underflow.\n")
    SymbolRefArr_reset(res.local_symbols, res.locals_stack[--res.locals_stack_pointer]);
}

fn resolve_globals_visitor (n: AST_node&, res: Resolver&) : void {
    if (n.kind == AST_node::AST_function) {
        let s_fun => alloc_symbol(res.symbol_roll, SymbolKind::SYM_function, n.AST_function.name);
        push_symbol(res, res.global_symbols, s_fun, n);
        n.AST_function.symbol => s_fun;
    }
    else
        ast_visit_children(n, resolve_globals_visitor, res);
}

fn resolver_visitor(n: AST_node&, res: Resolver&) : void {
    $"Resolver visitor{n.kind.name}\n"
    if (n.kind == AST_node::AST_function) {
        resolver_enter_function(res,  n.AST_function.symbol);
        ast_visit_children(n, resolver_visitor, res);
        resolver_leave_function(res);
    }
    else if (n.kind == AST_node::AST_arg_decl) {
        ASSERT(res.current_function, $"{__LOCATION__}: Found function argument declaration for '{n.AST_arg_decl.name}' outside of function\n");
        let s_arg => alloc_symbol(res.symbol_roll, SymbolKind::SYM_arg, n.AST_arg_decl.name);
        push_symbol(res, &res.local_symbols, s_arg, n);
        n.AST_arg_decl.symbol => s_arg;
    }
    else if (n.kind == AST_node::AST_var_decl) {
        ASSERT(res.current_function, $"{__LOCATION__}: Found local variable declaration for '{n.AST_var_decl.name}' outside of function\n");
        let s_var => alloc_symbol(res.symbol_roll, SymbolKind::SYM_local, n.AST_var_decl.name);
        push_symbol(res, &res.local_symbols, s_var, n);
        n.AST_var_decl.symbol => s_var;
        ast_visit_children(n, resolver_visitor, res);
    }
    else if (n.kind == AST_node::AST_symbol) {
        n.AST_symbol.symbol => resolver_lookup_symbol(res, n.AST_symbol.name, n, true);
    }
    else if (n.kind == AST_node::AST_scope) {
        resolver_enter_scope(res, n);
        ast_visit_children(n, resolver_visitor, res);
        resolver_leave_scope(res);
    }
    else if (n.kind == AST_node::AST_for) {
        resolver_enter_scope(res, n);
        ast_visit_children(n, resolver_visitor, res);
        resolver_leave_scope(res);
    }
    else if (n.kind == AST_node::AST_arg_list
                    |== AST_node::AST_program
                    |== AST_node::AST_if
                    |== AST_node::AST_while
                    |== AST_node::AST_number
                    |== AST_node::AST_bool
                    |== AST_node::AST_null
                    |== AST_node::AST_binary
                    |== AST_node::AST_variadic_operator
                    |== AST_node::AST_unary
                    |== AST_node::AST_string
                    |== AST_node::AST_char_constant
                    |== AST_node::AST_array_access
                    |== AST_node::AST_dereference
                    |== AST_node::AST_reference
                    |== AST_node::AST_plus_plus
                    |== AST_node::AST_minus_minus
                    |== AST_node::AST_struct
                    |== AST_node::AST_member_def
                    |== AST_node::AST_member_access
                    |== AST_node::AST_namespace_access
                    |== AST_node::AST_enum
                    |== AST_node::AST_enum_member
                    |== AST_node::AST_union
                    |== AST_node::AST_union_member_def
                    |== AST_node::AST_typename
                    |== AST_node::AST_type_ref
                    |== AST_node::AST_type_array
                    |== AST_node::AST_type_slice
                    |== AST_node::AST_builder_string
                    |== AST_node::AST_user_cast
                    |== AST_node::AST_call
                    |== AST_node::AST_return)
    {
        ast_visit_children(n, resolver_visitor, res);
    }
    else NOT_IMPLEMENTED(__LOCATION__, $"Resolver for {n.kind.name}");
}

fn resolver_run(res: Resolver&, root: AST_node&) {
    resolve_globals_visitor(root, res);
    resolver_visitor(root, res);
}

fn resolver_init (res: Resolver&, allocator: EndlosAllocator&, type_cache: TypeCache&) {
    SymbolRefArr_init(res.local_symbols, allocator);
    SymbolRefArr_init(res.global_symbols, allocator);
    res.symbol_roll = endlos_begin~Symbol(allocator);
    res.locals_stack = endlos_begin~i64(allocator);
    res.type_cache => type_cache;
    init_builtin_functions(res);
}

