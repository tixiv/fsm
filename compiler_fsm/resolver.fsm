    declare_builtin_fn(res, "read", tc.builtin_i64, 2, (Type*[]){tc.builtin_i64, tc.builtin_u8_slice});
    declare_builtin_fn(res, "write", tc.builtin_i64, 2, (Type*[]){tc.builtin_i64, tc.builtin_u8_slice});
    declare_builtin_fn(res, "socket", tc.builtin_i64, 3, (Type*[]){tc.builtin_i64, tc.builtin_i64, tc.builtin_i64});
    declare_builtin_fn(res, "connect", tc.builtin_i64, 2, (Type*[]){tc.builtin_i64, tc.builtin_u8_slice});

    // mmap(addr: any&, lenght: i64, prot: u64, flags: u64, fd: i64, offset: i64) : any &
    declare_builtin_fn(res, "mmap", get_ref_type_for(tc.builtin_any, 6, (Type*[]){get_ref_type_for(tc.builtin_any), tc.builtin_i64, tc.builtin_u64, tc.builtin_u64, tc.builtin_i64, tc.builtin_i64});

*/
    tmp_args.len = 1; tmp_args[0] => tc.builtin_i64;
    declare_builtin_fn(res, "print", tc.builtin_void, tmp_args);
/*
    declare_builtin_fn(res, "putc", tc.builtin_void, 1, (Type*[]){tc.builtin_u8});
    declare_builtin_fn(res, "puts", tc.builtin_void, 1, (Type*[]){tc.builtin_u8_slice});
    declare_builtin_fn(res, "fsize", tc.builtin_i64, 1, (Type*[]){tc.builtin_i64});// fsize(fd: i64) : i64

