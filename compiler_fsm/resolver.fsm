
import * from "ast";
import * from "symbol";

fn resolver_error(n: AST_node&, s: u8[]) {
    let l = n.location;
    write(2, $"[FSM Resolver] {l.module.filename}:{l.line} Error: {s}\n");
    exit(1);
}

struct Resolver {
    symbol_cache: SymbolCache&;
    type_cache: TypeCache&;
    local_symbols: EndlosArr<Symbol&>;
    current_function: Symbol&;
    locals_stack: i64[];
    locals_stack_pointer : i64;
    current_generic: AST_node&;
    generic_symbol: Symbol&;
    current_generic_type: Type&;
    out_latest_function: Symbol&;
}

fn push_symbol(res: Resolver&, arr: EndlosArr<Symbol&>&, s: Symbol&, n: AST_node&) {
    if (s.name.len) {
        let conflicting => resolver_lookup_symbol(res,  s.name, n, false);
        if (conflicting) {
            resolver_error(n, $"Symbol '{s.name}' redefined\n");
            return;
        }
    }

    EndlosArr_push_ref~Symbol&(arr, s);
}

fn resolver_lookup_symbol(res: Resolver&, name: u8[], n: AST_node&, do_undefined_error: bool) : Symbol& {
    // locals
    let s => get_symbol_by_name(res.local_symbols, name);
    if (s) return s;

    // globals
    s => get_global_symbol_by_name(res.symbol_cache, name);
    if (s) return s;

    if (res.generic_symbol && sv_equal(res.generic_symbol.name, name)) {
        return res.generic_symbol;
    }

    if(do_undefined_error)
        resolver_error(n, $"Undefined symbol {name}");
    
    return null;
}

fn resolver_enter_function(res: Resolver&, s_fun: Symbol&) {
    res.current_function => s_fun;
    EndlosArr_reset~Symbol&(res.local_symbols, 0);
    res.locals_stack_pointer = 0;
}

fn resolver_leave_function(res: Resolver&) {
    ASSERT(res.current_function, "Resolver leave function called without active function\n");
    res.current_function => null;
}

fn resolver_enter_scope(res: Resolver&, n: AST_node&) {
    if (res.locals_stack_pointer >= 99) resolver_error(n, "Scope stack overflow. More than 100 levels nested. What are you doing?.\n");
    res.locals_stack[res.locals_stack_pointer++] = res.local_symbols.arr.len;
}

fn resolver_leave_scope(res: Resolver&) {
    ASSERT(res.locals_stack_pointer >= 1, "Resolver locals stack underflow.\n")
    EndlosArr_reset~Symbol&(res.local_symbols, res.locals_stack[--res.locals_stack_pointer]);
}

fn resolve_globals_visitor (n: AST_node&, res: Resolver&) : void {
    if (n.kind == AST_node::AST_function) {
        let s_fun => alloc_symbol(res.symbol_cache, SymbolKind::SYM_function, n.AST_function.name, n.location);
        s_fun.source => res.current_generic;
        push_global_symbol(res.symbol_cache, s_fun)
        n.AST_function.symbol => s_fun;
    }
    else if (n.kind == AST_node::AST_generic) {
        res.current_generic => n;
        ast_visit_children(n, resolve_globals_visitor, res);
        res.current_generic => null;
    }
    else
        ast_visit_children(n, resolve_globals_visitor, res);
}

fn resolver_visitor(n: AST_node&, res: Resolver&) : void {
    // $"Resolver visitor{n.kind.name}\n"
    if (n.kind == AST_node::AST_function) {
        resolver_enter_function(res,  n.AST_function.symbol);
        ast_visit_children(n, resolver_visitor, res);
        resolver_leave_function(res);
    }
    else if (n.kind == AST_node::AST_arg_decl) {
        ASSERT(res.current_function, $"{__LOCATION__}: Found function argument declaration for '{n.AST_arg_decl.name}' outside of function\n");
        let s_arg => alloc_symbol(res.symbol_cache, SymbolKind::SYM_arg, n.AST_arg_decl.name, n.location);
        push_symbol(res, &res.local_symbols, s_arg, n);
        n.AST_arg_decl.symbol => s_arg;
    }
    else if (n.kind == AST_node::AST_var_decl) {
        ASSERT(res.current_function, $"{__LOCATION__}: Found local variable declaration for '{n.AST_var_decl.name}' outside of function\n");
        let s_var => alloc_symbol(res.symbol_cache, SymbolKind::SYM_local, n.AST_var_decl.name, n.location);
        push_symbol(res, &res.local_symbols, s_var, n);
        n.AST_var_decl.symbol => s_var;
        ast_visit_children(n, resolver_visitor, res);
    }
    else if (n.kind == AST_node::AST_symbol) {
        n.AST_symbol.symbol => resolver_lookup_symbol(res, n.AST_symbol.name, n, true);
    }
    else if (n.kind == AST_node::AST_scope) {
        resolver_enter_scope(res, n);
        ast_visit_children(n, resolver_visitor, res);
        resolver_leave_scope(res);
    }
    else if (n.kind == AST_node::AST_for) {
        resolver_enter_scope(res, n);
        ast_visit_children(n, resolver_visitor, res);
        resolver_leave_scope(res);
    }
    else if (n.kind == AST_node::AST_generic) {
        res.current_generic => n;
        res.generic_symbol => alloc_symbol(res.symbol_cache, SymbolKind::SYM_type, n.AST_generic.parameter_name, n.location);
        if (res.current_generic_type)
            res.generic_symbol.type => res.current_generic_type
        else
            res.generic_symbol.type => res.type_cache.builtin_generic;
        ast_visit_children(n, resolver_visitor, res);
        res.generic_symbol => null;
        res.current_generic => null;
    }
    else if (n.kind == AST_node::AST_arg_list
                    |== AST_node::AST_program
                    |== AST_node::AST_if
                    |== AST_node::AST_while
                    |== AST_node::AST_number
                    |== AST_node::AST_bool
                    |== AST_node::AST_null
                    |== AST_node::AST_binary
                    |== AST_node::AST_variadic_operator
                    |== AST_node::AST_unary
                    |== AST_node::AST_string
                    |== AST_node::AST_char_constant
                    |== AST_node::AST_array_access
                    |== AST_node::AST_dereference
                    |== AST_node::AST_reference
                    |== AST_node::AST_plus_plus
                    |== AST_node::AST_minus_minus
                    |== AST_node::AST_struct
                    |== AST_node::AST_member_def
                    |== AST_node::AST_member_access
                    |== AST_node::AST_namespace_access
                    |== AST_node::AST_enum
                    |== AST_node::AST_enum_member
                    |== AST_node::AST_union
                    |== AST_node::AST_union_member_def
                    |== AST_node::AST_typename
                    |== AST_node::AST_type_ref
                    |== AST_node::AST_type_array
                    |== AST_node::AST_type_slice
                    |== AST_node::AST_builder_string
                    |== AST_node::AST_user_cast
                    |== AST_node::AST_call
                    |== AST_node::AST_return
                    |== AST_node::AST_import
                    |== AST_node::AST_generic_speciation
                    |== AST_node::AST_type_generic_speciation
            )
    {
        ast_visit_children(n, resolver_visitor, res);
    }
    else NOT_IMPLEMENTED(__LOCATION__, $"Resolver for {n.kind.name}");
}

fn resolver_speciate_generic(root: AST_node&, type: Type&, symbol_cache: SymbolCache&, endlos: EndlosAllocator&) : Symbol& {
    let res: Resolver;
    res.type_cache => symbol_cache.type_cache;
    res.symbol_cache => symbol_cache;
    res.current_generic_type => type;

    EndlosArr_begin~Symbol&(res.local_symbols, endlos);
    res.locals_stack = endlos_begin~i64(endlos);

    resolve_globals_visitor(root, &res);
    resolver_visitor(root, &res);

    endlos_ripp_off~i64(endlos, res.locals_stack);
    EndlosArr_free~Symbol&(res.local_symbols, endlos);

    return res.out_latest_function;
}


fn resolver_run(root: AST_node&, symbol_cache: SymbolCache&, endlos: EndlosAllocator&) {
    let res: Resolver;
    res.type_cache => symbol_cache.type_cache;
    res.symbol_cache => symbol_cache;

    EndlosArr_begin~Symbol&(res.local_symbols, endlos);
    res.locals_stack = endlos_begin~i64(endlos);

    resolve_globals_visitor(root, res);
    resolver_visitor(root, res);

    endlos_ripp_off~i64(endlos, res.locals_stack);
    EndlosArr_free~Symbol&(res.local_symbols, endlos);
}
