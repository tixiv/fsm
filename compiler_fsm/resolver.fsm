
import * from "ast";
import * from "symbol";

fn resolver_error(n: AST_node&, s: u8[]) {
    write(2, $"[FSM Resolver] {n.location} Error: {s}\n");
    exit(1);
}

struct Resolver {
    symbol_roll: Symbol[];
    global_symbols: SymbolRefArr;
    local_symbols: SymbolRefArr;
    current_function: Symbol&;
    locals_stack: i64[];
    locals_stack_pointer : i64;
    type_cache: TypeCache&;
}

fn push_symbol(res: Resolver&, arr: SymbolRefArr&, s: Symbol&, n: AST_node&) {
    if (s.name.len) {
        let conflicting => resolver_lookup_symbol(res,  s.name, n, false);
        if (conflicting) {
            resolver_error(n, $"Symbol '{s.name}' redefined\n");
            return;
        }
    }

    SymbolRefArr_push(arr, s);
}

fn declare_builtin_fn(res: Resolver&, name :u8[], return_type: Type&, arg_types: Type&[]) : void {
    let s => alloc_symbol(res.symbol_roll, SymbolKind::SYM_function, name);
    s.type => get_function_type(res.type_cache, return_type, arg_types);
    SymbolRefArr_push(res.global_symbols, s);
}

fn init_builtin_functions(res: Resolver&) {
    let tc => res.type_cache;
    let tmp_arg_types: Type&[10];
    let tmp_args: Type&[] = tmp_arg_types;

    tmp_args.len = 1; tmp_args[0] => tc.builtin_i64;
    declare_builtin_fn(res, "exit", tc.builtin_void, tmp_args);
