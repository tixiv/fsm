
struct StructMember {
    name: u8[];
    type: Type&;
}

struct UnionMember {
    name: u8[];
    type: Type&;
    value;
}

struct EnumMember {
    name: u8[];
    value;
}

enum StructlikeKind {
    SL_struct,
    SL_record,
    SL_slice,
}

union Type enum kind {
    struct {
        name: u8[];
        storage_size;
        speciation: Type&;
    }

    struct T_void {}
    struct T_boolean {}
    struct T_null {}
    struct T_any {}

    struct T_integer {
        num_bits;
        signed: bool;
    }
    struct T_reference {
        target_type: Type&;
    }
    struct T_array {
        element_type: Type&;
        n_elements;
    }
    struct T_function {
        argument_types: Type&[];
        return_type: Type&;
    }
    struct T_struct {
        members: StructMember[];
        kind: StructlikeKind;
    }
    struct T_enum {
        members: EnumMember[];
    }
    struct T_union {
        members: UnionMember[];
        enumarator_name: u8[];
    }
    struct T_enumerator {
        target_type: Type&;
    }
    struct T_generic {
    }
}

struct TypeRefArr {
    alloc: Type&[];
    arr: Type&[];
}

fn TypeRefArr_push (arr: TypeRefArr&, s: Type&) {
    *(arr.alloc++) => s;
    arr.arr.len++;
}

fn TypeRefArr_reset (arr: TypeRefArr&, len) {
    let old_len = arr.arr.len;
    ASSERT(len <= old_len, __LOCATION__);
    arr.alloc.begin => &arr.arr[len];
    arr.alloc.len = arr.alloc.len + old_len - len;
    arr.arr.len = len;
}

fn TypeRefArr_init (arr: TypeRefArr&, endlos: EndlosAllocator&) {
    arr.alloc = endlos_begin~Type& (endlos);
    arr.arr = arr.alloc;
    arr.arr.len = 0;
}

struct TypeCache {
    type_roll: Type[];
    type_ref_roll: Type&[];
    endlos: EndlosAllocator&;

    function_types   :TypeRefArr;
    ref_types        :TypeRefArr;
    enumerator_types :TypeRefArr;
    array_types      :TypeRefArr;
    slice_types      :TypeRefArr;

    builtin_void: Type;
    builtin_null: Type;
    builtin_bool: Type;
    builtin_any: Type;
    builtin_generic: Type;
    builtin_u64: Type;
    builtin_i64: Type;
    builtin_u32: Type;
    builtin_i32: Type;
    builtin_u16: Type;
    builtin_i16: Type;
    builtin_u8: Type;
    builtin_i8: Type;
}

fn TypeCache_init(cache: TypeCache&, endlos: EndlosAllocator&) {
    cache.endlos => endlos;
    cache.type_roll = endlos_begin~Type(endlos);
    cache.type_ref_roll = endlos_begin~Type&(endlos);

    TypeRefArr_init(cache.function_types,   endlos);
    TypeRefArr_init(cache.ref_types,        endlos);
    TypeRefArr_init(cache.enumerator_types, endlos);
    TypeRefArr_init(cache.array_types,      endlos);
    TypeRefArr_init(cache.slice_types,      endlos);

    let t: Type&;
    t => cache.builtin_void;         t.kind = Type::T_void;
    t => cache.builtin_null;         t.kind = Type::T_null;
    t => cache.builtin_any;          t.kind = Type::T_any;
    t => cache.builtin_generic;      t.kind = Type::T_generic;
    t => cache.builtin_bool;         t.kind = Type::T_boolean;   t.storage_size = 1;
    t => cache.builtin_u64;          t.kind = Type::T_integer;   t.storage_size = 8; t.T_integer.signed = false;  t.T_integer.num_bits = 64;
    t => cache.builtin_i64;          t.kind = Type::T_integer;   t.storage_size = 8; t.T_integer.signed = true;   t.T_integer.num_bits = 64;
    t => cache.builtin_u32;          t.kind = Type::T_integer;   t.storage_size = 4; t.T_integer.signed = false;  t.T_integer.num_bits = 32;
    t => cache.builtin_i32;          t.kind = Type::T_integer;   t.storage_size = 4; t.T_integer.signed = true;   t.T_integer.num_bits = 32;
    t => cache.builtin_u16;          t.kind = Type::T_integer;   t.storage_size = 2; t.T_integer.signed = false;  t.T_integer.num_bits = 16;
    t => cache.builtin_i16;          t.kind = Type::T_integer;   t.storage_size = 2; t.T_integer.signed = true;   t.T_integer.num_bits = 16;
    t => cache.builtin_u8;           t.kind = Type::T_integer;   t.storage_size = 1; t.T_integer.signed = false;  t.T_integer.num_bits =  8;
    t => cache.builtin_i8;           t.kind = Type::T_integer;   t.storage_size = 1; t.T_integer.signed = true;   t.T_integer.num_bits =  8;
}

fn type_ref_roll_take (cache: TypeCache&, len) : Type&[] {
    let trr => cache.type_ref_roll;
    let taking = trr;
    taking.len = len;
    while(len--) trr++;
    return taking;
}

fn type_alloc(cache: TypeCache&, kind) : Type& {
    let t => cache.type_roll++;
    t.kind = kind;
    return t;
}

fn print_array_type(sb: StringBuilder&, arr_t: Type&) : void {
    let child_print_buf: u8[1024];

    let t => arr_t;
    while (is_array_kind(t)) t => t.T_array.element_type;

    sb_puts(sb, get_type_name_r(child_print_buf, t));

    t => arr_t;
    while (is_array_kind(t)) {
         sb_puts(sb, $"[{t.T_array.n_elements}]");
         t => t.T_array.element_type;
    }
}

fn get_type_name_r_impl(print_buf: u8[1024]&, type: Type&, encoded: bool) : u8[] {
    if (!type)                        return "(null type)";
    if (type.kind == Type::T_void)    return "void";
    if (type.kind == Type::T_null)    return "null";
    if (type.kind == Type::T_boolean) return "bool";
    if (type.kind == Type::T_any)     return "any";
    if (type.kind == Type::T_integer) {
        if (type.T_integer.num_bits == 64) return if (type.T_integer.signed) "i64" else "u64";
        if (type.T_integer.num_bits == 32) return if (type.T_integer.signed) "i32" else "u32";
        if (type.T_integer.num_bits == 16) return if (type.T_integer.signed) "i16" else "u16";
        if (type.T_integer.num_bits == 8)  return if (type.T_integer.signed)  "i8" else  "u8";
    }

    let sb: StringBuilder;
    sb_init(sb, print_buf);

    let child_print_buf: u8[1024];
    
    if (type.kind == Type::T_function) {
        sb_puts(sb, "fn (");
        let args = type.T_function.argument_types;
        for (let i = 0; i < args.len; i++) {
            sb_puts(sb, get_type_name_r(child_print_buf, args[i]));
            if (i < args.len - 1) sb_puts(sb, ", ");
        }
        sb_puts(sb, $") :{get_type_name_r(child_print_buf, type.T_function.return_type)}");
    }
    else if (type.kind == Type::T_reference) {
        sb_puts(sb, $"{get_type_name_r(child_print_buf, type.T_reference.target_type)} &");
    }
    else if (type.kind == Type::T_enumerator) {
        sb_puts(sb, $"{get_type_name_r(child_print_buf, type.T_enumerator.target_type)}::enumerator");
    }
    else if (type.kind == Type::T_array) {
        print_array_type(sb, type);
    }
    else if (type.kind == Type::T_struct) {
        if (is_slice_kind(type)) {
            sb_puts(sb, get_type_name_r_impl(child_print_buf, dereferenced_type(type.T_struct.members[0].type), encoded));
            sb_puts(sb, if (encoded) "slice" else "[]");
        }
        else {
            let kind_name = "unknown ";
            if (type.T_struct.kind == StructlikeKind::SL_struct) kind_name = "struct ";
            if (type.T_struct.kind == StructlikeKind::SL_record) kind_name = "record ";
            if (type.name.begin) {
                sb_puts(sb, if(encoded) "" else kind_name); sb_puts(sb, type.name);
            }
            else {
                sb_puts(sb, "anonymous "); sb_puts(sb, kind_name);
            }
        }
    }
    else if (type.kind == Type::T_union) {
        if (type.name.begin) {
            sb_puts(sb, $"union {type.name}");
        }
        else {
            sb_puts(sb, "anonymous union");
        }
    }
    else if (type.kind == Type::T_enum) {
        if (type.name.begin) {
            sb_puts(sb, $"enum {type.name}");
        }
        else {
            sb_puts(sb, "anonymous enum");
        }
    }
    else {
        NOT_IMPLEMENTED(__LOCATION__, $"Dumping type kind {type.kind.name} is not implemented yet.\n");
    }

    if (type.speciation)
        sb_puts(sb, $"<{get_type_name_r_impl(child_print_buf, type.speciation, encoded)}>");


    return sb.str;
}

fn get_type_name_r(print_buf: u8[1024]&, type: Type&) : u8[] {
    return get_type_name_r_impl(print_buf, type, false);
}

fn is_void_kind(t: Type&) : bool {
    return t && t.kind == Type::T_void;
}

fn is_boolean_kind(t: Type&) : bool {
    return t && t.kind == Type::T_boolean;
}

fn is_integer_kind(t: Type&) : bool {
    return t && t.kind == Type::T_integer;
}

fn is_signed_integer(t: Type&) : bool {
    return t && t.kind == Type::T_integer && t.T_integer.signed;
}

fn is_unsigned_integer(t: Type&) : bool {
    return t && t.kind == Type::T_integer && !t.T_integer.signed;
}

fn is_array_kind(t: Type&) : bool {
    return t && t.kind == Type::T_array;
}

fn is_structlike_kind(t: Type&) : bool {
    return t && t.kind == Type::T_struct;
}

fn is_struct_kind(t: Type&) : bool {
    return t && t.kind == Type::T_struct && t.T_struct.kind == StructlikeKind::SL_struct;
}

fn is_record_kind(t: Type&) : bool {
    return t && t.kind == Type::T_struct && t.T_struct.kind == StructlikeKind::SL_record;
}

fn is_slice_kind(t: Type&) : bool {
    return t && t.kind == Type::T_struct && t.T_struct.kind == StructlikeKind::SL_slice;
}

fn is_union_kind(t: Type&) : bool {
    return t && t.kind == Type::T_union;
}

fn is_enum_kind(t: Type&) : bool {
    return t && t.kind == Type::T_enum;
}

fn is_enumerator_kind(t: Type&) : bool {
    return t && t.kind == Type::T_enumerator;
}

fn is_reference_kind(t: Type&) : bool {
    return t && t.kind == Type::T_reference;
}

fn is_function_kind(t: Type&) : bool {
    return t && t.kind == Type::T_function;
}

fn is_function_reference(t: Type&) : bool {
    return is_reference_kind(t) &&
        is_function_kind(dereferenced_type(t));
}

fn get_ref_order(t: Type&) : i64 {
    return for (let ord = 0; is_reference_kind(t); ord++; ord) t => t.T_reference.target_type;
}

fn dereferenced_type(t: Type&) : Type& {
    ASSERT(is_reference_kind(t), "Tried to dereference something which is not a reference.\n");
    return t.T_reference.target_type;
}

fn get_storage_size(t: Type&) : i64 {
    return t.storage_size;
}

fn types_are_equivalent(t1: Type&, t2: Type&) : bool {
    if (<i64>t1 == <i64>t2) return true;
    if (is_integer_kind(t1) && t1.kind == t2.kind && t1.T_integer.num_bits == t2.T_integer.num_bits) return true;
    
    return false;
}

fn is_castable_to_integer(t: Type&) : bool {
    return t.kind == Type::T_integer |== Type::T_integer |== Type::T_boolean;
}

fn is_castable_to(cache: TypeCache&, to: Type&, from: Type&, ) {
    return
        if (is_integer_kind(to))
            is_castable_to_integer(from)
        else if (is_boolean_kind(to))
            from.kind == Type::T_integer |== Type::T_boolean |== Type::T_reference
        else
            to <==> get_slice_type(cache, cache.builtin_u8) && (is_record_kind(from))
}


fn get_member_offset(_struct: Type&, index) {
    ASSERT(_struct.kind == Type::T_struct,
        "get_member_offset() called on something that is not a struct or record.\n")
    ASSERT(index < _struct.T_struct.members.len, "Index out of range.\n");

    let offset = 0;
    for (let i = 0; i < index; i++) {
        let member => &_struct.T_struct.members[i];

        offset = offset + member.type.storage_size;
    }

    return offset;
}

fn get_member_type_and_offset_by_name(cache: TypeCache&, t: Type&, member_name: u8[], out_offset: i64&) : Type& {
    ASSERT(!sv_equal(member_name, "_"), "get_member_type_and_offset() called on '_'.\n" )

    if (is_reference_kind(t)) t => dereferenced_type(t);
    ASSERT(t.kind == Type::T_struct |== Type::T_union,
        "get_member_type_and_offset() called on something that is not a struct or a struct reference.\n")

    if (t.kind == Type::T_struct) {
        let offset = 0;
        for (let i = 0; i < t.T_struct.members.len; i++) {
            let member => &t.T_struct.members[i];

            if (sv_equal(&member.name, member_name)) {
                if (out_offset) out_offset = offset;
                return member.type;
            }
            offset = offset + member.type.storage_size;
        }
    }
    else if (t.kind == Type::T_union) {
        let offset = 0;
        if (t.T_union.enumarator_name.begin) {
            if (sv_equal(&t.T_union.enumarator_name, member_name)) {
                if (out_offset) *out_offset = 0;
                return get_enumerator_type_for(cache, t);
            }
            offset = offset + 8;
        }
        for (let i = 0; i < t.T_union.members.len; i++) {
            let member => t.T_union.members[i];

            if (!member.name.begin) {
                if (is_struct_kind(member.type)) {
                    let mt => get_member_type_and_offset_by_name(cache, member.type, member_name, out_offset);
                    if (mt) {
                        if (out_offset) *out_offset = *out_offset + offset;
                        return mt;
                    }
                }
                else NOT_IMPLEMENTED(__LOCATION__, "Unnanmed things in unions except structs\n")

                offset = offset + member.type.storage_size;
            }

            if (sv_equal(&member.name, member_name)) {
                if (out_offset) *out_offset = offset;
                return member.type;
            }
        }
    }

    return null;
}


fn get_enum_member_value (t: Type&, member_name: u8[], enum_value: i64&) : bool {
    for (let i = 0; i < t.T_enum.members.len; i++) {
        let member => &t.T_enum.members[i];

        if (sv_equal(&member.name, member_name)) {
            if (enum_value) *enum_value = member.value;
            return true;
        }
    }
    return false;
}

fn get_union_member_value (t: Type&, member_name: u8[], enum_value: i64&) : bool {
    for (let i = 0; i < t.T_union.members.len; i++) {
        let member => &t.T_union.members[i];

        if (sv_equal(&member.name, member_name)) {
            if (enum_value) *enum_value = member.value;
            return true;
        }
    }
    return false;
}

fn calculate_storage_size(container: Type&) : void {
    if (is_struct_kind(container) || is_slice_kind(container)) {
        let offset = 0;
        for (let i = 0; i < container.T_struct.members.len; i++) {
            let member => container.T_struct.members[i];
            offset = offset + member.type.storage_size;
        }
        container.storage_size = offset;
    }
    else if (is_record_kind(container)) {
        let offset = 0;
        for (let i = 0; i < container.T_struct.members.len; i++) {
            let member => container.T_struct.members[i];
            offset = offset + member.type.storage_size;
        }
        container.storage_size = offset;
    }
    else if (is_union_kind(container)) {
        let offset = 0;
        if (container.T_union.enumarator_name.begin) offset = offset + 8;
        let max_member_size = 0;
        for (let i = 0; i < container.T_union.members.len; i++) {
            let member => container.T_union.members[i];
            let sz = member.type.storage_size;
            if (!member.name.begin) {
                offset = offset + sz;
            }
            else {
                if (sz > max_member_size) max_member_size = sz;
            }

        }
        container.storage_size = offset + max_member_size;

    }
    else NOT_IMPLEMENTED(__LOCATION__, $"calculate_storage_size() for {container.kind.name}");
}

fn get_function_arguments_size(t: Type&) {
    if (is_reference_kind(t)) t => dereferenced_type(t);
    ASSERT(t.kind == Type::T_function,"get_function_arguments_size() called on something that is not a function.\n")
    let size = 0;
    for (let i = 0; i < t.T_function.argument_types.len; i++) {
        let arg => t.T_function.argument_types[i];
        size = size + arg.storage_size;
        if (size % 8) size = size + 8 - (size % 8);
    }
    return size;
}

fn find_type_in_array(arr: TypeRefArr&, predicate: fn (Type&, any&, any&) : bool, arg1: any&, arg2: any&) : Type& {
    for (let i = 0; i < arr.arr.len; i++)
        if (predicate(arr.arr[i], arg1, arg2))
            return arr.arr[i];
    return null;
}

fn make_ref_type_for(cache: TypeCache&, t: Type&) : Type& {
    let ref => type_alloc(cache, Type::T_reference);
    ref.T_reference.target_type => t;
    ref.storage_size = 8;
    return ref;
}

fn check_ref_type_matches(ref: Type&, target_type: Type&, _: any&) {
    return ref.T_reference.target_type <==> target_type;
}

fn get_ref_type_for(cache: TypeCache&, t: Type&) {
    let ref => find_type_in_array(cache.ref_types, check_ref_type_matches, t, null)
    if (ref) return ref;

    ref => make_ref_type_for(cache, t);
    TypeRefArr_push(cache.ref_types, ref);
    return ref;
}

fn make_enumerator_type_for(cache: TypeCache&, t: Type&) {
    let enumerator => type_alloc(cache, Type::T_enumerator);
    enumerator.T_enumerator.target_type => t;
    enumerator.storage_size = 8;
    return enumerator;
}

fn check_enumerator_type_matches(enumerator: Type&, target_type: Type&, _: any&) {
    return enumerator.T_enumerator.target_type <==> target_type;
}

fn get_enumerator_type_for(cache: TypeCache&, t: Type&) : Type& {
    let enumerator => find_type_in_array(cache.enumerator_types, check_enumerator_type_matches, t, null)
    if (enumerator) return enumerator;

    enumerator => make_enumerator_type_for(cache, t);
    TypeRefArr_push(cache.enumerator_types, enumerator);
    return enumerator;
}

fn make_array_type(cache: TypeCache&, element_type: Type&, n_elements) {
    let array_t => type_alloc(cache, Type::T_array);
    array_t.T_array.element_type => element_type;
    array_t.T_array.n_elements = n_elements;
    array_t.storage_size = element_type.storage_size * n_elements;
    return array_t;
}

fn check_array_type_matches(arr: Type&, element_type: Type&, n_elements: i64&) {
    return arr.T_array.element_type <==> element_type
          && arr.T_array.n_elements == n_elements;
}

fn get_array_type(cache: TypeCache&, element_type: Type&, n_elements) {
    let arr => find_type_in_array(cache.array_types, check_array_type_matches, element_type, n_elements);
    if (arr) return arr;

    arr => make_array_type(cache, element_type, n_elements);
    TypeRefArr_push(cache.array_types, arr);

    return arr;
}

fn make_slice_type(cache: TypeCache&, element_type: Type&) : Type& {
    let slice_t => type_alloc(cache, Type::T_struct);
    slice_t.T_struct.members.len = 2;
    slice_t.T_struct.kind = StructlikeKind::SL_slice;

    let members = endlos_begin~StructMember(cache.endlos);
    let m1 => members++;
    let m2 => members++;

    m1.type => get_ref_type_for(cache, element_type);
    m1.name = "begin";
    m2.type => cache.builtin_i64;
    m2.name = "len";

    slice_t.T_struct.members = endlos_ripp_off~StructMember(cache.endlos, members);

    calculate_storage_size(slice_t);

    return slice_t;
}

fn check_is_slice_of_type(slice: Type&, ref_type: Type&, _: any&) {
    return slice.T_struct.members[0].type <==> ref_type;
}

fn get_slice_type(cache: TypeCache&, element_type: Type&) : Type& {
    let slice => find_type_in_array(cache.slice_types, check_is_slice_of_type, get_ref_type_for(cache, element_type), null);
    if (slice) return slice;

    slice => make_slice_type(cache, element_type);
    TypeRefArr_push(cache.slice_types, slice);
    return slice;
}

fn get_slice_element_type(t: Type&) : Type& {
    ASSERT(is_slice_kind(t), "Tried to get slice element type for non slice type.\n");
    return dereferenced_type(t.T_struct.members[0].type);
}

fn check_fn_args_equal(a: Type&[], b: Type&[]) : bool {
    if (a.len != b.len) return false;
    for (let i = 0; i < a.len; i++)
        if (a[i] <!=> b[i]) return false;
    return true;
}

fn check_fn_type_matches(fn_type: Type&, ret_type: Type&, arg_types: Type&[]&) {
    return fn_type.T_function.return_type <==> ret_type
        && check_fn_args_equal(fn_type.T_function.argument_types, arg_types)
}

fn get_function_type(cache: TypeCache&, ret_type: Type&, arg_types: Type&[]) : Type& {
    let fn_type => find_type_in_array(cache.function_types, check_fn_type_matches, ret_type, arg_types);
    if (fn_type) return fn_type;

    let new_fun => type_alloc(cache, Type::T_function);
    new_fun.T_function.return_type => ret_type;
    
    let args = type_ref_roll_take(cache, arg_types.len);
    for (let i = 0; i < arg_types.len; i++)
        args[i] => arg_types[i];
    
    new_fun.T_function.argument_types = args;

    TypeRefArr_push(cache.function_types, new_fun);
    return new_fun;
}

fn get_stack_offset_for(t: Type&) {
    ASSERT(t, "get_stack_offset_for() called with nullptr.\n");
    let size = t.storage_size;

    return ((size + 7) / 8) * 8;
}

fn get_max_enum_value (t: Type&) {
    let max = -0x8000000000000000;
 
    if (is_enum_kind(t)) {
        for (let i = 0; i < t.T_enum.members.len; i++) {
            if (t.T_enum.members[i].value > max) max = t.T_enum.members[i].value;
        }
    }
    else if (is_enumerator_kind(t) && is_union_kind(t.T_enumerator.target_type)) {
        let u => t.T_enumerator.target_type;
        for (let i = 0; i < u.T_union.members.len; i++) {
            if (u.T_union.members[i].value > max) max = u.T_union.members[i].value;
        }
    } else NOT_IMPLEMENTED(__LOCATION__, "get_max_enum_value")
    return max;
}

fn get_min_enum_value (t: Type&) {
    let min = 0x7fffffffffffffff;

    if (is_enum_kind(t)) {
        for (let i = 0; i < t.T_enum.members.len; i++) {
            if (t.T_enum.members[i].value < min) min = t.T_enum.members[i].value;
        }
    }
    else if (is_enumerator_kind(t) && is_union_kind(t.T_enumerator.target_type)) {
        let u => t.T_enumerator.target_type;
        for (let i = 0; i < u.T_union.members.len; i++) {
            if (u.T_union.members[i].value < min) min = u.T_union.members[i].value;
        }
    } else NOT_IMPLEMENTED(__LOCATION__, "get_min_enum_value")

    return min;
}

fn get_enum_member_name_by_value(t: Type&, value) : u8[]& {
    if (is_enum_kind(t)) {
        for (let i = 0; i < t.T_enum.members.len; i++) {
            if (t.T_enum.members[i].value == value) return &t.T_enum.members[i].name;
        }
    }
    else if (is_enumerator_kind(t) && is_union_kind(t.T_enumerator.target_type)) {
        let u => t.T_enumerator.target_type;
        for (let i = 0; i < u.T_union.members.len; i++) {
            if (u.T_union.members[i].value == value) return &u.T_union.members[i].name;
        }
    } else NOT_IMPLEMENTED(__LOCATION__, "get_enum_member_name_by_value")

    return null;
}

fn get_builtin_type_by_name(cache: TypeCache&, name: u8[]) : Type& {
    if (sv_equal(name,"void")) return cache.builtin_void;
    if (sv_equal(name,"any")) return cache.builtin_any;
    if (sv_equal(name,"bool")) return cache.builtin_bool;
    if (sv_equal(name,"u64")) return cache.builtin_u64;
    if (sv_equal(name,"i64")) return cache.builtin_i64;
    if (sv_equal(name,"u32")) return cache.builtin_u32;
    if (sv_equal(name,"i32")) return cache.builtin_i32;
    if (sv_equal(name,"u16")) return cache.builtin_u16;
    if (sv_equal(name,"i16")) return cache.builtin_i16;
    if (sv_equal(name,"u8"))  return cache.builtin_u8;
    if (sv_equal(name,"i8"))  return cache.builtin_i8;

    return null;
}
