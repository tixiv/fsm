
import * from "std";
import * from "endlos";
import * from "tokenizer";
import * from "parser";
import * from "ast";
import * from "opcodes";
import * from "type";
import * from "common";
import * from "symbol";

struct IL_gen {
    opcodes: EndlosArr<Opcode>;
    type_cache: TypeCache&;
    generic_implementation_names: EndlosArr<u8[]>;
    num_ifs;
    num_whiles;
    num_strings;
    error_handler: ErrorHandler<AST_node&>&;
    lookup_stdlib_symbol: fn (u8[], any&) : Symbol&;
    lookup_stdlib_symbol_arg: any&;
}

fn il_gen_error(il_gen: IL_gen&, n: AST_node&, message: u8[]) {
    let eh => il_gen.error_handler;
    eh.handler("[FSM IL Gen]", n, message, eh.arg)
}

fn il_gen_warning(l: Location, s: u8[]) {
    write(2, $"[FSM IL Gen] {l.module.filename}:{l.line} Warning: {s}\n");
}

fn push_opcode_2(gen: IL_gen&, kind: OpKind, value: u8[]&, i64_value_0, i64_value_1, type: Type&, location: Location&) : Opcode& {
    let op => EndlosArr_push~Opcode(gen.opcodes);

    op.kind = kind;
    op.i64_value[0] = i64_value_0;
    op.i64_value[1] = i64_value_1;
    if (value) op.string_value = value;
    op.location => location;
    op.type => type;

    return op;
}

fn push_opcode(gen: IL_gen&, kind: OpKind, value: u8[]&, i64_value, type: Type&, location: Location&) : Opcode& {
    return push_opcode_2(gen, kind, value, i64_value, 0, type, location);
}

fn il_gen_push_symbol_address(gen: IL_gen&, s: Symbol&, n: AST_node&) {
    if (s.kind == SymbolKind::SYM_local) {
        push_opcode(gen, OpKind::OP_push_local_var_address, null, s.offset, null, n.location);
    }
    else if (s.kind == SymbolKind::SYM_arg) {
        push_opcode(gen, OpKind::OP_push_arg_address, null, s.offset, null, n.location);
    }
    else if (s.kind == SymbolKind::SYM_function) {
        push_opcode(gen, OpKind::OP_push_global_address, &s.name, 0, null, n.location);
    }
    else if (s.kind == SymbolKind::SYM_type) {
        il_gen_error(gen, n, $"Pushing type symbol '{s.name}' is not supported.");
    }
    else {
        NOT_IMPLEMENTED(__LOCATION__, $"Pushing address for symbol kind {s.kind.name}");
    }
}

fn il_gen_push_symbol(gen: IL_gen&, s: Symbol&, location: Location&) {
    if (s.kind == SymbolKind::SYM_arg) {
        push_opcode(gen, OpKind::OP_push_arg, null, s.offset, s.type, location);
    } else if (s.kind == SymbolKind::SYM_local) {
        push_opcode(gen, OpKind::OP_push_local_var, null,  s.offset, s.type, location);
    } else {
        NOT_IMPLEMENTED(__LOCATION__, $"Pushing symbol kind {s.kind.name}");
    }
}

fn gen_binary_operators(n: AST_node&, gen: IL_gen&, result_used: bool) {
    if (TokenKind::TOK_boolean_and == n.AST_binary.token_kind) {
        // short circuit logic:
        // bar = a && b; . bar = if(a) (bool)b else 0
        let if_num = gen.num_ifs++;
        gen_value_visitor(n.AST_binary.left, gen);

        push_opcode_2(gen, OpKind::OP_if, null, if_num, 1, null, n.location);
        
        if (result_used) gen_value_visitor(n.AST_binary.right, gen) else il_gen_visitor(n.AST_binary.right, gen);

        push_opcode(gen, OpKind::OP_else, null, if_num, null, n.location);
        
        if (result_used)
            push_opcode(gen, OpKind::OP_push_literal, null, 0, null, n.location);

        push_opcode(gen, OpKind::OP_end_if, null, if_num, null, n.location);
    }
    else if (TokenKind::TOK_boolean_or == n.AST_binary.token_kind) {
        // short circuit logic:
        // bar = a || b; . bar = if(a) 1 else (bool)b
        let if_num = gen.num_ifs++;
        gen_value_visitor(n.AST_binary.left, gen);

        push_opcode_2(gen, OpKind::OP_if, null, if_num, 1, null, n.location);
        
        if (result_used)
            push_opcode(gen, OpKind::OP_push_literal, null, 1, null, n.location);
        
        push_opcode(gen, OpKind::OP_else, null, if_num, null, n.location);

        if (result_used) gen_value_visitor(n.AST_binary.right, gen) else il_gen_visitor(n.AST_binary.right, gen);
        
        push_opcode(gen, OpKind::OP_end_if, null, if_num, null, n.location);
    }
    else if (TokenKind::TOK_equal_assign == n.AST_binary.token_kind || TokenKind::TOK_bind_ref == n.AST_binary.token_kind) {
        if (!n.AST_binary.left.addressable) {
            il_gen_error(gen, n, $"Trying to assign to something that is not addressable. Have {n.AST_binary.left.kind.name}.");
        }
        gen_address_visitor(n.AST_binary.left, gen);
        gen_value_visitor(n.AST_binary.right, gen);

        if (result_used)
            push_opcode(gen, OpKind::OP_store_and_dup, null, 0, n.AST_binary.left.type, n.location)
        else
            push_opcode(gen, OpKind::OP_store, null, 0, n.AST_binary.left.type, n.location)
    }
    else {
        if (result_used)
            ast_visit_children(n, gen_value_visitor, gen)
        else
            ast_visit_children(n, il_gen_visitor, gen)

        let tk = n.AST_binary.token_kind;

             if (tk == TokenKind::TOK_plus) {          if (result_used) push_opcode(gen, OpKind::OP_add,                null, 0, null, n.location); }
        else if (tk == TokenKind::TOK_minus) {         if (result_used) push_opcode(gen, OpKind::OP_sub,                null, 0, null, n.location); }
        else if (tk == TokenKind::TOK_asterisk) {      if (result_used) push_opcode(gen, OpKind::OP_mul,                null, 0, null, n.location); }
        else if (tk == TokenKind::TOK_slash) {         if (result_used) push_opcode(gen, OpKind::OP_div,                null, 0, null, n.location); }
        else if (tk == TokenKind::TOK_percent) {       if (result_used) push_opcode(gen, OpKind::OP_mod,                null, 0, null, n.location); }
        else if (tk == TokenKind::TOK_up_arrow) {      if (result_used) push_opcode(gen, OpKind::OP_ipow,               null, 0, null, n.location); }
        else if (tk == TokenKind::TOK_equal) {         if (result_used) push_opcode(gen, OpKind::OP_equal,              null, 0, null, n.location); }
        else if (tk == TokenKind::TOK_unequal) {       if (result_used) push_opcode(gen, OpKind::OP_unequal,            null, 0, null, n.location); }
        else if (tk == TokenKind::TOK_greater) {       if (result_used) push_opcode(gen, OpKind::OP_compare_GT,         null, 0, null, n.location); }
        else if (tk == TokenKind::TOK_lower) {         if (result_used) push_opcode(gen, OpKind::OP_compare_LT,         null, 0, null, n.location); }
        else if (tk == TokenKind::TOK_greater_equal) { if (result_used) push_opcode(gen, OpKind::OP_compare_GE,         null, 0, null, n.location); }
        else if (tk == TokenKind::TOK_lower_equal) {   if (result_used) push_opcode(gen, OpKind::OP_compare_LE,         null, 0, null, n.location); }
        else if (tk == TokenKind::TOK_reference_target_equal) {   if (result_used) push_opcode(gen, OpKind::OP_equal,   null, 0, null, n.location); }
        else if (tk == TokenKind::TOK_reference_target_unequal) { if (result_used) push_opcode(gen, OpKind::OP_unequal, null, 0, null, n.location); }

        else NOT_IMPLEMENTED(__LOCATION__, $"Generating IL for binary operator {n.AST_binary.token_kind.name}");
    }
}

fn gen_variadic_operator_members_and(n: AST_node&, gen: IL_gen&, i) : void {
    gen_value_visitor(n.AST_variadic_operator.members[i].right, gen);

    let tk = n.AST_variadic_operator.members[i].token_kind;
         if (tk == TokenKind::TOK_greater) {       push_opcode(gen, OpKind::OP_compare_GT, null, 1, null, n.location); }
    else if (tk == TokenKind::TOK_lower) {         push_opcode(gen, OpKind::OP_compare_LT, null, 1, null, n.location); }
    else if (tk == TokenKind::TOK_greater_equal) { push_opcode(gen, OpKind::OP_compare_GE, null, 1, null, n.location); }
    else if (tk == TokenKind::TOK_lower_equal) {   push_opcode(gen, OpKind::OP_compare_LE, null, 1, null, n.location); }
    else if (tk == TokenKind::TOK_and_not_equal_to
                |== TokenKind::TOK_unequal) {       push_opcode(gen, OpKind::OP_unequal, null, 1, null, n.location); }

    else ASSERT(false, $"{__LOCATION__} Illegal comparison operator.\n");
    
    // short circuit logic:
    let if_num = gen.num_ifs++;
    push_opcode_2(gen, OpKind::OP_if, null, if_num, 1, null, n.location);
    if (i+1 < n.AST_variadic_operator.members.len) {
        gen_variadic_operator_members_and(n, gen, i+1);
    }
    else {
        push_opcode(gen, OpKind::OP_pop, null, 0, null, n.location);
        push_opcode(gen, OpKind::OP_push_literal, null, 1, null, n.location);
    }

    push_opcode(gen, OpKind::OP_else, null, if_num, null, n.location);
    push_opcode(gen, OpKind::OP_pop, null, 0, null, n.location);
    push_opcode(gen, OpKind::OP_push_literal, null, 0, null, n.location);
    push_opcode(gen, OpKind::OP_end_if, null, if_num, null, n.location);
}

fn gen_variadic_operator_members_or(n: AST_node&, gen: IL_gen&, i) : void {
    gen_value_visitor(n.AST_variadic_operator.members[i].right, gen);

    let tk = n.AST_variadic_operator.members[i].token_kind;
    if (tk == TokenKind::TOK_equal |== TokenKind::TOK_or_equal_to) {
        push_opcode(gen, OpKind::OP_equal, null, 1, null, n.location);
    }
    else ASSERT(false, "Illegal comparison operator.\n");
    
    // short circuit logic:
    let if_num = gen.num_ifs++;
    push_opcode_2(gen, OpKind::OP_if, null, if_num, 1, null, n.location);
    push_opcode(gen, OpKind::OP_pop, null, 0, null, n.location);
    push_opcode(gen, OpKind::OP_push_literal, null, 1, null, n.location);
    push_opcode(gen, OpKind::OP_else, null, if_num, null, n.location);
    if (i+1 < n.AST_variadic_operator.members.len) {
        gen_variadic_operator_members_or(n, gen, i+1);
    }
    else
    {
        push_opcode(gen, OpKind::OP_pop, null, 0, null, n.location);
        push_opcode(gen, OpKind::OP_push_literal, null, 0, null, n.location);
    }

    push_opcode(gen, OpKind::OP_end_if, null, if_num, null, n.location);
}

fn gen_variadic_operators(n: AST_node&, gen: IL_gen&, result_used: bool) {
    let first_token = n.AST_variadic_operator.members[0].token_kind;

    if (is_comparison_operator(first_token) || first_token == TokenKind::TOK_unequal) {
        gen_value_visitor(n.AST_variadic_operator.left, gen);
        gen_variadic_operator_members_and(n, gen, 0);
    }
    else if (first_token == TokenKind::TOK_equal) {
        gen_value_visitor(n.AST_variadic_operator.left, gen);
        gen_variadic_operator_members_or(n, gen, 0);
    }
    else NOT_IMPLEMENTED(__LOCATION__, $"Generating IL for variadic operator {first_token.name}");

    if (!result_used) push_opcode(gen, OpKind::OP_pop, null, 0, null, n.location);
}

fn gen_cast(n: AST_node&, gen: IL_gen&, result_used: bool) {
    let buf_1: u8[1024]; let buf_2: u8[1024];

    let to => n.type;
    let from: Type&;

    if (n.kind == AST_node::AST_cast) {
        from => n.AST_cast.right_type;
    }
    else if (n.kind == AST_node::AST_user_cast) {
        from => n.AST_user_cast.body.type;
    }
    else {
        NOT_IMPLEMENTED(__LOCATION__, $"gen_cast for {n.kind.name}");
    }
    
    if (!result_used) {
        il_gen_error(gen, n, "Cast with unused result is not supported.");
    }

    if (is_boolean_kind(to) && is_integer_kind(from)) {
        ast_visit_children(n, gen_value_visitor, gen);
        push_opcode(gen, OpKind::OP_to_bool, null, 0, null, n.location);
    }
    else if (is_boolean_kind(to) && is_reference_kind(from)) {
        ast_visit_children(n, gen_value_visitor, gen);
        push_opcode(gen, OpKind::OP_to_bool, null, 0, null, n.location);
    }
    else if (is_integer_kind(to) && is_boolean_kind(from)) {
        ast_visit_children(n, gen_value_visitor, gen);
        // No cast needed. our 64 bit bools can be used as integer directly.
    }
    else if (is_integer_kind(to) && is_unsigned_integer(from) &&
            to.T_integer.num_bits >= from.T_integer.num_bits)
    {
        ast_visit_children(n, gen_value_visitor, gen);
        // No cast needed.
    }
    else if (is_signed_integer(to) && is_signed_integer(from)) {
        ast_visit_children(n, gen_value_visitor, gen);
        if (to.storage_size > from.storage_size)
            push_opcode(gen, OpKind::OP_sign_extend, null, 0, from, n.location);
    }
    else if (is_integer_kind(to) && is_signed_integer(from)) {
        ast_visit_children(n, gen_value_visitor, gen);
        // Just put no cast for now, let's fix potential problems later
    }
    else if (is_slice_kind(to) && get_slice_element_type(to) <==> gen.type_cache.builtin_u8 && (is_record_kind(from))) {
        push_opcode(gen, OpKind::OP_push_literal, null, get_storage_size(from), null, n.location);
        ast_visit_children(n, gen_address_visitor, gen);
    }
    else if (is_integer_kind(to) && is_reference_kind(from) && n.kind == AST_node::AST_user_cast) {
        // cast pointer to integer
        ast_visit_children(n, gen_value_visitor, gen);
    }
    else if (is_integer_kind(to) && is_enumerator_kind(from) && n.kind == AST_node::AST_user_cast) {
        // cast enumerator to integer
        ast_visit_children(n, gen_value_visitor, gen);
    }
    else if (is_integer_kind(to) && is_enum_kind(from) && n.kind == AST_node::AST_user_cast) {
        // cast enum value to integer
        ast_visit_children(n, gen_value_visitor, gen);
    }
    else if (is_reference_kind(to) && is_reference_kind(from) && n.kind == AST_node::AST_user_cast) {
        // cast one reference type to another
        ast_visit_children(n, gen_value_visitor, gen);
    }
    else if (is_reference_kind(to) && is_integer_kind(from) && n.kind == AST_node::AST_user_cast) {
        // cast integer to reference
        ast_visit_children(n, gen_value_visitor, gen);
    }
    else {
        NOT_IMPLEMENTED(__LOCATION__, $"Generating IL for cast to '{get_type_name_r(buf_1, to)}' from '{get_type_name_r(buf_2, from)}'");
    }
}

fn gen_call(n: AST_node&, gen: IL_gen&, result_used: bool) {
    if (n.AST_call.target.kind == AST_node::AST_symbol && is_function_kind(n.AST_call.target.type)) {
        let s_call => n.AST_call.target.AST_symbol.symbol;
        let name = n.AST_call.target.AST_symbol.name;
        ASSERT(s_call, $"Symbol for called function '{name}' is not resolved\n");
        ast_visit_chain(n.AST_call.args, gen_value_visitor, gen);
        if (sv_equal(name, "bittest")) {
            push_opcode(gen, OpKind::OP_bittest, null, 0, null, n.location);
        }
        else if (sv_equal(name, "bitshift")) {
            push_opcode(gen, OpKind::OP_bitshift, null, 0, null, n.location);
        }
        else if (sv_equal(name, "bitand")) {
            push_opcode(gen, OpKind::OP_bitand, null, 0, null, n.location);
        }
        else if (sv_equal(name, "bitor")) {
            push_opcode(gen, OpKind::OP_bitor, null, 0, null, n.location);
        }
        else if (sv_equal(name, "bitxor")) {
            push_opcode(gen, OpKind::OP_bitxor, null, 0, null, n.location);
        }
        else if (sv_equal(name, "bitnot")) {
            push_opcode(gen, OpKind::OP_bitnot, null, 0, null, n.location);
        }
        else if (sv_equal(name, "setbit")) {
            push_opcode(gen, OpKind::OP_setbit, null, 0, null, n.location);
        }
        else {
            push_opcode(gen, OpKind::OP_call, &name, 0, s_call.type, n.location);
            if (result_used)
                push_opcode(gen, OpKind::OP_push_result, null, 0, n.type, n.location);
        }
    }
    else if (n.AST_call.target.kind == AST_node::AST_generic_speciation
             && n.AST_call.target.AST_generic_speciation.body.kind == AST_node::AST_symbol
             && is_function_kind(n.AST_call.target.type))
    {
        let s_call => n.AST_call.target.AST_generic_speciation.body.AST_symbol.symbol;
        let name = n.AST_call.target.AST_generic_speciation.body.AST_symbol.name;
        ASSERT(s_call, $"Symbol for called function '{name}' is not resolved\n");
        ast_visit_chain(n.AST_call.args, gen_value_visitor, gen);
        push_opcode(gen, OpKind::OP_call, &name, 0, s_call.type, n.location);
        if (result_used)
            push_opcode(gen, OpKind::OP_push_result, null, 0, n.type, n.location);
    }
    else if (is_reference_kind(n.AST_call.target.type)
        && is_function_kind(dereferenced_type(n.AST_call.target.type)))
    {
        let fn_type => dereferenced_type(n.AST_call.target.type);
        ast_visit_chain(n.AST_call.args, gen_value_visitor, gen);
        gen_value_visitor(n.AST_call.target, gen);
        push_opcode(gen, OpKind::OP_icall, null, 0, fn_type, n.location);
        if (result_used)
            push_opcode(gen, OpKind::OP_push_result, null, 0, n.type, n.location);
    }
    else {
        NOT_IMPLEMENTED(__LOCATION__, "Calling something");
    }
}

fn gen_if(n: AST_node&, gen: IL_gen&, result_used: bool) {
    let if_num = gen.num_ifs++;
    gen_value_visitor(n.AST_if.condition, gen);
    push_opcode_2(gen, OpKind::OP_if, null, if_num, n.AST_if.else_clause <!=> null, null, n.location);
    if (result_used) gen_value_visitor(n.AST_if.if_clause, gen) else il_gen_visitor(n.AST_if.if_clause, gen);
    if (n.AST_if.else_clause) {
        push_opcode(gen, OpKind::OP_else, null, if_num, null, n.location);
        if (result_used) gen_value_visitor(n.AST_if.else_clause, gen) else il_gen_visitor(n.AST_if.else_clause, gen);
    }
    push_opcode(gen, OpKind::OP_end_if, null, if_num, null, n.location);
}

fn gen_plus_plus(n: AST_node&, gen: IL_gen&, result_used: bool) {
    gen_address_visitor(n.AST_plus_plus.body, gen);
    if (is_integer_kind(n.AST_plus_plus.body.type)) {
        push_opcode(gen, OpKind::OP_integer_plus_plus, null,
            if(result_used) n.AST_plus_plus.postfix + 1 else 0, n.type, n.location);
    }
    else if (is_slice_kind(n.AST_plus_plus.body.type)) {
        let element_type => get_slice_element_type(n.AST_plus_plus.body.type);
        push_opcode(gen, OpKind::OP_slice_plus_plus, null,
            if (result_used) n.AST_plus_plus.postfix + 1 else 0, element_type, n.location);
    }
    else NOT_IMPLEMENTED(__LOCATION__, "AST_plus_plus for anything that is not an integer or a slice")
}

fn gen_for(n: AST_node&, gen: IL_gen&, result_used: bool) {
    let while_num = gen.num_whiles++;
    il_gen_visitor(n.AST_for.initializer, gen);
    push_opcode(gen, OpKind::OP_while_loop, null, while_num, null, n.location);
    if (n.AST_for.condition) {
        gen_value_visitor(n.AST_for.condition, gen);
        push_opcode(gen, OpKind::OP_while_check, null, while_num, null, n.location);
    }
    il_gen_visitor(n.AST_for.body, gen);
    il_gen_visitor(n.AST_for.post_action, gen);
    push_opcode(gen, OpKind::OP_while_end, null, while_num, null, n.location);
    if (result_used) gen_value_visitor(n.AST_for.result, gen)
    else il_gen_visitor(n.AST_for.result, gen);;
}

fn gen_address_visitor(n: AST_node&, gen: IL_gen&) : void {
    if (n.kind == AST_node::AST_symbol) {
        let s => n.AST_symbol.symbol;
        ASSERT(s, $"Symbol for variable assignment to '{n.AST_symbol.name}' is not resolved\n");

        il_gen_push_symbol_address(gen, s, n);
    }
    else if (n.kind == AST_node::AST_dereference) {
        ast_visit_children(n, gen_value_visitor, gen);
    }
    else if (n.kind == AST_node::AST_generic_speciation) {
        gen_address_visitor(n.AST_generic_speciation.body, gen);
    }
    else {
        il_gen_error(gen, n, $"Trying to take the address of something for which it is not possible. Have {n.kind.name}.");
    }
}

fn gen_builder_string_put_struct (s_sb: Symbol&, arg: AST_node&, gen: IL_gen&) {
    let buf: u8[1024];

    let sb_puts_symbol => gen.lookup_stdlib_symbol("sb_puts", gen.lookup_stdlib_symbol_arg);
    let sb_puti_symbol => gen.lookup_stdlib_symbol("sb_puti", gen.lookup_stdlib_symbol_arg);

    if (!(sb_puts_symbol && sb_puti_symbol)) {
        il_gen_error(gen, arg, "Failed to find 'sb_puts' or 'sb_puti'. Are you importing \"std\"?");
        return;
    }

    let str_lbrace  = "{\n";
    let str_tab     = "    ";
    let str_colon   = " : ";
    let str_newline = "\n";
    let str_rbrace  = "}\n";

    push_opcode(gen, OpKind::OP_push_local_var_address, null, s_sb.offset, null, arg.location);
    push_opcode(gen, OpKind::OP_push_string_literal, str_lbrace, gen.num_strings++, null, arg.location);
    push_opcode(gen, OpKind::OP_call, &sb_puts_symbol.name, 0, sb_puts_symbol.type, arg.location);

    let t => arg.type;
    for (let i = 0; i < t.T_struct.members.len; i++) {
        let member => t.T_struct.members[i];
        if (!sv_equal(member.name, "_")) {
            let offset = get_member_offset(t, i);

            push_opcode(gen, OpKind::OP_push_local_var_address, null, s_sb.offset, null, arg.location);
            push_opcode(gen, OpKind::OP_push_string_literal, str_tab, gen.num_strings++, null, arg.location);
            push_opcode(gen, OpKind::OP_call, &sb_puts_symbol.name, 0, sb_puts_symbol.type, arg.location);

            push_opcode(gen, OpKind::OP_push_local_var_address, null, s_sb.offset, null, arg.location);
            push_opcode(gen, OpKind::OP_push_string_literal, &member.name, gen.num_strings++, null, arg.location);
            push_opcode(gen, OpKind::OP_call, &sb_puts_symbol.name, 0, sb_puts_symbol.type, arg.location);

            push_opcode(gen, OpKind::OP_push_local_var_address, null, s_sb.offset, null, arg.location);
            push_opcode(gen, OpKind::OP_push_string_literal, str_colon, gen.num_strings++, null, arg.location);
            push_opcode(gen, OpKind::OP_call, &sb_puts_symbol.name, 0, sb_puts_symbol.type, arg.location);

            if (is_integer_kind(member.type) || is_boolean_kind(member.type)) {
                push_opcode(gen, OpKind::OP_push_local_var_address, null, s_sb.offset, null, arg.location);
                gen_address_visitor(arg, gen);
                push_opcode(gen, OpKind::OP_push_literal, null, offset, null, arg.location);
                push_opcode(gen, OpKind::OP_add, null, 0, null, arg.location);
                push_opcode(gen, OpKind::OP_load, null, 0, member.type, arg.location);
                push_opcode(gen, OpKind::OP_call, &sb_puti_symbol.name, 0, sb_puti_symbol.type, arg.location);
            }
            else if (is_slice_kind(member.type) && get_slice_element_type(member.type) <==> gen.type_cache.builtin_u8) {
                push_opcode(gen, OpKind::OP_push_local_var_address, null, s_sb.offset, null, arg.location);
                gen_address_visitor(arg, gen);
                push_opcode(gen, OpKind::OP_push_literal, null, offset, null, arg.location);
                push_opcode(gen, OpKind::OP_add, null, 0, null, arg.location);
                push_opcode(gen, OpKind::OP_load, null, 0, member.type, arg.location);
                push_opcode(gen, OpKind::OP_call, &sb_puts_symbol.name, 0, sb_puts_symbol.type, arg.location);
            }
            else NOT_IMPLEMENTED(__LOCATION__, $"Printing {get_type_name_r(buf, member.type)} inside a struct or record in builder string");
            
            push_opcode(gen, OpKind::OP_push_local_var_address, null, s_sb.offset, null, arg.location);
            push_opcode(gen, OpKind::OP_push_string_literal, str_newline, gen.num_strings++, null, arg.location);
            push_opcode(gen, OpKind::OP_call, &sb_puts_symbol.name, 0, sb_puts_symbol.type, arg.location);
        }
    }

    push_opcode(gen, OpKind::OP_push_local_var_address, null, s_sb.offset, null, arg.location);
    push_opcode(gen, OpKind::OP_push_string_literal, str_rbrace, gen.num_strings++, null, arg.location);
    push_opcode(gen, OpKind::OP_call, &sb_puts_symbol.name, 0, sb_puts_symbol.type, arg.location);
}

fn gen_builder_string (n: AST_node&, gen: IL_gen&) {
    let buf: u8[1024];
    let s_sb => n.AST_builder_string.var_decl_sb.AST_symbol.symbol;
    let s_arr => n.AST_builder_string.var_decl_arr.AST_symbol.symbol;
    let sb_init_symbol => gen.lookup_stdlib_symbol("sb_init", gen.lookup_stdlib_symbol_arg);
    let sb_puts_symbol => gen.lookup_stdlib_symbol("sb_puts", gen.lookup_stdlib_symbol_arg);
    let sb_puti_symbol => gen.lookup_stdlib_symbol("sb_puti", gen.lookup_stdlib_symbol_arg);
    
    if (!(sb_init_symbol && sb_puts_symbol && sb_puti_symbol)) {
        il_gen_error(gen, n, "Failed to find 'sb_init' or 'sb_puts' or 'sb_puti' which are required to implement builder string. Are you importing \"std\"?");
        return;
    }

    push_opcode(gen, OpKind::OP_push_local_var_address, null, s_sb.offset, null, n.location);
    push_opcode(gen, OpKind::OP_push_literal, null, 1024, null, n.location);
    push_opcode(gen, OpKind::OP_push_local_var_address, null, s_arr.offset, null, n.location);
    push_opcode(gen, OpKind::OP_call, &sb_init_symbol.name, 0, sb_init_symbol.type, n.location);

    for (let arg => n.AST_builder_string.body; arg; arg => arg.next) {
        if (is_slice_kind(arg.type) && get_slice_element_type(arg.type) <==> gen.type_cache.builtin_u8) {
            push_opcode(gen, OpKind::OP_push_local_var_address, null, s_sb.offset, null, n.location);
            gen_value_visitor(arg, gen);
            push_opcode(gen, OpKind::OP_call, &sb_puts_symbol.name, 0, sb_puts_symbol.type, n.location);
        }
        else if (is_integer_kind(arg.type)) {
            push_opcode(gen, OpKind::OP_push_local_var_address, null, s_sb.offset, null, n.location);
            gen_value_visitor(arg, gen);
            push_opcode(gen, OpKind::OP_call, &sb_puti_symbol.name, 0, sb_puti_symbol.type, n.location);
        }
        else if (is_struct_kind(arg.type) || is_record_kind(arg.type)){
            gen_builder_string_put_struct(s_sb, arg, gen);
        }
        else NOT_IMPLEMENTED("Generating IL for type %s in builder string is not implemented yet.\n", get_type_name_r(buf, arg.type));
    }

    push_opcode(gen, OpKind::OP_push_local_var_address, null, s_sb.offset, null, n.location);
    push_opcode(gen, OpKind::OP_member_access, null, 16, null, n.location);
    push_opcode(gen, OpKind::OP_load, null, 0, get_slice_type(gen.type_cache, gen.type_cache.builtin_u8), n.location);
}

fn gen_value_visitor(n: AST_node&, gen: IL_gen&) : void {
    let buf: u8[1024];
    if (!n) return;
    if (n.kind == AST_node::AST_call) {
        gen_call(n, gen, true);
    }

    else if (n.kind == AST_node::AST_number) {
        push_opcode(gen, OpKind::OP_push_literal, &n.AST_number.value, 0, null, n.location);
    }

    else if (n.kind == AST_node::AST_bool) {
        push_opcode(gen, OpKind::OP_push_literal, null, n.AST_bool.value, null, n.location);
    }

    else if (n.kind == AST_node::AST_null) {
        push_opcode(gen, OpKind::OP_push_literal, null, 0, null, n.location);
    }

    else if (n.kind == AST_node::AST_array_len) {
        push_opcode(gen, OpKind::OP_push_literal, null, n.AST_array_len.len, null, n.location);
    }
    
    else if (n.kind == AST_node::AST_symbol) {
        let s => n.AST_symbol.symbol;
        ASSERT(s, __LOCATION__);
        il_gen_push_symbol(gen, s, n.location);
    }

    else if (n.kind == AST_node::AST_binary) {
        gen_binary_operators(n, gen, true);
    }

    else if (n.kind == AST_node::AST_variadic_operator) {
        gen_variadic_operators(n, gen, true);
    }

    else if (n.kind == AST_node::AST_if) {
        gen_if(n, gen, true);
    }

    else if (n.kind == AST_node::AST_for) {
        gen_for(n, gen, true);
    }

    else if (n.kind == AST_node::AST_user_cast
                   |== AST_node::AST_cast)
    {
        gen_cast(n, gen, true);
    }
    
    else if (n.kind == AST_node::AST_unary) {
        ast_visit_children(n, gen_value_visitor, gen);
             if (n.AST_unary.token_kind == TokenKind::TOK_exclam) push_opcode(gen, OpKind::OP_not, null, 0, null, n.location)
        else if (n.AST_unary.token_kind == TokenKind::TOK_minus) push_opcode(gen, OpKind::OP_neg, null, 0, null, n.location)
        else NOT_IMPLEMENTED(__LOCATION__, $"Generating IL for unary operator {token_kind_printable(n.AST_unary.token_kind)}");
    }

    else if (n.kind == AST_node::AST_array_to_slice) {
        push_opcode(gen, OpKind::OP_push_literal, null, n.AST_array_to_slice.body.type.T_array.n_elements, null, n.location);
        gen_address_visitor(n.AST_array_to_slice.body, gen);
    }
    
    else if (n.kind == AST_node::AST_string) {
        push_opcode(gen, OpKind::OP_push_string_literal, &n.AST_string.value, gen.num_strings++, null, n.location);
    }

    else if (n.kind == AST_node::AST_char_constant) {
        push_opcode(gen, OpKind::OP_push_char_literal, &n.AST_char_constant.value, 0, null, n.location);
    }

    else if (n.kind == AST_node::AST_dereference) {
        let size = get_storage_size(n.type);
        if (size > 16) il_gen_error(gen, n, $"Can't dereference something with storage size > 16. Have {size}.");
        ast_visit_children(n, gen_value_visitor, gen);
        push_opcode(gen, OpKind::OP_load, null, 0, n.type, n.location);
    }

    else if (n.kind == AST_node::AST_reference) {
        ast_visit_children(n, gen_address_visitor, gen);
    }

    else if (n.kind == AST_node::AST_array_access) {
        if (is_array_kind(n.AST_array_access.array.type)) {
            gen_address_visitor(n.AST_array_access.array, gen);
            gen_value_visitor(n.AST_array_access.index, gen);
            push_opcode(gen, OpKind::OP_array_access, null, 0, n.AST_array_access.array.type.T_array.element_type, n.location);
        }
        else if (is_slice_kind(n.AST_array_access.array.type)) {
            gen_address_visitor(n.AST_array_access.array, gen);
            push_opcode(gen, OpKind::OP_load, null, 0, get_ref_type_for(gen.type_cache, gen.type_cache.builtin_any), n.location); // load the 'begin' member
            gen_value_visitor(n.AST_array_access.index, gen);
            push_opcode(gen, OpKind::OP_array_access, null, 0, get_slice_element_type(n.AST_array_access.array.type), n.location);
        }
        else NOT_IMPLEMENTED(__LOCATION__, "AST_array_access for anything that is not an array or a slice")

    }
    
    else if (n.kind == AST_node::AST_plus_plus) {
        gen_plus_plus(n, gen, true);
    }

    else if (n.kind == AST_node::AST_minus_minus) {
        gen_address_visitor(n.AST_minus_minus.body, gen);
        push_opcode(gen, OpKind::OP_integer_minus_minus, null, n.AST_minus_minus.postfix + 1, n.type, n.location);
    }


    else if (n.kind == AST_node::AST_member_access) {
        let t => n.AST_member_access.body.type;
        if (is_reference_kind(t) && (is_structlike_kind(dereferenced_type(t))
                                    || is_union_kind(dereferenced_type(t)))) {
            ast_visit_children(n, gen_value_visitor, gen);
            push_opcode(gen, OpKind::OP_member_access, null, n.AST_member_access.offset, t, n.location);
        }
        else if (is_enum_kind(t)) {
            ast_visit_children(n, gen_value_visitor, gen);
            push_opcode(gen, OpKind::OP_get_enum_member_name, null, 0, t, n.location);
        }
        else if (is_enumerator_kind(t)) {
            ast_visit_children(n, gen_value_visitor, gen);
            push_opcode(gen, OpKind::OP_get_enum_member_name, null, 0, t, n.location);
        }
        else NOT_IMPLEMENTED("Member acces for type %s is not implemented yet.\n",
            get_type_name_r(buf, t));
    }
    else if (n.kind == AST_node::AST_namespace_access) {
        if (is_enum_kind(n.type)) {
            push_opcode(gen, OpKind::OP_push_literal, null, n.AST_namespace_access.enum_value, null, n.location);
        }
        else if (is_enumerator_kind(n.type)) {
            push_opcode(gen, OpKind::OP_push_literal, null, n.AST_namespace_access.enum_value, null, n.location);
        }
        else NOT_IMPLEMENTED(__LOCATION__, $"Generating IL for namespace acces for type {get_type_name_r(buf, n.type)}");
    }

    else if (n.kind == AST_node::AST_builder_string) {
        gen_builder_string(n, gen);
    }
    
    else if (n.kind == AST_node::AST_typename
                   |== AST_node::AST_type_ref)
    {
        // Nothing to be done
    }

    else {
        NOT_IMPLEMENTED(__LOCATION__, $"gen_value_visitor for {n.kind.name}");
    }
}


fn il_gen_visitor(n: AST_node&, gen: IL_gen&) : void {
    if (!n) return;
    // $"il_gen_visitor {n.kind.name}\n"

    if (n.kind == AST_node::AST_function) {
        let s_fun => n.AST_function.symbol;
        ASSERT(s_fun, __LOCATION__);
        push_opcode(gen, OpKind::OP_begin_fn, &n.AST_function.name, s_fun.size, s_fun.type, n.location);
        ast_visit_children(n, il_gen_visitor, gen);
    }

    else if (n.kind == AST_node::AST_return) {
        ast_visit_children(n, gen_value_visitor, gen);
        let ret_type => if(n.AST_return.body) n.AST_return.body.type else &gen.type_cache.builtin_void;
        push_opcode(gen, OpKind::OP_return, null, 0, ret_type, n.location);
    }
    
    else if (n.kind == AST_node::AST_if) {
        gen_if(n, gen, false);
    }

    else if (n.kind == AST_node::AST_while) {
        let while_num = gen.num_whiles++;
        push_opcode(gen, OpKind::OP_while_loop, null, while_num, null, n.location);
        gen_value_visitor(n.AST_while.condition, gen);
        push_opcode(gen, OpKind::OP_while_check, null, while_num, null, n.location);
        il_gen_visitor(n.AST_while.body, gen);
        push_opcode(gen, OpKind::OP_while_end, null, while_num, null, n.location);
    }

    else if (n.kind == AST_node::AST_for) {
        gen_for(n, gen, false);
    }

    else if (n.kind == AST_node::AST_arg_decl) {
        // Nothing to do here for an arg decl, as it can't have an initializer
    }

    else if (n.kind == AST_node::AST_var_decl) {
        if (n.AST_var_decl.initializer) {
            il_gen_push_symbol_address(gen, n.AST_var_decl.symbol, n);                
            gen_value_visitor(n.AST_var_decl.initializer, gen);
            push_opcode(gen, OpKind::OP_store, null, 0, n.AST_var_decl.symbol.type, n.location);
        }
    }

    else if (n.kind == AST_node::AST_call) {
        gen_call(n, gen, false);
    }
    
    else if (n.kind == AST_node::AST_binary) {
        gen_binary_operators(n, gen, false);
    }
    
    else if (n.kind == AST_node::AST_plus_plus) {
        gen_plus_plus(n, gen, false);
    }

    else if (n.kind == AST_node::AST_minus_minus) {
        gen_address_visitor(n.AST_minus_minus.body, gen);
        push_opcode(gen, OpKind::OP_integer_minus_minus, null, 0, n.type, n.location);
    }

    else if (n.kind == AST_node::AST_dereference
                    |== AST_node::AST_member_access
                    |== AST_node::AST_reference
                    |== AST_node::AST_symbol
                    |== AST_node::AST_string)
    {
        il_gen_warning(n.location, "unused code.");
        ast_visit_children(n, il_gen_visitor, gen);
    }
    
    else if (n.kind == AST_node::AST_generic) {
        // Don't generate code for generic functions.
        // Their implementations for specific types live outside of generic blocks.
    }
    else if (n.kind == AST_node::AST_generic_implementation) {
        let body => n.AST_generic_implementation.body;
        if (body.kind == AST_node::AST_function) {
            let name = body.AST_function.name;
            let names = gen.generic_implementation_names.arr;
            let exists = false;
            for (let i = 0; i < names.len; i++) {
                if (sv_equal(names[i], name)) exists = true;
            }
            if (!exists) {
                EndlosArr_push~u8[](gen.generic_implementation_names) = name;
                ast_visit_children(n, il_gen_visitor, gen);
            }
        } else {
            NOT_IMPLEMENTED(__LOCATION__, "Generic implementation for other than functions");
        }
    }
    else if (n.kind == AST_node::AST_cast
                    |== AST_node::AST_number
                    |== AST_node::AST_arg_list
                    |== AST_node::AST_program
                    |== AST_node::AST_scope
                    |== AST_node::AST_struct
                    |== AST_node::AST_member_def
                    |== AST_node::AST_typename
                    |== AST_node::AST_type_ref
                    |== AST_node::AST_type_array
                    |== AST_node::AST_type_slice
                    |== AST_node::AST_function_type
                    |== AST_node::AST_enum
                    |== AST_node::AST_enum_member
                    |== AST_node::AST_union
                    |== AST_node::AST_union_member_def
                    |== AST_node::AST_type_generic_speciation
                    |== AST_node::AST_import)
    {
        ast_visit_children(n, il_gen_visitor, gen);
    }
    else {
        NOT_IMPLEMENTED(__LOCATION__, $" {n.location.module.filename}:{n.location.line} il_gen_visitor for {n.kind.name}");
    }
}

fn il_gen_run (gen: IL_gen&, root: AST_node&) : void {
    il_gen_visitor(root, gen);
}
