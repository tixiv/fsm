
import * from "std";
import * from "common";
import * from "tokenizer";
import * from "type";

enum OpKind {
    OP_begin_fn,
    OP_return,
    OP_add,
    OP_sub,
    OP_mul,
    OP_div,
    OP_mod,
    OP_ipow,
    OP_equal,
    OP_unequal,
    OP_not,
    OP_neg,
    OP_compare_GT,
    OP_compare_LT,
    OP_compare_GE,
    OP_compare_LE,
    OP_call,
    OP_icall,
    OP_push_result,
    OP_push_arg,
    OP_push_literal,
    OP_push_string_literal,
    OP_push_char_literal,
    OP_push_local_var,
    OP_push_local_var_address,
    OP_push_arg_address,
    OP_push_global_address,
    OP_if,
    OP_else,
    OP_end_if,
    OP_while_loop,
    OP_while_check,
    OP_while_end,
    OP_to_bool,
    OP_sign_extend,
    OP_array_access,
    OP_member_access,
    OP_load,
    OP_store,
    OP_store_and_dup,
    OP_integer_plus_plus,
    OP_integer_minus_minus,
    OP_slice_plus_plus,
    OP_dyn_arr_plus_plus,
    OP_bittest,
    OP_bitshift,
    OP_bitand,
    OP_bitor,
    OP_bitxor,
    OP_bitnot,
    OP_setbit,
    OP_pop,
    OP_get_enum_member_name,
    OP_dyn_arr_to_slice,
    OP_if_equal,
    OP_nop,
}


struct Opcode {
    kind: OpKind;
    string_value: u8[];
    type: Type&;
    i64_value: u64[2];
    location: Location&;
}

fn dump_opcodes(opcodes: Opcode[]) {
    let buf: u8[1024];
    for (let i = 0; i < opcodes.len; i++) {
        let op => opcodes[i];
        if (op.string_value.begin) {
            $"[{op.kind.name}, \"{op.string_value}\", {op.i64_value[0]}, {op.i64_value[1]}, {get_type_name_r(buf, op.type)}]\n";
        } else {
            $"[{op.kind.name}, {op.i64_value[0]}, {op.i64_value[1]}, {get_type_name_r(buf, op.type)}]\n";
        }
    }
}
