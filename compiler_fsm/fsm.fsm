struct ErrorHandlerArgs {
    stop_on_error: bool;
}

fn error_handler_location(facility: u8[], location: Location&, message: u8[], args: ErrorHandlerArgs&) {
    $"{facility} {location.module.filename}:{location.line}:{location.col} Error: ";
    puts(message);
    putc('\n');
    if (!args || args.stop_on_error)
        exit(1);
}

fn error_handler_ast_node(facility: u8[], n: AST_node&, message: u8[], args: ErrorHandlerArgs&) {
    $"{facility} {n.location.module.filename}:{n.location.line}:{n.location.col} Error: ";
    puts(message);
    putc('\n');
    if (!args || args.stop_on_error)
        exit(1);
}

fn get_path(filename: u8[]) : u8[] {
    let path = filename;
    for (let i = filename.len - 1; i >= 0; i--) {
        if (filename[i] == '/') {
            path.len = i + 1
            return path;
        }
    }
    path.len = 0;
    return path;
}

fn find_file(sb: StringBuilder&, name: u8[], parent_module_filename: u8[]) : bool {
    let R_OK = 4;

    // try current directory
    sb_puts(sb, $"{name}.fsm\0");
    if (access(sb.str.begin, R_OK) == 0) return true;

    // search the path of the parent module
    sb_reset(sb);
    let path = get_path(parent_module_filename);
    sb_puts(sb, $"{path}{name}.fsm\0");
    if (access(sb.str.begin, R_OK) == 0) return true;

    // search standard library
    sb_reset(sb);
    sb_puts(sb, $"stdlib/{name}.fsm\0");
    if (access(sb.str.begin, R_OK) == 0) return true;
    
    sb_reset(sb);
    return false;
}

struct FsmOptions {
    dump_ast;
    continue_after_error: bool;
    verbose: bool;
}

struct ModuleWalker {
    modules: EndlosArr<Module>;
    endlos: EndlosAllocator&;
    type_cache: TypeCache&;
    error_handler_location: ErrorHandler<Location&>;
    error_handler_ast_node: ErrorHandler<AST_node&>;
    current_imports: Import[];
    builtin_symbols: Symbol[];
    error_handler_args: ErrorHandlerArgs;
    options: FsmOptions&;
}

fn tokenize_module (mw: ModuleWalker&, module: Module&, code: u8[], endlos: EndlosAllocator&) {
    let tokenizer: Tokenizer;

    tokenizer.code = code;
    tokenizer.location.module => module.header;
    tokenizer.location.line = 1;
    tokenizer.tokens = endlos_begin~Token(endlos);
    tokenizer.error_handler => mw.error_handler_location;

    tokenize_fsm(tokenizer);

    return endlos_ripp_off~Token(endlos, tokenizer.tokens);
}

fn find_already_compiled(mw: ModuleWalker&, import_filename : u8[]) : Module&{
    for (let i = 0; i < mw.modules.arr.len; i++) {
        if (sv_equal(import_filename, mw.modules.arr[i].header.filename))
            return mw.modules.arr[i];
    }
    return null;
}

fn lookup_builtin_symbol(name: u8[], mw: ModuleWalker&) {
    let symbols => mw.builtin_symbols;
    for (let i = 0; i < symbols.len; i++) {
        if (sv_equal (symbols[i].name, name)) return &symbols[i];
    }
    return null;
}

fn lookup_symbol_from_module(name: u8[], module: Module&) : Symbol& {
    let symbols => module.global_symbols;
    for (let j = 0; j < symbols.len; j++) {
        if (sv_equal (symbols[j].name, name)) return symbols[j];
    }
    return null;
}

fn lookup_stdlib_symbol(name: u8[], mw: ModuleWalker&) : Symbol& {
    for (let i = 0; i < mw.modules.arr.len; i++) {
        let filename = mw.modules.arr[i].header.filename;
        if (sv_ends_with(filename, "stdlib/std.fsm")) {
            return lookup_symbol_from_module(name, mw.modules.arr[i]);
        }
    }
    return null;
}

fn lookup_external_symbol(name: u8[], mw: ModuleWalker&) : Symbol& {
    let sym => lookup_builtin_symbol(name, mw);
    if (sym) return sym;

    for (let i = 0; i < mw.current_imports.len; i++) {
        sym => lookup_symbol_from_module(name, mw.current_imports[i].module);
        if (sym) return sym;
    }
    return null;
}

fn compile_module (mw: ModuleWalker&, filename: u8[]) : Module& {
    let module => EndlosArr_push~Module(mw.modules);

    module.header.filename = filename

    if (mw.options.verbose) $"Reading '{filename}'\n"
    let code = read_file (filename);

    if (mw.options.verbose) $"Tokenizing {endlos_rolls_in_use(mw.endlos)}...\n"
    let tokens = tokenize_module(mw, module, code, mw.endlos);
    if (mw.options.verbose) $"Tokenizing finished {endlos_rolls_in_use(mw.endlos)}\n"

    // dump_tokens(module.tokens);

    let ast_allocator: AST_Node_Allocator;
    AST_Node_Allocator_init(ast_allocator, mw.endlos);

    if (mw.options.verbose) $"Parsing {endlos_rolls_in_use(mw.endlos)} ...\n"
    let root => parse_program(tokens, ast_allocator, mw.endlos, mw.error_handler_location)
    if (mw.options.verbose) $"Parsing finished {endlos_rolls_in_use(mw.endlos)} \n"

    if (mw.options.dump_ast == 1) ast_dump_tree (root);

    let imports = gather_imports(root, mw.endlos);

    for (let i = 0; i < imports.len; i++) {
        let imp => imports[i];

        let sb: StringBuilder;
        sb_init(sb, endlos_begin~u8(mw.endlos));
        let res = find_file(sb, imp.name, filename);
        let import_filename = endlos_ripp_off~u8(mw.endlos, sb.buffer);
        
        if (res) {
            import_filename.len--; // make the terminating 0 for C invisible to FSM
            let compiled_module => find_already_compiled(mw, import_filename);
            if (!compiled_module)
                compiled_module => compile_module(mw, import_filename);
            imp.module => compiled_module;
        }
        else {
            write(2, $"[FSM Modulizer] {filename}:{imp.location.line} Error: couldn't find import '{imp.name}'.\n")
            exit(1);
        }
    }

    mw.current_imports = imports;

    let symbol_cache: SymbolCache;
    SymbolCache_init(symbol_cache, mw.type_cache, mw.endlos, lookup_external_symbol, mw);

    if (mw.options.verbose) $"Type Resolver {endlos_rolls_in_use(mw.endlos)} ...\n"
    type_resolver_run(root, symbol_cache, mw.endlos, mw.error_handler_ast_node);
    if (mw.options.verbose) $"Type Resolver finished  {endlos_rolls_in_use(mw.endlos)} \n"

    if (mw.options.verbose) $"Resolver  {endlos_rolls_in_use(mw.endlos)} ...\n"
    resolver_run(root, symbol_cache, mw.endlos, mw.error_handler_ast_node);
    if (mw.options.verbose) $"Resolver finished {endlos_rolls_in_use(mw.endlos)} \n"

    if (mw.options.dump_ast == 2) ast_dump_tree (root);
    
    if (mw.options.verbose) $"Going to run type checker {endlos_rolls_in_use(mw.endlos)} ...\n"
    type_checker_run(root, symbol_cache, ast_allocator, mw.endlos, mw.error_handler_ast_node);
    if (mw.options.verbose) $"Finished type checking. {endlos_rolls_in_use(mw.endlos)}\n"

    AST_Node_Allocator_finalize(ast_allocator, mw.endlos);

    if (mw.options.dump_ast == 3) ast_dump_tree (root);

    calculate_stacks(root, mw.endlos);

    module.symbols = endlos_ripp_off~Symbol(mw.endlos, symbol_cache.symbol_roll);
    module.global_symbols = EndlosArr_finalize~Symbol&(symbol_cache.global_symbols, mw.endlos);
    module.ast_root => root;
    return module;
}

fn compile_program(initial_filename: u8[], options: FsmOptions&) {

    let endlos: EndlosAllocator;
    endlos_root_init(endlos, 128, 1024 * 1024 * 64);

    let type_cache: TypeCache;
    TypeCache_init(type_cache, endlos)

    let mw: ModuleWalker;
    mw.endlos => endlos;
    mw.type_cache => type_cache;
    mw.builtin_symbols = make_builtin_symbols(type_cache, endlos);
    mw.error_handler_args.stop_on_error = !options.continue_after_error;
    mw.error_handler_location.handler => error_handler_location;
    mw.error_handler_location.arg => mw.error_handler_args;
    mw.error_handler_ast_node.handler => error_handler_ast_node;
    mw.error_handler_ast_node.arg => mw.error_handler_args;
    mw.options => options;
    EndlosArr_begin~Module(mw.modules, endlos);

    compile_module(mw, initial_filename);

    let compiled_modules = EndlosArr_finalize~Module(mw.modules, endlos);

    if (mw.options.verbose) $"Going to run il gen...\n"

    let gen: IL_gen;
    gen.type_cache => type_cache;
    gen.lookup_stdlib_symbol => lookup_stdlib_symbol;
    gen.lookup_stdlib_symbol_arg => mw;
    gen.error_handler => mw.error_handler_ast_node;
    EndlosArr_begin~Opcode(gen.opcodes, endlos);
    EndlosArr_begin~u8[](gen.generic_implementation_names, endlos);

    for (let i = 0; i < compiled_modules.len; i++) {
        il_gen_run(gen, compiled_modules[i].ast_root);
    }
    EndlosArr_free~u8[](gen.generic_implementation_names, endlos);
    let opcodes = EndlosArr_finalize~Opcode(gen.opcodes, endlos);

    if (mw.options.verbose) $"il gen finished\n"

    // dump_opcodes(opcodes);

    output_asm("out1.asm", opcodes, endlos);
}

fn print_help () {
    write (2,
"Usage: fsm [options] <input_file.fsm>
  -c     Continue after errors occurred
  -v     Verbose information about compile steps
  -a<n>  Dump the AST tree at different points during the compilation
");
}


fn main (argv: u8&[]) {
    let arg_input_file: u8[];
    let continue_after_error = false;

    let options: FsmOptions;

    for (let i = 1; i < argv.len; i++)  {
        let arg = sv_of_c_string(argv[i]);
        if (arg.begin == '-') {
            if (sv_equal(arg, "-c")) {
                options.continue_after_error = true;
            }
            else if (sv_equal(arg, "-v")) {
                options.verbose = true;
            }
            else if (sv_starts_with(arg, "-a")) {
                options.dump_ast = parse_integer(sv_skip(arg, 2));
            }
            else if (sv_starts_with(arg, "--help")) {
                print_help();
                exit(0);
            }
            else {
                write (2, $"fsm: Unknown option '{arg}'. Use --help for options.\n")
                exit (1);
            }
        }
        else {
            arg_input_file = arg;
        }
    }

    if (!arg_input_file.len) {
        write(2, $"fsm: No input file.\n");
        exit(1);
    } 
    
    compile_program(arg_input_file, options);
}
