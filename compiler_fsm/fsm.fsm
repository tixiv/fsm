
import * from "endlos";
import * from "parser";
import * from "symbol_cache";
import * from "module";
import * from "gather_imports";
import * from "type_resolver";
import * from "resolver";
import * from "il_gen";
import * from "type_checker";
import * from "calculate_stacks";
import * from "il_gen";
import * from "generator";


fn error_handler_location(facility: u8[], location: Location&, message: u8[]) {
    $"{facility} {location.module.filename}:{location.line}:{location.col} Error: ";
    puts(message);
    putc('\n');
    puts("I'm da new error handler for locations!\n");
    exit(1);
}

fn error_handler_ast_node(facility: u8[], n: AST_node&, message: u8[]) {
    $"{facility} {n.location.module.filename}:{n.location.line}:{n.location.col} Error: ";
    puts(message);
    putc('\n');
    puts("I'm da new error handler for AST nodes!\n");
    exit(1);
}

fn tokenize_module (module: Module&, code: u8[], endlos: EndlosAllocator&) {
    let tokenizer: Tokenizer;

    tokenizer.code = code;
    tokenizer.location.module => module.header;
    tokenizer.location.line = 1;
    tokenizer.tokens = endlos_begin~Token(endlos);
    tokenizer.error_handler => error_handler_location;

    tokenize_fsm(tokenizer);

    module.tokens = endlos_ripp_off~Token(endlos, tokenizer.tokens);

    // dump_tokens(module.tokens);
}

fn get_path(filename: u8[]) : u8[] {
    let path = filename;
    for (let i = filename.len - 1; i >= 0; i--) {
        if (filename[i] == '/') {
            path.len = i + 1
            return path;
        }
    }
    path.len = 0;
    return path;
}

fn find_file(sb: StringBuilder&, name: u8[], parent_module_filename: u8[]) : bool {
    let R_OK = 4;

    // try current directory
    sb_puts(sb, $"{name}.fsm\0");
    if (access(sb.str.begin, R_OK) == 0) return true;

    // search the path of the parent module
    sb_reset(sb);
    let path = get_path(parent_module_filename);
    sb_puts(sb, $"{path}{name}.fsm\0");
    if (access(sb.str.begin, R_OK) == 0) return true;

    // search standard library
    sb_reset(sb);
    sb_puts(sb, $"stdlib/{name}.fsm\0");
    if (access(sb.str.begin, R_OK) == 0) return true;
    
    sb_reset(sb);
    return false;
}


struct ModuleWalker {
    modules: EndlosArr<Module>;
    ast_allocator: AST_Node_Allocator&;
    endlos: EndlosAllocator&;
    symbol_cache: SymbolCache&;
}

fn already_compiled(mw: ModuleWalker&, import_filename : u8[]) {
    for (let i = 0; i < mw.modules.arr.len; i++) {
        if (sv_equal(import_filename, mw.modules.arr[i].header.filename))
            return true;
    }
    return false;
}

fn compile_module (mw: ModuleWalker&, filename: u8[]) : void {
    let verbose = false;

    let module => EndlosArr_push~Module(mw.modules);

    module.header.filename = filename

    if (verbose) $"Reading '{filename}'\n"
    let code = read_file (filename);

    if (verbose) $"Tokenizing {endlos_rolls_in_use(mw.endlos)}...\n"
    tokenize_module(module, code, mw.endlos);
    if (verbose) $"Tokenizing finished {endlos_rolls_in_use(mw.endlos)}\n"

    if (verbose) $"Parsing {endlos_rolls_in_use(mw.endlos)} ...\n"
    let root => parse_program(module.tokens, mw.ast_allocator, mw.endlos, error_handler_location)
    if (verbose) $"Parsing finished {endlos_rolls_in_use(mw.endlos)} \n"

    let imports = gather_imports(root, mw.endlos);

    for (let i = 0; i < imports.len; i++) {
        let imp => imports[i];

        let sb: StringBuilder;
        sb_init(sb, endlos_begin~u8(mw.endlos));
        let res = find_file(sb, imp.name, filename);
        let import_filename = endlos_ripp_off~u8(mw.endlos, sb.buffer);
        
        if (res) {
            import_filename.len--; // make the terminating 0 for C invisible to FSM
            if (!already_compiled(mw, import_filename))
                compile_module(mw, import_filename);
        }
        else {
            write(2, $"[FSM Modulizer] {filename}:{imp.location.line} Error: couldn't find import '{imp.name}'.\n")
            exit(1);
        }
    }

    if (verbose) $"Type Resolver {endlos_rolls_in_use(mw.endlos)} ...\n"
    type_resolver_run(root, mw.symbol_cache, mw.endlos, error_handler_ast_node);
    if (verbose) $"Type Resolver finished  {endlos_rolls_in_use(mw.endlos)} \n"

    if (verbose) $"Resolver  {endlos_rolls_in_use(mw.endlos)} ...\n"
    resolver_run(root, mw.symbol_cache, mw.endlos, error_handler_ast_node);
    if (verbose) $"Resolver finished {endlos_rolls_in_use(mw.endlos)} \n"

    // ast_dump_tree(root);

    if (verbose) $"Going to run type checker {endlos_rolls_in_use(mw.endlos)} ...\n"
    type_checker_run(root, mw.symbol_cache, mw.ast_allocator, mw.endlos, error_handler_ast_node);
    if (verbose) $"Finished type checking. {endlos_rolls_in_use(mw.endlos)}\n"

    // ast_dump_tree(root);

    calculate_stacks(root, mw.endlos);

    module.ast_root => root;
}

fn compile_program(initial_filename: u8[]) {
    let verbose = true;

    let endlos: EndlosAllocator;
    endlos_init(endlos);

    let type_cache: TypeCache;
    TypeCache_init(type_cache, endlos)

    let symbol_cache: SymbolCache;
    SymbolCache_init(symbol_cache, type_cache, endlos);

    let ast_allocator: AST_Node_Allocator;
    AST_Node_Allocator_init(ast_allocator);


    let mw: ModuleWalker;
    mw.ast_allocator => ast_allocator;
    mw.endlos => endlos;
    mw.symbol_cache => symbol_cache;
    EndlosArr_begin~Module(mw.modules, endlos);

    compile_module(mw, initial_filename);

    let compiled_modules = EndlosArr_finalize~Module(mw.modules, endlos);

    if (verbose) $"Going to run il gen...\n"

    let gen: IL_gen;
    gen.type_cache => type_cache;
    gen.symbol_cache => symbol_cache;
    EndlosArr_begin~Opcode(gen.opcodes, endlos);

    for (let i = 0; i < compiled_modules.len; i++) {
        il_gen_run(gen, compiled_modules[i].ast_root);
    }
    let opcodes = EndlosArr_finalize~Opcode(gen.opcodes, endlos);

    if (verbose) $"il gen finished\n"

    // dump_opcodes(opcodes);

    output_asm("out1.asm", opcodes, endlos);
}

fn main (argv: u8&[]) {
    if (argv.len < 2) {
        write(2, $"fsm: No input file.\n");
        exit(1);
    } 
    
    compile_program(sv_of_c_string(argv[1]));

    
    
}
