
import * from "endlos";
import * from "parser";
import * from "resolver";
import * from "il_gen";
import * from "type_checker";
import * from "calculate_stacks";
import * from "il_gen";
import * from "generator";

fn main (argv: u8&[]) {
    let endlos: EndlosAllocator;
    endlos_init(endlos);

    let tokenizer: Tokenizer;

    let module: ModuleHeader;
    module.filename = "foo.fsm";

    if (argv.len > 1) module.filename = sv_of_c_string(argv[1])

    tokenizer.code = read_file (module.filename);
    tokenizer.location.module => module;
    tokenizer.location.line = 1;

    tokenize_fsm(tokenizer);
    // dump_tokens(tokenizer);

    let tokens: Token[] = tokenizer.tokens;
    tokens.len = tokenizer.num_tokens;

    let type_cache: TypeCache;
    TypeCache_init(type_cache, endlos)

    let ast_allocator: AST_Node_Allocator;
    AST_Node_Allocator_init(ast_allocator);

    let root => parse_program(tokens, ast_allocator, endlos)

    let resolver: Resolver;
    resolver_init(resolver, endlos, type_cache);

    resolver_run(resolver, root);

    ast_dump_tree(root);


    let type_checker: TypeChecker;
    type_checker_init(type_checker, type_cache, ast_allocator, endlos, resolver.global_symbols);

    $"Going to run type checker...\n"
    type_checker_run(type_checker, root);
    $"Finished type checking.\n"

    ast_dump_tree(root);

    calculate_stacks(root, endlos);

    let il_gen: IL_gen;
    il_gen_init(il_gen, endlos, type_cache, resolver.global_symbols);

    $"Going to run il gen...\n"
    il_gen_run(il_gen, root);
    $"il gen finished\n"

    let opcodes = EndlosArr_finalize~Opcode(il_gen.opcodes, endlos);

    dump_opcodes(opcodes);

    output_asm("out1.asm", opcodes, endlos);

}
