
import * from "endlos";
import * from "parser";
import * from "symbol_cache";
import * from "module";
import * from "gather_imports";
import * from "type_resolver";
import * from "resolver";
import * from "il_gen";
import * from "type_checker";
import * from "calculate_stacks";
import * from "il_gen";
import * from "generator";


fn tokenize_module (module: Module&, code: u8[], endlos: EndlosAllocator&) {
    let tokenizer: Tokenizer;

    tokenizer.code = code;
    tokenizer.location.module => module.header;
    tokenizer.location.line = 1;
    tokenizer.tokens = endlos_begin~Token(endlos);

    tokenize_fsm(tokenizer);

    module.tokens = endlos_ripp_off~Token(endlos, tokenizer.tokens);

    // dump_tokens(module.tokens);
}


fn get_path(filename: u8[]) : u8[] {
    let path = filename;
    for (let i = filename.len - 1; i >= 0; i--) {
        if (filename[i] == '/') {
            path.len = i + 1
            return path;
        }
    }
    path.len = 0;
    return path;
}

fn find_file(sb: StringBuilder&, name: u8[], parent_module_filename: u8[]) : bool {
    let R_OK = 4;

    // try current directory
    sb_puts(sb, $"{name}.fsm\0");
    if (access(sb.str.begin, R_OK) == 0) return true;

    // search the path of the parent module
    sb_reset(sb);
    let path = get_path(parent_module_filename);
    sb_puts(sb, $"{path}{name}.fsm\0");
    if (access(sb.str.begin, R_OK) == 0) return true;

    // search standard library
    sb_reset(sb);
    sb_puts(sb, $"stdlib/{name}.fsm\0");
    if (access(sb.str.begin, R_OK) == 0) return true;
    
    sb_reset(sb);
    return false;
}


struct ModuleWalker {
    modules: EndlosArr<Module>;
    ast_allocator: AST_Node_Allocator&;
    endlos: EndlosAllocator&;
    symbol_cache: SymbolCache&;
}

fn compile_module (mw: ModuleWalker&, filename: u8[]) : void {
    let verbose = false;

    let module => EndlosArr_push~Module(mw.modules);

    module.header.filename = filename

    if (verbose) $"Reading '{filename}'\n"
    let code = read_file (filename);

    if (verbose) $"Tokenizing...\n"
    tokenize_module(module, code, mw.endlos);
    if (verbose) $"Tokenizing finished\n"

    if (verbose) $"Parsing...\n"
    let root => parse_program(module.tokens, mw.ast_allocator, mw.endlos)
    if (verbose) $"Parsing finished\n"

    let imports = gather_imports(root, mw.endlos);

    for (let i = 0; i < imports.len; i++) {
        let imp => imports[i];

        let sb: StringBuilder;
        sb_init(sb, endlos_begin~u8(mw.endlos));
        let res = find_file(sb, imp.name, filename);
        let import_filename = endlos_ripp_off~u8(mw.endlos, sb.buffer);
        
        if (res) {
            compile_module(mw, import_filename);
        }
        else {
            write(2, $"[FSM Modulizer] {filename}:{imp.location.line} Error: couldn't find import '{imp.name}'.\n")
            exit(1);
        }
    }

    if (verbose) $"Type Resolver...\n"
    type_resolver_run(root, mw.symbol_cache, mw.endlos);
    if (verbose) $"Type Resolver finished\n"

    if (verbose) $"Resolver...\n"
    resolver_run(root, mw.symbol_cache, mw.endlos);
    if (verbose) $"Resolver finished\n"

    // ast_dump_tree(root);

    if (verbose) $"Going to run type checker...\n"
    type_checker_run(root, mw.symbol_cache, mw.ast_allocator, mw.endlos);
    if (verbose) $"Finished type checking.\n"

    // ast_dump_tree(root);

    calculate_stacks(root, mw.endlos);

    module.ast_root => root;
}

fn compile_program(initial_filename: u8[]) {
    let verbose = false;

    let endlos: EndlosAllocator;
    endlos_init(endlos);

    let type_cache: TypeCache;
    TypeCache_init(type_cache, endlos)

    let symbol_cache: SymbolCache;
    SymbolCache_init(symbol_cache, type_cache, endlos);

    let ast_allocator: AST_Node_Allocator;
    AST_Node_Allocator_init(ast_allocator);


    let mw: ModuleWalker;
    mw.ast_allocator => ast_allocator;
    mw.endlos => endlos;
    mw.symbol_cache => symbol_cache;
    EndlosArr_begin~Module(mw.modules, endlos);

    compile_module(mw, initial_filename);

    let compiled_modules = EndlosArr_finalize~Module(mw.modules, endlos);

    if (verbose) $"Going to run il gen...\n"
    let opcodes = il_gen_run(compiled_modules[0].ast_root, symbol_cache, endlos);
    if (verbose) $"il gen finished\n"

    // dump_opcodes(opcodes);

    output_asm("out1.asm", opcodes, endlos);
}

fn main (argv: u8&[]) {
    if (argv.len < 2) {
        write(2, $"fsm: No input file.\n");
        exit(1);
    } 
    
    compile_program(sv_of_c_string(argv[1]));

    
    
}
