
import * from "std";
import * from "endlos";
import * from "common";
import * from "type";
import * from "symbol";
import * from "ast";

fn symbol_cache_error(eh: ErrorHandler<AST_node&>&, n: AST_node&, message: u8[]) {
    eh.handler("[FSM Resolver]", n, message, Severity::Error, eh.arg);
}

struct SymbolCache {
    type_cache: TypeCache&;
    global_symbols: EndlosArr<Symbol&>;
    symbol_roll: Symbol[];
    lookup_external_symbol: fn (u8[], any&) : Symbol&;
    lookup_external_symbol_arg: any&;
}

fn alloc_symbol(symbol_roll: Symbol[]&, kind: SymbolKind, name: u8[], location: Location&) : Symbol& {
    let s => symbol_roll++;
    s.kind = kind;
    s.name = name;
    s.location => location;
    return s;
}

fn SymbolCache_init(symbol_cache: SymbolCache&, type_cache: TypeCache&, endlos: EndlosAllocator&,
               lookup_external_symbol: fn (u8[], any&) : Symbol&, lookup_external_symbol_arg: any&)
{
    symbol_cache.type_cache => type_cache;
    symbol_cache.lookup_external_symbol => lookup_external_symbol;
    symbol_cache.lookup_external_symbol_arg => lookup_external_symbol_arg;
    EndlosArr_begin~Symbol& (symbol_cache.global_symbols, endlos);
    symbol_cache.symbol_roll = endlos_begin~Symbol (endlos);
}

fn get_global_symbol_by_name(symbol_cache: SymbolCache&, name: u8[]) {
    let sym => get_symbol_by_name(symbol_cache.global_symbols, name);
    if (sym) return sym;
    return symbol_cache.lookup_external_symbol(name, symbol_cache.lookup_external_symbol_arg);
}

fn push_global_symbol(symbol_cache: SymbolCache&, s: Symbol&, n: AST_node&, error_handler: ErrorHandler<AST_node&>&) : void {
    let conflicting => get_global_symbol_by_name(symbol_cache, s.name);

    if (conflicting) {
        if (conflicting.location)
            symbol_cache_error(error_handler, n, $"Tried to redefine '{s.name}' which was previously defined in {conflicting.location.module.filename}:{conflicting.location.line}")
        else
            symbol_cache_error(error_handler, n, $"Tried to redefine builtin symbol '{s.name}'.")
    }

    EndlosArr_push_ref~Symbol&(symbol_cache.global_symbols, s);
}

fn get_undefined_symbol (symbol_cache: SymbolCache&, name: u8[], location: Location&) {
    // Todo: link undefined symbols with the same name
    let sym => alloc_symbol(symbol_cache.symbol_roll, SymbolKind::SYM_undefined, name, location);
    sym.type => symbol_cache.type_cache.builtin_undefined;
    return sym;
}
