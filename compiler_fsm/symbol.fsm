
import * from "endlos";
import * from "type";

enum SymbolKind {
    SYM_function,
    SYM_local,
    SYM_arg,
    SYM_type,
}

struct Symbol {
    name: u8[];
    kind: SymbolKind;
    type: Type&;

    size; // stack frame size for functions
    offset; // stack offset for args and local vars
}

fn alloc_symbol(roll: Symbol[]&, kind: SymbolKind, name: u8[]) : Symbol& {
    let s => roll++;
    s.kind = kind;
    s.name = name;
    return s;
}

struct SymbolRefArr {
    alloc: Symbol&[];
    arr: Symbol&[];
}

fn SymbolRefArr_push (arr: SymbolRefArr&, s: Symbol&) {
    *(arr.alloc++) => s;
    arr.arr.len++;
}

fn SymbolRefArr_reset (arr: SymbolRefArr&, len) {
    let old_len = arr.arr.len;
    ASSERT(len <= old_len, __LOCATION__);
    arr.alloc.begin => &arr.arr[len];
    arr.alloc.len = arr.alloc.len + old_len - len;
    arr.arr.len = len;
}

fn SymbolRefArr_init (arr: SymbolRefArr&, allocator: EndlosAllocator&) {
    arr.alloc = endlos_begin~Symbol&(allocator);
    arr.arr = arr.alloc;
    arr.arr.len = 0;
}

/*
fn make_type_symbol(SV *name) : Symbol & {
    Type *t = get_type_by_name(name);
    if (!t) return nullptr;

    Symbol *s = alloc_symbol(SYM_type, *name);
    s->type = t;
    return s;
}
*/

fn get_symbol_by_name(arr: SymbolRefArr&, name: u8[]) : Symbol& {
    for (let i = 0; i < arr.arr.len; i++) {
        let s => arr.arr[i];
        if (sv_equal(s.name, name)) return s;
    }

    return null;
}
