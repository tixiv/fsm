
import * from "endlos";
import * from "type";

enum SymbolKind {
    SYM_function,
    SYM_local,
    SYM_arg,
    SYM_type,
}

struct Symbol {
    name: u8[];
    kind: SymbolKind;
    type: Type&;

    size; // stack frame size for functions
    offset; // stack offset for args and local vars
    location: Location&;
}

fn get_symbol_by_name(arr: EndlosArr<Symbol&>&, name: u8[]) : Symbol& {
    for (let i = 0; i < arr.arr.len; i++) {
        let s => arr.arr[i];
        if (sv_equal(s.name, name)) return s;
    }

    return null;
}
