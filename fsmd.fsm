
import * from "std";
import * from "endlos";


/*

{
  "jsonrpc": "2.0",
  "id": 0,
  "method": "initialize",
  "params": {
    ...
  }
}

{
  "jsonrpc": "2.0",
  "id": 0,
  "result": {
    "capabilities": {}
  }
}

Content-Length: 70\r\n
\r\n
{"jsonrpc":"2.0","id":0,"result":{"capabilities":{}}}

*/

fn sv_skip(str: u8[], start) {
  if (start > str.len) start = str.len;
  str.begin => str[start];
  str.len = str.len - start;
  return str;
}

fn take_number (str: u8[]&) : u8[]
{
    while (!is_numeric(str.begin) && str.len) str++;
    
    let number = str;
    number.len = 0

    while (is_numeric(str.begin) && str.len) {
        str++
        number.len = number.len + 1
    } 

    return number
}

fn sv_take_until(sv :u8[]&, char: u8) {
    let ret = sv;
    ret.len = 0;
    while (sv.len && sv.begin != char) {
        sv++;
        ret.len++;
    }
    return ret;
}

fn json_take_object (json: u8[]&) {
    let obj = json;
    obj.len = 0;
    let depth = 0;
    while (json.len) {
        let c = json++;
        if (c == '{') {
            depth++;
        }
        else if (c == '}') {
            depth--;
            if (depth < 0) {
                return obj;
            }
        }
        else if (c == ',') {
            if (depth == 0)
                return obj;
        }
        obj.len++;
    }

    let r: u8[]; return r;
}

fn json_get_element (json: u8[], identifier: u8[]) {
    // take initial opening brace
    while (json.len && json.begin != '{') json++;
    if (!json.len || '{' != json++) { let r: u8[]; return r; }

    // find the id
    while (json.len) {
        while (json.len && json.begin != '"') json++;
        if (!json.len || '"' != json++) { let r: u8[]; return r; }

        let id = sv_take_until(json, '"');
        json++;
        while (json.len && json.begin != ':') json++;
        if (!json.len || ':' != json++) { let r: u8[]; return r; }
        
        let obj = json_take_object(json);

        if (sv_equal(id, identifier)) {
            return obj;
        }
    }
    let r: u8[]; return r;
}

fn json_get_number (json: u8[], id: u8[]) {
    return json_get_element(json, id);
}

fn json_get_string (json: u8[], id: u8[]) {
    let e = json_get_element(json, id);
    if (e.begin == '"') e++;
    if (e[e.len-1] == '"') e.len--;
    return e;
}
  
fn write_wrapped(fd, json: u8[]) {
    write (fd, $"Content-Length: {json.len}\r\n\r\n");
    write (fd, json);
}

fn send_initialize_response (id: u8[]) {
    // write_wrapped (1, $"\{\"jsonrpc\":\"2.0\",\"id\":{id},\"result\":\{\"capabilities\":\{\"textDocumentSync\": 1}}}");
write_wrapped (1, $"\{
    \"jsonrpc\": \"2.0\",
    \"id\": {id},
    \"result\": \{
        \"capabilities\": \{
            \"textDocumentSync\": 1,
            \"documentSymbolProvider\": true,
            \"definitionProvider\": true,
            \"renameProvider\": true
        }
    }
}");

}

struct StreamReader {
    buffer: u8[];
    arr: u8[];
    fd;
}

fn sr_init(sr: StreamReader&, buffer: u8[], fd) {
    sr.buffer = buffer;
    sr.arr = buffer;
    sr.arr.len = 0;
    sr.fd = fd;
}

fn sr_read_some(sr: StreamReader&) {
    let len = read(sr.fd, sr.buffer);
    if (len > 0) {
        sr.arr.len = sr.arr.len + len;
        sr.buffer = sv_skip(sr.buffer, len);
    }
}

fn sr_read_exact(sr: StreamReader&, num_bytes) : u8[] {
    while (sr.arr.len < num_bytes) {
        sr_read_some(sr);
    }
    let r = sr.arr;
    r.len = num_bytes;
    
    sr.arr = sv_skip(sr.arr, num_bytes);

    return r;
}

fn get_content_length(sr: StreamReader&) : i64 {
    let arr = sr.arr;
    for ( ; arr.len >= 4; arr++) {
        if (sv_starts_with(arr, "\r\n\r\n")) {
            let len = parse_integer(sr.arr);
            sr.arr = sv_skip(arr, 4);
            return len;
        }
    }
    return -1;
}

fn read_header (sr: StreamReader&) : i64 {
    let str_content_length = "Content-Length: ";

    let header_1 = sr_read_exact(sr, str_content_length.len);

    if (!sv_equal(header_1, str_content_length)) {
        write (2, $"Error: expeceted '{str_content_length}' but got {header_1}\n");
        exit(1);
    }

    return get_content_length(sr);
}


fn main () {

    let O_WRONLY = 1;
    let O_CREAT = 64;
    let O_TRUNC = 512;

    let filename = "/home/tixiv/work/fsm/fsmd1.log";

    let log_fd = open(filename, O_WRONLY + O_CREAT + O_TRUNC);
    if (log_fd < 0) {
        write(2, $"Failed to open '{filename}' for writing: {strerror(log_fd)}\n")
        exit(1);
    }

    // let endlos: EndlosAllocator;
    // endlos_init(endlos);
    // let buffer = endlos_begin~u8(endlos);
    let buffer: u8[65536];

    for(;;) {
        let sr: StreamReader;
        sr_init(sr, buffer, 0)
        let content_length = read_header(sr);

        let request = sr_read_exact(sr, content_length);

        write(log_fd, "client: ");
        write(log_fd, request);
        write(log_fd, "\n");

        // print(len);
        // print(request.len)

        let id = json_get_number(request, "id");
        let method = json_get_string(request, "method");

        //let params = json_get_element(request, "params");

        // $"id = '{id}'\n"
        // $"method = {method}\n";

        if (sv_equal(method, "initialize")) {
            write (log_fd, "initialize\n")
            send_initialize_response(id);
        }
    }
}
