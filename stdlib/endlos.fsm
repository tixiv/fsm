
import * from "std";

struct EndlosRoll {
    buffer: u8[];
    alloc: u8[];
    latest: u8[];
}

struct EndlosAllocator {
    rolls: EndlosRoll[256];
}

fn endlos_init(allocator: EndlosAllocator&) {
    let roll_capacity = 1024 * 1024 * 1024;
    for (let i = 0; i < 256; i++) {
        allocator.rolls[i].buffer.begin => mmap_anonymous(roll_capacity);
        allocator.rolls[i].buffer.len = roll_capacity;
        allocator.rolls[i].alloc = allocator.rolls[i].buffer;
    }
}

fn endlos_rolls_in_use (allocator: EndlosAllocator&) {
    let count = 0;
    for (let i = 0; i < 256; i++)
        if (allocator.rolls[i].latest.begin)
            count++;
    return count;
}

generic T fn endlos_begin (allocator: EndlosAllocator&) : T[] {
    let align = T.sizeof;
    if (align > 8) align = 8;
    for (let i = 0; i < 256; i++) {
        if (!allocator.rolls[i].latest.begin) {
            let roll => allocator.rolls[i];
            while (<u64>roll.alloc.begin % align) roll.alloc++;
            roll.latest = roll.alloc;
            let t_roll: T[];
            t_roll.begin => <T&>roll.alloc.begin;
            t_roll.len = roll.alloc.len / T.sizeof;
            return t_roll;
        }
    }
    $"{__LOCATION__} Error: Endlos allocator has no free rolls available.\n"
    exit(1);
    let a: T[];
    return a;
}

generic T fn endlos_ripp_off (allocator: EndlosAllocator&, returned_roll: T[]) : T[] {
    for (let i = 0; i < 256; i++) {
        if (allocator.rolls[i].latest.begin) {
            let r => allocator.rolls[i];
            if (<i64>r.alloc.begin <= <i64>returned_roll.begin < <i64>r.alloc.begin + r.alloc.len) {
                let finalized: T[];
                finalized.begin => <T&> r.latest.begin;
                finalized.len = (r.latest.len - returned_roll.len * T.sizeof) / T.sizeof;
                r.alloc.begin => <u8&> returned_roll.begin;
                r.alloc.len = returned_roll.len * T.sizeof;
                r.latest.begin => null;
                r.latest.len = 0;
                return finalized;
            }
        }
    }
    $"{__LOCATION__} Error: endlos_ripp_off() was called on something that didn't come from a roll.\n"
    exit(1);
    let a: T[];
    return a;
}

generic T struct EndlosArr {
    alloc: T[];
    arr: T[];
}

generic T fn EndlosArr_begin(arr: EndlosArr<T>&, allocator: EndlosAllocator&) : void {
    arr.alloc = endlos_begin~T(allocator);
    arr.arr = arr.alloc;
    arr.arr.len = 0;
}

generic T fn EndlosArr_reset (arr: EndlosArr<T>&, len) : void {
    let old_len = arr.arr.len;
    ASSERT(len <= old_len, __LOCATION__);
    arr.alloc.begin => &arr.arr[len];
    arr.alloc.len = arr.alloc.len + old_len - len;
    arr.arr.len = len;
}

generic T fn EndlosArr_finalize(arr: EndlosArr<T>&, allocator: EndlosAllocator&) : T[] {
    return endlos_ripp_off~T(allocator, arr.alloc);
}

generic T fn EndlosArr_free(arr: EndlosArr<T>&, allocator: EndlosAllocator&) : void {
    let a: T[];
    a.begin => arr.arr.begin;
    a.len = arr.arr.len + arr.alloc.len;
    endlos_ripp_off~T(allocator, a);
}

generic T fn EndlosArr_push_ref(arr: EndlosArr<T>&, ref: T) : void {
    *arr.alloc++ => ref;
    arr.arr.len++;
}

generic T fn EndlosArr_push(arr: EndlosArr<T>&) : T& {
    let ret => arr.alloc++;
    arr.arr.len++;
    return ret;
}
