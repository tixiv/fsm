
fn strerror (error_code) {
    if (error_code == -1) return "Operation not permitted";
    if (error_code == -2) return "No such file or directory";
    if (error_code == -13) return "Permission denied";
    if (error_code == -14) return "Bad address";
    if (error_code == -22) return "Invalid argument";

    print(error_code)
    return "unknown error"
}

fn open (filename: u8[], flags) {
    let filename_zero_delimited = $"{filename}\0";
    let permissions = 0x1A4; // 110 100 100 == octal 644
    return __open (filename_zero_delimited.begin, flags, permissions);
}

fn chmod (filename: u8[], permissions) {
    let filename_zero_delimited = $"{filename}\0";
    let SYS_CHMOD = 90;
    return syscall_2(SYS_CHMOD, <i64>filename_zero_delimited.begin, permissions);
}

fn fork () : i64 {
    let SYS_FORK = 57;
    return syscall_0(SYS_FORK);
}

fn execve (filename: u8&, argv: u8& &, envp: u8& &) : i64 {
    let SYS_EXECVE = 59;
    return syscall_3(SYS_EXECVE,<i64>filename, <i64>argv, <i64>envp);
}

fn waitpid (pid, wstatus: u32&, options) {
    let SYS_WAIT4 = 61;
    return syscall_4(SYS_WAIT4, pid, <i64>wstatus, options, 0);
}

fn read_file (filename: u8[]) : u8[]
{
    let O_RDONLY = 0
    let PROT_READ = 0x1
    let MAP_PRIVATE = 0x02

    let fd = open (filename, O_RDONLY)

    let s: u8[];
    s.len = 0;

    if (fd >= 0) {
        puts("File '") puts(filename)  puts("' has been opened. ")

        let size = fsize(fd)
        
        s.begin => mmap(null, size, PROT_READ, MAP_PRIVATE, fd, 0)
        s.len = size;

        puts("Read bytes: ") print(s.len)
        return s;
    }
    else {
        write(2, $"Error: failed to read file '{filename}': {strerror(fd)}\n");
        exit(1);
    }

    return s;
}

fn mmap_anonymous(reserve_size) : any & {
    let PROT_READ = 0x1;
    let PROT_WRITE = 0x2;
    let MAP_PRIVATE = 0x02;
    let MAP_ANONYMOUS = 0x20;
    let ref => mmap(null, reserve_size, bitor(PROT_READ, PROT_WRITE), bitor(MAP_PRIVATE, MAP_ANONYMOUS), -1, 0);
    if (<i64>ref < 0) {
        $"{__LOCATION__} Runtime Error: mmap_anonymous() failed: {strerror(<i64>ref)}\n";
    }
    return ref;
}

fn is_whitespace(c: i32) { return c == ' ' |== '\t' |== '\r' }
fn is_numeric(c: i32) { return '0' <= c <= '9' }
fn is_hex_digit(c: i32) { return is_numeric(c) || 'a' <= c <= 'f' || 'A' <= c <= 'F' }
fn is_alpha(c: i32) { return 'a' <= c <= 'z' || 'A' <= c <= 'Z' }

fn skip_whitespace (s: u8[]&) { while (s.len && is_whitespace(s.begin)) s++ }

fn sv_equal (s1: u8[], s2: u8[]) {
    if (s1.len != s2.len) return false;
    while (s1.len)
        if (s1++ != s2++) return false;
    return true;
}

fn sv_skip(str: u8[], start) {
  if (start > str.len) start = str.len;
  str.begin => str[start];
  str.len = str.len - start;
  return str;
}

fn sv_starts_with (s: u8[], start: u8[]) {
    if (s.len < start.len) return false
    s.len = start.len
    return sv_equal(s, start)
}

fn sv_ends_with (s: u8[], end: u8[]) {
    if (s.len < end.len) return false
    s = sv_skip(s, s.len - end.len);
    return sv_equal(s, end)
}

fn sv_find(s: u8[], needle: u8[]) {
    for (let i = 0; s.len >= needle.len ; { i++ s++ }) {
        if (sv_starts_with(s, needle))
            return i;
    }
    return -1;
}

fn sv_split(str: u8[]&, splitter: u8[]) : u8[] {
    let start = str;
    for (start.len = 0; str.len; {str++ start.len++}) {
        if (sv_starts_with(str, splitter)) {
            for (let i = 0; i < splitter.len; i++)
                str++
            return start;
        }
    }
    return start;
}

fn sv_of_c_string(c_str: u8&) : u8[] {
    let sv: u8[];
    sv.begin => c_str;
    sv.len = for (let i = 0; sv[i] != 0; i++; i);
    return sv;
}

fn to_hex_digit (n) {
    return if (n < 10) n + '0' else n - 10 + 'A';
}

fn is_digit_in_base(digit: i32, base) {
    if (base == 16) return is_hex_digit(digit);
    return '0' <= digit < '0' + base
}

// expects valid digit
fn digit_value(digit :i32) {
    return  if (digit <= '9') digit - '0'
            else if (digit <= 'F') digit - 'A' + 10 
            else digit - 'a' + 10;
}

fn parse_integer_in_base(s: u8[], base) {
    let neg = s.begin == '-';
    if (neg) s++;

    let num = for (let i = 0; s.len && is_digit_in_base(s.begin, base); s++; i) {
        i = i * base + digit_value(s.begin);
    }
    if (neg) return -num;
    return num;
}

fn parse_integer (s: u8[]) {
    skip_whitespace(s)
    let neg = s.begin == '-';
    if (neg) s++;

    let base = 10
    if (sv_starts_with(s, "0x")) { base = 16; s++; s++ }
    if (sv_starts_with(s, "0b")) { base = 2; s++; s++ }

    let num = parse_integer_in_base(s, base)
    if (neg) return -num;
    return num
}

fn print_hex(num: u64) {
    let a: u8[16];
    for (let i = 15; i >= 0; i--) {
        let d = bitand(bitshift(num, 60 - i * 4), 0x0f);
        a[i] = to_hex_digit(d);
    }
    puts(a)
}

fn quicksort64_partition(arr: i64[], lo, hi) {
    let pivot = arr[lo]
    let i = lo - 1
    let j = hi + 1

    for (;;) {
        i++
        while (arr[i] < pivot) i++

        j--
        while (arr[j] > pivot) j--

        if (i >= j) return j

        let tmp = arr[i]
        arr[i] = arr[j]
        arr[j] = tmp
    }
    return 0;
}

fn quicksort64(arr: i64[], lo, hi) : void {
    if (lo >= 0 && hi >= 0 && lo < hi) {
        let p = quicksort64_partition(arr, lo, hi)
        quicksort64(arr, lo, p)
        quicksort64(arr, p + 1, hi)
    }
}

struct StringBuilder {
    buffer: u8[];
    str: u8[];
}

fn sb_init(sb: StringBuilder&, buffer: u8[]) {
    sb.buffer = buffer
    sb.str.begin => buffer.begin
    sb.str.len = 0
}

fn sb_reset(sb: StringBuilder&) {
    sb.buffer.begin => sb.str.begin;
    sb.buffer.len = sb.buffer.len + sb.str.len;
    sb.str.len = 0
}

fn sb_puts(sb: StringBuilder&, s: u8[]) {
    while (sb.buffer.len && s.len) {
        sb.buffer.begin = s.begin
        sb.buffer++ s++
        sb.str.len++
    }
}

fn sb_putc(sb: StringBuilder&, c: u8) {
    if (sb.buffer.len) {
        sb.buffer.begin = c
        sb.buffer++
        sb.str.len++
    }
}

fn sb_puti(sb: StringBuilder&, num) {
    if (num < 0) {
        if (num == 0x8000000000000000) {
            // This one is not representable as positive integer
            sb_puts(sb, "-9223372036854775808")
            return;
        }
        num = -num
        sb_putc(sb, '-')
    }
    let zero_blank = true;
    for (let a = 1000000000000000000; a != 0; a = a / 10) {
        let digit = num / a
        num = num - a * digit
        if (!(digit == 0 && zero_blank && a > 1)) {
            zero_blank = false;
            sb_putc(sb, digit + '0')
        }
    }
}

fn sb_put_hex(sb: StringBuilder&, num: u64) {
    for (let i = 15; i >= 0; i--) {
        let d = bitand(bitshift(num, i * 4), 0x0f);
        sb_putc(sb, if (d < 10) d + '0' else d + 'A' - 10);
    }
}

fn sb_puts_rightpad(sb: StringBuilder&, s: u8[], pad_to_len) {
    let s_len = s.len;
    while (sb.buffer.len && s.len) {
        sb.buffer++ = s++
        sb.str.len++
    }
    while (sb.buffer.len && s_len < pad_to_len) {
        sb.buffer++ = ' ';
        sb.str.len++;
        s_len++;
    }
}

fn sb_putf (sb: StringBuilder&, f: f64) {
    if (f < 0.0) {
        f = -f;
        sb_putc(sb, '-');
    }

    let e = 17;
    while (f >= 1000000000000000000.0) {
        f = f / 10.0;
        e++;
    }
    while (f <   100000000000000000.0) {
        f = f * 10.0;
        e--;
    }

    let num_str = $"{<i64> f}"

    if (e >= 0) {
        for (let i = 0; i <= e; i++) {
            if (i < 17) {
                sb_putc (sb, num_str[i])
            }
            else {
                sb_putc (sb, '0')
            }
        }
        if (e < 16) {
            sb_putc (sb, '.')
            for (let i = e+1; i < 17; i++) {
                sb_putc (sb, num_str[i]);
            }
        }
    }
    else {
        sb_puts (sb, "0.");
        for (let i = -1; i > e; i--) {
            sb_putc (sb, '0');
        }
        for (let i = 0; i < 17; i++) {
            sb_putc (sb, num_str[i]);
        }
    }
}

fn parse_float(s: u8[]) : f64 {
    let neg = s.begin == '-';
    if (neg) s++;

    let after_point = false;
    let divisor = 1;

    let num = for (let f = 0.0; s.len && (is_numeric(s.begin) || s.begin == '.') ; s++; f) {
        if (s.begin != '.') {
            f = (f * 10.0) + <f64>digit_value(s.begin);
            if (after_point) divisor = divisor * 10;
        }
        else {
            after_point = true;
        }
    }

    if (divisor != 1) {
        num = num / <f64> divisor;
    }

    if (neg) return -num;
    return num;
}

fn hexdump(d: u8[]) {
    for (let i = 0; d.len; { i++ d++ }) {
        if (i % 16 == 0) {
            if (i) putc('\n');
        }
        else {
            putc(' ');
        }
        putc(to_hex_digit(bitand(bitshift(d.begin, 4), 0x0f)));
        putc(to_hex_digit(bitand(d.begin, 0x0f)));
    }
    putc('\n')
}


fn NOT_IMPLEMENTED(location: u8[], what:u8[]) {
    write (2, $"{location}: {what} is not implemented yet.\n");
    exit(1);
}

fn NOT_IMPLEMENTED_EC(exit_code, location: u8[], what:u8[]) {
    write (2, $"{location}: {what} is not implemented yet.\n");
    exit(exit_code);
}

fn ASSERT(condition: bool, s: u8[]) {
    if (!condition) {
        write (2, $"Assertion failed: {s}");
        exit(1);
    }
}

generic T fn obj_copy(dest: T&, src: T&) : void {
    for (let i = 0; i < T.sizeof; i++) {
        *<u8&>(<u64>dest + i) = *<u8&>(<u64>src + i);
    }
}

generic T fn obj_zero(dest: T&) : void {
    if (!bitand(T.sizeof, 7)) {
        for (let i = 0; i < T.sizeof; i = i + 8) {
            *<u64&>(<u64>dest + i) = 0;
        }
        return;
    }
    for (let i = 0; i < T.sizeof; i++) {
        *<u8&>(<u64>dest + i) = 0;
    }
}
