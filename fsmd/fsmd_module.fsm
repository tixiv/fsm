
import * from "endlos";
import * from "compiler_fsm/common";
import * from "compiler_fsm/module";


struct LocationRange {
    start_line: i32;
    end_line: i32;
    start_col:i32;
    end_col:i32;
}

struct Diagnostic {
    message: u8[];
    severity: Severity;
    range: LocationRange;
}

struct Statistics {
    start_times:  i64[8];
    finish_times: i64[8];
}

enum ModuleState {
    NotCompiled,
    Compiling,
    CompilationFailed,
    Compiled,
}

struct FsmdModule {
    module: Module;
    state: ModuleState;
    code_buffer: u8[];
    diagnostics: EndlosArr<Diagnostic>;
    statistics: Statistics;
}
