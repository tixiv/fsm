
import * from "std";
import * from "endlos";

fn sv_skip(str: u8[], start) {
  if (start > str.len) start = str.len;
  str.begin => str[start];
  str.len = str.len - start;
  return str;
}

fn take_number (str: u8[]&) : u8[]
{
    while (!is_numeric(str.begin) && str.len) str++;
    
    let number = str;
    number.len = 0

    while (is_numeric(str.begin) && str.len) {
        str++
        number.len = number.len + 1
    } 

    return number
}

fn sv_take_until(sv :u8[]&, char: u8) {
    let ret = sv;
    ret.len = 0;
    while (sv.len && sv.begin != char) {
        sv++;
        ret.len++;
    }
    return ret;
}

fn json_take_object (json: u8[]&) {
    let obj = json;
    obj.len = 0;
    let depth = 0;
    let in_string = false;
    while (json.len) {
        let c = json++;
        if (in_string) {
            if (c == '\\') {
                json++;
                obj.len++;
            }
            else if (c == '"') {
                in_string = false;
            }
        }
        else {
            if (c == '{') {
                depth++;
            }
            else if (c == '}') {
                depth--;
                if (depth < 0) {
                    return obj;
                }
            }
            else if (c == ',') {
                if (depth == 0)
                    return obj;
            }
            else if (c == '"') {
                in_string = true;
            }
        }
        obj.len++;
    }

    let r: u8[]; return r;
}

fn json_get_element (json: u8[], identifier: u8[]) {
    // take initial opening brace
    while (json.len && json.begin != '{') json++;
    if (!json.len || '{' != json++) { let r: u8[]; return r; }

    // find the id
    while (json.len) {
        while (json.len && json.begin != '"') json++;
        if (!json.len || '"' != json++) { let r: u8[]; return r; }

        let id = sv_take_until(json, '"');
        json++;
        while (json.len && json.begin != ':') json++;
        if (!json.len || ':' != json++) { let r: u8[]; return r; }
        
        let obj = json_take_object(json);

        if (sv_equal(id, identifier)) {
            return obj;
        }
    }
    let r: u8[]; return r;
}

fn json_get_number (json: u8[], id: u8[]) {
    return json_get_element(json, id);
}

fn json_get_string (json: u8[], id: u8[]) {
    let e = json_get_element(json, id);
    if (e.begin == '"') e++;
    if (e[e.len-1] == '"') e.len--;
    return e;
}


fn json_unescape_string (escaped: u8[], endlos: EndlosAllocator&) : u8[] {
    let sb: StringBuilder;
    let unescaped = endlos_begin~u8(endlos);
    for ( ; escaped.len; escaped++) {
        let c = escaped.begin;
        if (c == '\\') {
            escaped++;
            c = escaped.begin;
                 if (c == 'n') unescaped++ = '\n'
            else if (c == 'r') unescaped++ = '\r'
            else if (c == 't') unescaped++ = '\t'
            else unescaped++ = c;
        }
        else {
            unescaped++ = c;
        }
    }
    return endlos_ripp_off~u8(endlos, unescaped);
}