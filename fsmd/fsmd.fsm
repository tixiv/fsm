fn open_log_file() {
    let O_WRONLY = 1;
    let O_CREAT = 64;
    let O_TRUNC = 512;

    let filename = "/home/tixiv/work/fsm/fsmd1.log";

    let log_fd = open(filename, O_WRONLY + O_CREAT + O_TRUNC);
    if (log_fd < 0) {
        write(2, $"Failed to open '{filename}' for writing: {strerror(log_fd)}\n")
        exit(1);
    }
    return log_fd;
}

fn get_path(filename: u8[]) : u8[] {
    let path = filename;
    for (let i = filename.len - 1; i >= 0; i--) {
        if (filename[i] == '/') {
            path.len = i + 1
            return path;
        }
    }
    path.len = 0;
    return path;
}

fn find_file(sb: StringBuilder&, name: u8[], parent_module_filename: u8[]) : bool {
    let R_OK = 4;

    // try current directory
    sb_puts(sb, $"{name}.fsm\0");
    if (access(sb.str.begin, R_OK) == 0) return true;

    // search the path of the parent module
    sb_reset(sb);
    let path = get_path(parent_module_filename);
    sb_puts(sb, $"{path}{name}.fsm\0");
    if (access(sb.str.begin, R_OK) == 0) return true;

    // search standard library
    sb_reset(sb);
    sb_puts(sb, $"stdlib/{name}.fsm\0");
    if (access(sb.str.begin, R_OK) == 0) return true;
    
    sb_reset(sb);
    return false;
}

struct ModuleWalker {
    modules: EndlosArr<Module>;
    ast_allocator: AST_Node_Allocator&;
    endlos_main: EndlosAllocator;      // lives forever
    endlos_compile: EndlosAllocator;   // gets reset when we recompile
    type_cache: TypeCache;
    error_handler_location: ErrorHandler<Location&>;
    error_handler_ast_node: ErrorHandler<AST_node&>;
    builtin_symbols: Symbol[];
    project_root: u8[];
    log_fd;
    current_module: Module&;
    num_errors;
}

fn push_diagnostic(mw: ModuleWalker&, location: Location&, message: u8[]) {
    let module => <Module&> location.module;
    let diag => EndlosArr_push~Diagnostic(module.diagnostics);
    diag.message = endlos_copy~u8(message, mw.endlos_compile);
    diag.range.start_line = location.line-1;
    diag.range.end_line = diag.range.start_line;
    diag.range.start_col = location.col-6;
    diag.range.end_col = location.col-1;
    if (diag.range.start_col < 0) diag.range.start_col = 0;
}

fn publish_diagnostics(mw: ModuleWalker&) {
    for (let i = 0; i < mw.modules.arr.len; i++) {
        let module => mw.modules.arr[i];
        send_diagnostic_notifications(module.header.filename, module.diagnostics.arr);
    }
}

fn error_handler_location(facility: u8[], location: Location&, message: u8[], mw: ModuleWalker&) {
    write(mw.log_fd, $"{facility} {location.module.filename}:{location.line}:{location.col} Error: {message}\n");
    push_diagnostic(mw, location, message);
    mw.num_errors++;
}

fn error_handler_ast_node(facility: u8[], n: AST_node&, message: u8[], mw: ModuleWalker&) {
    write(mw.log_fd, $"{facility} {n.location.module.filename}:{n.location.line}:{n.location.col} Error: {message}\n");
    push_diagnostic(mw, n.location, message);
    mw.num_errors++;
}

fn tokenize_module (mw: ModuleWalker&, module: Module&, code: u8[], endlos: EndlosAllocator&) {
    let tokenizer: Tokenizer;

    tokenizer.code = code;
    tokenizer.location.module => module.header;
    tokenizer.location.line = 1;
    tokenizer.location.col = 1;
    tokenizer.tokens = endlos_begin~Token(endlos);
    tokenizer.error_handler => mw.error_handler_location;

    tokenize_fsm(tokenizer);

    return endlos_ripp_off~Token(endlos, tokenizer.tokens);
}

fn find_existing_module(mw: ModuleWalker&, import_filename : u8[]) : Module&{
    for (let i = 0; i < mw.modules.arr.len; i++) {
        if (sv_equal(import_filename, mw.modules.arr[i].header.filename))
            return mw.modules.arr[i];
    }
    return null;
}

fn lookup_builtin_symbol(name: u8[], mw: ModuleWalker&) {
    let symbols => mw.builtin_symbols;
    for (let i = 0; i < symbols.len; i++) {
        if (sv_equal (symbols[i].name, name)) return &symbols[i];
    }
    return null;
}

fn lookup_symbol_from_module(name: u8[], module: Module&) : Symbol& {
    let symbols => module.global_symbols;
    for (let j = 0; j < symbols.len; j++) {
        if (sv_equal (symbols[j].name, name)) return symbols[j];
    }
    return null;
}

fn lookup_stdlib_symbol(name: u8[], mw: ModuleWalker&) : Symbol& {
    for (let i = 0; i < mw.modules.arr.len; i++) {
        let filename = mw.modules.arr[i].header.filename;
        if (sv_ends_with(filename, "stdlib/std.fsm")) {
            return lookup_symbol_from_module(name, mw.modules.arr[i]);
        }
    }
    return null;
}

fn lookup_external_symbol(name: u8[], mw: ModuleWalker&) : Symbol& {
    let sym => lookup_builtin_symbol(name, mw);
    if (sym) return sym;

    let imports = mw.current_module.imports;

    // write(2, $"Looking up external symbol {name} {imports.len}\n");

    for (let i = 0; i < imports.len; i++) {
        if (imports[i].module) {
            // write(2, $"    Looking in {imports[i].module.header.filename}\n");
            sym => lookup_symbol_from_module(name, imports[i].module);
            if (sym) return sym;
        }
    }

    // write(2, $"    Not found\n");

    return null;
}

fn compile_module (mw: ModuleWalker&, module: Module&) : void {
    let verbose = false;

    mw.current_module => module;

    if (verbose) write(2, $"Compiling module {module.header.filename}...\n");

    if (module.state != ModuleState::NotCompiled) {
        write(2, $"{__LOCATION__} Error: module {module.header.filename} is not in expected state\n");
        return;
    }

    module.state = ModuleState::Compiling;
    obj_zero~Import[](module.imports);
    obj_zero~Symbol[](module.symbols);
    obj_zero~Symbol&[](module.global_symbols);
    module.ast_root => null;

    let last_num_errors = mw.num_errors;

    if (verbose) write(2, $"Tokenizing {endlos_rolls_in_use(mw.endlos_compile)}...\n");
    let tokens = tokenize_module(mw, module, module.code, mw.endlos_compile);
    if (verbose) write(2, $"Tokenizing finished {endlos_rolls_in_use(mw.endlos_compile)}\n");
    
    let ast_allocator: AST_Node_Allocator;
    AST_Node_Allocator_init(ast_allocator, mw.endlos_compile);

    if (verbose) write(2, $"Parsing {endlos_rolls_in_use(mw.endlos_compile)} ...\n");
    let root => parse_program(tokens, ast_allocator, mw.endlos_compile, mw.error_handler_location)
    if (verbose) write(2, $"Parsing finished {endlos_rolls_in_use(mw.endlos_compile)} \n");

    module.imports = gather_imports(root, mw.endlos_compile);
    handle_imports(mw, module.header.filename, module.imports);

    // Restoring current module is needed because it will change during importing more stuffs from other imports
    mw.current_module => module;

    if (mw.num_errors > last_num_errors) {
        write (mw.log_fd, "Errors during parsing. Not going to run resolvers.\n")
        module.state = ModuleState::CompilationFailed;
        return;
    }

    let symbol_cache: SymbolCache;
    SymbolCache_init(symbol_cache, mw.type_cache, mw.endlos_compile, lookup_external_symbol, mw);

    if (verbose) write(2, $"Type Resolver {endlos_rolls_in_use(mw.endlos_compile)} ...\n");
    type_resolver_run(root, symbol_cache, mw.endlos_compile, mw.error_handler_ast_node);
    if (verbose) write(2, $"Type Resolver finished  {endlos_rolls_in_use(mw.endlos_compile)} \n");

    if (verbose) write(2, $"Resolver  {endlos_rolls_in_use(mw.endlos_compile)} ...\n");
    resolver_run(root, symbol_cache, mw.endlos_compile, mw.error_handler_ast_node);
    if (verbose) write(2, $"Resolver finished {endlos_rolls_in_use(mw.endlos_compile)} \n");

    if (mw.num_errors > last_num_errors) {
        write (mw.log_fd, "Errors during resolvers. Not going to run type checker.\n")
        module.state = ModuleState::CompilationFailed;
        return;
    }

    if (verbose) write(2, $"Going to run type checker {endlos_rolls_in_use(mw.endlos_compile)} ...\n");
    type_checker_run(root, symbol_cache, ast_allocator, mw.endlos_compile, mw.error_handler_ast_node);
    if (verbose) write(2, $"Finished type checking. {endlos_rolls_in_use(mw.endlos_compile)}\n");

    AST_Node_Allocator_finalize(ast_allocator, mw.endlos_compile);

    module.symbols = endlos_ripp_off~Symbol(mw.endlos_compile, symbol_cache.symbol_roll);
    module.global_symbols = EndlosArr_finalize~Symbol&(symbol_cache.global_symbols, mw.endlos_compile);
    module.ast_root => root;

    if (mw.num_errors > last_num_errors) {
        write (mw.log_fd, "Errors during type checker. Not going to run il gen.\n")
        module.state = ModuleState::CompilationFailed;
        return;
    }

    if (verbose) write(2, $"Going to run IL gen {endlos_rolls_in_use(mw.endlos_compile)} ...\n");

    // The IL gen is only run for the diagnostic messages here
    let gen: IL_gen;
    gen.type_cache => mw.type_cache;
    gen.lookup_stdlib_symbol => lookup_stdlib_symbol;
    gen.lookup_stdlib_symbol_arg => mw;
    gen.error_handler => mw.error_handler_ast_node;

    EndlosArr_begin~Opcode(gen.opcodes, mw.endlos_compile);
    EndlosArr_begin~u8[](gen.generic_implementation_names, mw.endlos_compile);

    il_gen_run(gen, root);

    EndlosArr_free~u8[](gen.generic_implementation_names, mw.endlos_compile);
    EndlosArr_free~Opcode(gen.opcodes, mw.endlos_compile);

    if (verbose) write(2, $"Finished IL gen. {endlos_rolls_in_use(mw.endlos_compile)}\n");

    module.state = ModuleState::Compiled;
}

fn read_file_to_buffer(filename: u8[], buffer: u8[]) : u8[] {
    let O_RDONLY = 0
    let fd = open (filename, O_RDONLY)

    if (fd < 0) {
        write(2, $"Error: failed to read file '{filename}': {strerror(fd)}\n");
        let a: u8[];
        return a;
    }

    let size = fsize(fd)
    let read_size = read(fd, buffer);
    ASSERT(read_size == size, __LOCATION__);

    close(fd);

    let r = buffer;
    r.len = size;

    return r;
}

fn handle_imports(mw: ModuleWalker&, module_filename: u8[], imports: Import[]) : void {
    for (let i = 0; i < imports.len; i++) {
        let imp => imports[i];

        let sb: StringBuilder;
        let buf: u8[1024];
        sb_init(sb, buf);

        let res = find_file(sb, imp.name, module_filename);
        
        if (res) {
            sb.str.len--; // make the terminating 0 for C invisible to FSM
            let module => find_existing_module(mw, sb.str);
            if (module) {
                if (module.state == ModuleState::NotCompiled) {
                    write (mw.log_fd, $"Module {sb.str} exists but needs to be recompiled. recompiling...\n")
                    EndlosArr_begin~Diagnostic(module.diagnostics, mw.endlos_compile);
                    compile_module(mw, module);
                }
                else if (module.state == ModuleState::Compiling) {
                    error_handler_location("[FSM Modulizer]", imp.location, $"Detected circular import '{imp.name}'", mw);
                }
                else if (module.state == ModuleState::Compiled) {
                    write (mw.log_fd, $"Module {sb.str} exists and is already compiled\n")
                }
                else if (module.state == ModuleState::CompilationFailed) {
                    write (mw.log_fd, $"Module {sb.str} exists and is already compiled (with errors)\n")
                }
                else NOT_IMPLEMENTED_EC(23, __LOCATION__, $"Dealing with module state {module.state.name}");
            }
            else {
                write (mw.log_fd, $"Module {sb.str} doesn't exist, creating\n")
                module => EndlosArr_push~Module(mw.modules);
                module.header.filename = endlos_copy~u8(sb.str, mw.endlos_main);
                module.code_buffer = endlos_begin~u8(mw.endlos_main);
                module.code = read_file_to_buffer(module.header.filename, module.code_buffer);

                EndlosArr_begin~Diagnostic(module.diagnostics, mw.endlos_compile);

                compile_module(mw, module);
            }
            imp.module => module;
        }
        else {
            error_handler_location("[FSM Modulizer]", imp.location, $"Couldn't find import '{imp.name}'", mw);
            imp.module => null;
        }
    }
}

fn recompile_all (mw: ModuleWalker&) {
    let modules => mw.modules.arr;

    for (let i = 0; i < modules.len; i++) {
        let module => modules[i];
        module.state = ModuleState::NotCompiled;
    }

    if (mw.endlos_compile.rolls.begin) {
        endlos_free(mw.endlos_compile);
    }

    endlos_root_init(mw.endlos_compile, 256, 1024 * 1024 * 64);

    TypeCache_init(mw.type_cache, mw.endlos_compile);
    mw.builtin_symbols = make_builtin_symbols(mw.type_cache, mw.endlos_compile);

    for (let i = 0; i < modules.len; i++) {
        let module => modules[i];
        EndlosArr_begin~Diagnostic(module.diagnostics, mw.endlos_compile);
    }
    
    for (let i = 0; i < modules.len; i++) {
        let module => modules[i];
        if (module.state == ModuleState::NotCompiled) {
            compile_module(mw, module);
        }
        else if (module.state == ModuleState::Compiled |== ModuleState::CompilationFailed) {
        }
        else {
            write (mw.log_fd, $"{__LOCATION__} Error: Module '{module.header.filename}' is in unexpected state\n")
        }
    }

    publish_diagnostics(mw);
}

fn handle_document_updated(mw: ModuleWalker&, uri: u8[], content: u8[], changed: bool) {
    let filename = uri_to_file_path(mw.project_root, uri);
    let module => find_existing_module(mw, filename);
    if (module) {
        if (!changed) { // (only opened, not edited)
            return;
        }
    }
    else {
        write (mw.log_fd, $"Module {uri} doesn't exist, creating\n")
        module => EndlosArr_push~Module(mw.modules);
        module.header.filename = endlos_copy~u8(filename, mw.endlos_main);
        module.code_buffer = endlos_begin~u8(mw.endlos_main);
        module.state = ModuleState::NotCompiled;
    }

    module.code = json_unescape_string(content, module.code_buffer);

    recompile_all(mw);
}

fn find_definition(mw: ModuleWalker&, range: LocationRange&, uri: u8[], line, col) : u8[] {
    let filename = uri_to_file_path(mw.project_root, uri);
    let module => find_existing_module(mw, filename);
    if (!module) { let r: u8[]; return r; }

    // convert to one based
    line++; col++;

    let sym => find_symbol_at(module.ast_root, line, col);

    if (sym) {
        write (mw.log_fd, $"Found symbol {sym.name}\n")
        range.start_line = sym.location.line - 1;
        range.end_line = sym.location.line;
        range.start_col = 0;
        range.end_col = 0;
        return sym.location.module.filename;
    }

    let n => find_member_access_at(module.ast_root, line, col);
    if (n) {
        let buf: u8[1024];
        write (mw.log_fd, $"Found member access {n.AST_member_access.name}\n")
        let container => n.AST_member_access.body;
        if (!container) { let r: u8[]; return r; }
        let type => container.type;
        if (!type) { let r: u8[]; return r; }
        write (mw.log_fd, $"Found member access {get_type_name_r(buf, type)}\n")
        let location => get_member_location_by_name(mw.type_cache, type, n.AST_member_access.name);
        if (!location) { let r: u8[]; return r; }
        range.start_line = location.line - 1;
        range.end_line = location.line;
        range.start_col = 0;
        range.end_col = 0;
        return location.module.filename;
    }

    let r: u8[]; return r;
}

fn find_all_references(mw: ModuleWalker&, id: u8[], uri: u8[], line, col) {
    let filename = uri_to_file_path(mw.project_root, uri);
    let module => find_existing_module(mw, filename);
    if (!module) return;

    let modules => mw.modules.arr;

    // convert to one based
    line++; col++;

    let reference_locations: EndlosArr<LSP_Location>;
    EndlosArr_begin~LSP_Location(reference_locations, mw.endlos_main);

    let sym => find_symbol_at(module.ast_root, line, col);
    if (sym) {
        for (let i = 0; i < modules.len; i++) {
            let other_module => modules[i];
            if (other_module.state == ModuleState::Compiled) {
                find_symbol_references_in_ast(other_module.ast_root, reference_locations, sym);
            }
        }
    }
    else {
        let n => find_member_access_at(module.ast_root, line, col);
        if (n && n.AST_member_access.body && n.AST_member_access.body.type) {
            let type => n.AST_member_access.body.type;
            let name = n.AST_member_access.name;
            for (let i = 0; i < modules.len; i++) {
                let other_module => modules[i];
                if (other_module.state == ModuleState::Compiled) {
                    find_member_references_in_ast(other_module.ast_root, reference_locations, type, name);
                }
            }
        } 
    }

    let buffer = endlos_begin~u8(mw.endlos_main);
    lsp_send_references_response(id, reference_locations.arr, buffer);
    endlos_ripp_off~u8(mw.endlos_main, buffer); // free

    EndlosArr_free~LSP_Location(reference_locations, mw.endlos_main);
}

fn main () {
    let log_fd = open_log_file();

    write (log_fd, "FSMD 3 started\n"); 

    let mw: ModuleWalker;
    write(log_fd, $"1\n");
    endlos_root_init(mw.endlos_main, 256, 1024 * 1024 * 64);
    write(log_fd, $"2\n");
    mw.error_handler_location.handler => error_handler_location;
    mw.error_handler_location.arg => mw;
    mw.error_handler_ast_node.handler => error_handler_ast_node;
    mw.error_handler_ast_node.arg => mw;
    mw.project_root = "/home/tixiv/work/fsm";
    mw.log_fd = log_fd;
    write(log_fd, $"3\n");
    EndlosArr_begin~Module(mw.modules, mw.endlos_main);

    write(log_fd, $"4\n");

    let buffer = endlos_begin~u8(mw.endlos_main);
    let sr: StreamReader; 
    sr_init(sr, buffer, 0)

    for(;;) {
        let content_length = read_header(sr);

        let request = sr_read_exact(sr, content_length);

        let id = json_get_number(request, "id");
        let method = json_get_string(request, "method");
        let params = json_get_element(request, "params");

        let print_request = true;

        if (sv_equal(method, "initialize")) {
            write (log_fd, "initialize\n")
            send_initialize_response(id);
            print_request = false;
        }
        else if (sv_equal(method, "shutdown")) {
            write (log_fd, "shutdown\n")
            write_wrapped(1, $"\{\"jsonrpc\":\"2.0\",\"id\":{id},\"result\":null}");
        }
        else if (sv_equal(method, "textDocument/definition")) {
            let textDocument = json_get_element(params, "textDocument");
            let uri = json_get_string(textDocument, "uri");
            let position = json_get_element(params, "position");
            let line = parse_integer(json_get_number(position, "line"));
            let col = parse_integer(json_get_number(position, "character"));

            let range: LocationRange;
            let filename = find_definition(mw, range, uri, line, col);
            
            send_definition_response(id, filename, range);
        }
        else if (sv_equal(method, "textDocument/references")) {
            let textDocument = json_get_element(params, "textDocument");
            let uri = json_get_string(textDocument, "uri");
            let position = json_get_element(params, "position");
            let line = parse_integer(json_get_number(position, "line"));
            let col = parse_integer(json_get_number(position, "character"));

            find_all_references(mw, id, uri, line, col);
        }
        else if (sv_equal(method, "textDocument/didChange")) {
            let textDocument = json_get_element(params, "textDocument");
            let uri = json_get_string(textDocument, "uri");
            let contentChanges = json_get_element(params, "contentChanges");
            let text = json_get_string(contentChanges, "text");
            
            write (log_fd, $"textDocument/didChange uri={uri} path={uri_to_file_path(mw.project_root, uri)}\n");

            handle_document_updated(mw, uri, text, true);

            print_request = false;
        }
        else if (sv_equal(method, "textDocument/didOpen")) {
            let textDocument = json_get_element(params, "textDocument");
            let uri = json_get_string(textDocument, "uri");
            let text = json_get_string(textDocument, "text");
            
            write (log_fd, $"textDocument/didOpen uri={uri} path={uri_to_file_path(mw.project_root, uri)}\n");

            handle_document_updated(mw, uri, text, false);
            
            print_request = false;
        }
        else if (sv_equal(method, "exit")) {
            exit(0);
        }

        if (print_request) {
            write(log_fd, "client: ");
            write(log_fd, request);
            write(log_fd, "\n");
        }

        sr_defrag(sr, buffer);
    }
}
