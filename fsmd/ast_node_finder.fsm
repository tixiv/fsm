
import * from "std";
import * from "compiler_fsm/common";
import * from "compiler_fsm/ast";
import * from "compiler_fsm/symbol";


struct SymbolFinder {
    line : i32;
    col : i32;
    best_symbol: Symbol&;
}

fn find_symbol_visitor (n: AST_node&, finder: SymbolFinder&) : void {
    if (!n) return;
    if (n.location.line == finder.line) {
        if (n.kind == AST_node::AST_symbol) {
            write (3, $"Line {n.location.line} found symbol {n.AST_symbol.name}\n");
            if (n.location.col - n.AST_symbol.name.len <= finder.col <= n.location.col) {
                finder.best_symbol => n.AST_symbol.symbol;
            }
        }
        else if (n.kind == AST_node::AST_typename) {
            if (n.location.col - n.AST_typename.name.len <= finder.col <= n.location.col) {
                finder.best_symbol => n.AST_typename.symbol;
            }
        }
    }

    if (n.kind != AST_node::AST_generic_implementation) {
        ast_visit_children(n, find_symbol_visitor, finder);
    }
}

fn find_symbol_at (root: AST_node&, line, col) : Symbol& {
    let finder: SymbolFinder;
    finder.line = line;
    finder.col = col;
    find_symbol_visitor(root, finder);
    return finder.best_symbol;
}

struct MemeberAccessFinder {
    line : i32;
    col : i32;
    member_access: AST_node&;
}

fn find_member_visitor (n: AST_node&, finder: MemeberAccessFinder&) : void {
    if (!n) return;
    if (n.location.line == finder.line) {
        if (n.kind == AST_node::AST_member_access) {
            if (n.location.col - n.AST_member_access.name.len <= finder.col <= n.location.col) {
                finder.member_access => n;
            }
        }
    }

    if (n.kind != AST_node::AST_generic_implementation) {
        ast_visit_children(n, find_member_visitor, finder);
    }
}

fn find_member_access_at (root: AST_node&, line, col) : AST_node& {
    let finder: MemeberAccessFinder;
    finder.line = line;
    finder.col = col;
    find_member_visitor(root, finder);
    return finder.member_access;
}
