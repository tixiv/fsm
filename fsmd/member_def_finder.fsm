
import * from "std";
import * from "compiler_fsm/type";
import * from "compiler_fsm/symbol";

struct MemberDefResult {
    type: Type&;
    name: u8[]&;
}

fn find_member_def_in_stuctlike(type: Type&, line, col) : MemberDefResult {
    let buf: u8[1024];
    let result: MemberDefResult;
    let members = type.T_struct.members;
    while (members.len) {
        let member => members++;
        let location => member.location;
        if (location && location.line == line) {
            if (location.col - member.name.len <= col <= location.col) {
                result.type => type;
                result.name => member.name;
                return result;
            }
        }
    }
    return result;

}

fn find_member_def_at(symbols: Symbol&[], line, col) : MemberDefResult {
    let result: MemberDefResult;
    for (let i = 0; i < symbols.len; i++) {
        let symbol => symbols[i];
        if (symbol.kind == SymbolKind::SYM_type) {
            if (is_structlike_kind(symbol.type)) {
                result = find_member_def_in_stuctlike(symbol.type, line, col);
                if (result.type && result.name)
                    return result;
            }
            else if (is_union_kind(symbol.type)) {
                let members = symbol.type.T_union.members;
                while (members.len) {
                    let member => members++;
                    let location => member.location;
                    if (location && location.line == line) {
                        if (location.col - member.name.len <= col <= location.col) {
                            result.type => symbol.type;
                            result.name => member.name;
                            return result;
                        }
                    }
                    else if (is_structlike_kind(member.type)) {
                        result = find_member_def_in_stuctlike(member.type, line, col);
                        if (result.type && result.name)
                            return result;
                    }
                }
            }
        }
    }

    return result;
}